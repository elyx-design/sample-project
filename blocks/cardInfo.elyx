import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/header.elyx" as header
import "images/background/nightMountain.jpg" as nightMountain
import "components/userSummary.elyx" as userSummary
import "components/tag.elyx" as tag
import "components/button.elyx" as button

export reviewCard = cardBackground.base {
  name: "Review Card",
  left: 693px,
  top: 267px,
  width: 370px,
  height: 470px,
  fill[0].image.ref: nightMountain,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: [insert(reviewAuthor, after = .nil), insert(reviewFooter, after = reviewAuthor)]
}

reviewFooter = frame {
  name: "Review Footer",
  width: 100%,
  layout: {direction: .column, item-gap: 32px},
  children: [reviewInfo, readReviewButton]
}

reviewInfo = frame {
  name: "Info",
  width: 100%,
  layout: {direction: .column, item-gap: 16px},
  children: [reviewHeader, tags]
}

reviewHeader = header.mediumLeft {
  name: "Review Header",
  left: 768px,
  top: 512px,

  header.mediumSubtitle {
    contents: "Stunning mountain scenery and a story full of heart. This one leaves you calm, inspired, and ready for your next adventure.",
    fill[0].color: colors.colors.whiteAlpha70
  }

  header.mediumTitle {
    contents: "A Breathtaking Escape",
    fill[0].color: colors.colors.white100
  }
}

tags = frame {
  name: "Tags",
  width: 100%,
  layout: {item-gap: 8px},
  children: [ratingTag, thrillerTag, dramaTag]
}

ratingTag = tag.iconAndLabel {
  name: "Rating Tag",
  left: 765px,
  top: 726px,

  tag.label {
    contents: "4,2",
    fill[0].color: colors.colors.white100
  }

  tag.icon {
    fill[0].color: colors.colors.white100
  }
}

thrillerTag = tag.base {
  name: "Thriller Tag",
  left: 785px,
  top: 746px,

  tag.label {
    contents: "Thriller",
    fill[0].color: colors.colors.white100
  }
}

dramaTag = tag.base {
  name: "Drama Tag",
  left: 785px,
  top: 827.25px,

  tag.label {
    contents: "Drama",
    fill[0].color: colors.colors.white100
  }
}

readReviewButton = button.medium {
  name: "Read Full Review Button",
  left: 0px,
  top: 165px,

  button.mediumLabel {
    contents: "Read full review"
  }
}

reviewAuthor = frame {
  name: "Review Author",
  width: 100%,
  layout: {justify-content: .space-between, item-gap: 20px},
  overflow: .visible,
  children: [authorSummary, closeButton]
}

authorSummary = userSummary.UserSummaryS_clM0CpDw4i {
  name: "User Summary S",
  left: 786px,
  top: 143px,
  overflow: .visible,

  userSummary.HeaderSLeft_v1iI8KgpFk.header.smallSubtitle {
    contents: "Writer",
    fill[0].color: colors.colors.whiteAlpha70
  }

  userSummary.HeaderSLeft_v1iI8KgpFk.header.smallTitle {
    fill[0].color: colors.colors.white100
  }

  userSummary.AvatarSPhoto_aTBp6lpaL0.userAvatar.smallStatus {
    display: .hidden
  }
}

closeButton = button.smallClose {name: "Close Button", left: 1097px, top: 291px}
