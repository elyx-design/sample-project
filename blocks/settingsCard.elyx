import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "components/checkbox.elyx" as Checkbox
import "components/segmentedControl.elyx" as SegmentedControl
import "components/textField.elyx" as TextField
import "components/header.elyx" as header2
import "components/cardBackground.elyx" as cardBackground

export settingsCard_myBFBNhjqy = cardBackground.base {
  name: "Settings Card",
  left: 111px,
  top: 192px,
  width: 100%,
  height: .auto,
  overrides: [
    insert(header, after = .nil),
    insert(nameField, after = header),
    insert(notificationRow, after = nameField),
    insert(densityRow, after = notificationRow)
  ]
}

densityRow = frame {
  name: "Density",
  left: 0px,
  top: 225px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 8},
  children: [densityLabel, densityControl]
}

densityLabel = text {
  name: "Density Label",
  fill: Colors.colors.black20,
  contents: "Interface density",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Medium"
}

densityControl = SegmentedControl.medium {
  SegmentedControl.trailingSegment.label {
    contents: "High"
  }

  SegmentedControl.middleSegment.label {
    contents: "Default"
  }

  SegmentedControl.leadingSegment.label {
    contents: "Low"
  }
}

notificationRow = frame {
  name: "Notifications",
  left: 0px,
  top: 174px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  children: [notificationCopy, notificationToggle]
}

notificationCopy = frame {
  name: "Notification Copy",
  layout: {direction: .column, item-gap: 4},
  children: [notificationTitle, notificationText]
}

notificationTitle = text {
  name: "Notification Title",
  fill: Colors.colors.black20,
  contents: "Email notifications",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Medium"
}

notificationText = text {
  name: "Notification Text",
  fill: Colors.colors.blackAlpha70,
  contents: "Receive updates about comments and mentions.",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

notificationToggle = Checkbox.on {}

nameField = TextField.base {
  left: 0px,
  top: 115px,

  TextField.label {
    contents: "Jason Chen"
  }
}

header = header2.mediumLeft {
  left: 0px,
  top: 80px,

  header2.mediumSubtitle {
    contents: "Manage your profile and preferences."
  }

  header2.mediumTitle {
    contents: "Account"
  }
}
