  font-size: tokens.labelSizeML,
  font-family: "Inter",
  font-style: "Medium"
}

densityControl = SegmentedControl.Frame_U {
  SegmentedControl.Selected_D.Item_P {
    contents: "High"
  }

  SegmentedControl.Selected.Item_P {
    contents: "Default"
  }

  SegmentedControl.layer.Item_P {
    contents: "Low"
  }
}

notificationRow = frame {
  name: "Notifications",
  left: 0px,
  top: 174px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  children: [notificationCopy, notificationToggle]
}

notificationCopy = frame {
  name: "Notification Copy",
