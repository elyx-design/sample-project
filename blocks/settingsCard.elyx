  font-size: tokens.labelSizeML,
  font-family: "Inter",
  font-style: "Medium"
}

notificationText = text {
  name: "Notification Text",
  fill: tokens.textColorDarkSecondary,
  contents: "Receive updates about comments and mentions.",
  font-size: tokens.labelSizeM,
  font-family: "Inter",
  font-style: "Regular"
}

notificationToggle = Checkbox.Frame_P {}

nameField = TextField.TextField {
  left: 0px,
  top: 115px,

  TextField.Label {
    contents: "Jason Chen"
  }
}

