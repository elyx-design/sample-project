import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/product.elyx" as product
import "blocks/productInfo.elyx" as productInfo

export productGallery = frame : cardBackground.cardBackground {
  left: 177px,
  top: 240px,
  width: 888px,
  overflow: .visible,
  layout.item-gap: Spacing.gap.xlarge,
  overrides: [insert(title, after = .nil), insert(productList, after = title)],

  title = text {
    left: 380px,
    top: 176.5px,
    fill: colors.theme.contrastStrongest,
    contents: Strings.labels.readingNext,
    font-size: Typography.fontSize.xxlarge,
    font-style: "SemiBold"
  }
}

productList = frame {
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  slot: .true,
  restrict-children: .true,
  children: [designBook, candyBook, seaLifeBook, wildlifeBook],

  designBook = frame : productInfo.productInfo {
    left: -167px,
    top: 300px,
    width: .auto,

    productInfo.productDetails {
      productInfo.productCopy {
        productInfo.productCopy.subtitle {
          contents: "by Alicia Puma"
        }

        productInfo.productCopy.productName {
          width: 155px,
          contents: "Design"
        }
      }

      productInfo.productDetails.ratingTag {
        overflow: .visible
      }
    }

    @use-variant(product.productFive)
    productInfo.productInfo.productPreview {}
  }

  candyBook = frame : productInfo.productInfo {
    left: -147px,
    top: 320px,
    width: .auto,

    productInfo.productDetails {
      productInfo.productDetails.ratingTag {
        productInfo.tag.tagTransparent.label {
          contents: "4.2"
        }
      }

      productInfo.productCopy {
        productInfo.productCopy.subtitle {
          contents: "by Alice Sherman"
        }

        productInfo.productCopy.productName {
          width: 155px,
          contents: "The Delicious Book of Candy"
        }
      }
    }

    @use-variant(product.productFour)
    productInfo.productInfo.productPreview {}
  }

  seaLifeBook = frame : productInfo.productInfo {
    left: 77px,
    top: 320px,
    width: .auto,

    productInfo.productDetails {
      productInfo.productDetails.ratingTag {
        productInfo.tag.tagTransparent.label {
          contents: "3.9"
        }
      }

      productInfo.productCopy {
        productInfo.productCopy.subtitle {
          contents: "by Eric Mateo"
        }

        productInfo.productCopy.productName {
          width: 155px,
          contents: "Sea Life"
        }
      }
    }

    @use-variant(product.productThree)
    productInfo.productInfo.productPreview {}
  }

  wildlifeBook = frame : productInfo.productInfo {
    left: 301px,
    top: 320px,
    width: .auto,

    productInfo.productDetails {
      productInfo.productDetails.ratingTag {
        productInfo.tag.tagTransparent.label {
          contents: "4.8"
        }
      }

      productInfo.productCopy {
        productInfo.productCopy.subtitle {
          contents: "by Elena Marsh"
        }

        productInfo.productCopy.productName {
          width: 155px,
          contents: "Widlife"
        }
      }
    }

    @use-variant(product.productTwo)
    productInfo.productInfo.productPreview {}
  }
}
