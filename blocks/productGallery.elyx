import "tokens/spacing.elyx" as Spacing
import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/product.elyx" as product
import "blocks/productInfo.elyx" as productInfo

export productGallery = cardBackground.base {
  left: 177px,
  top: 240px,
  width: 888px,
  overflow: .visible,
  layout.item-gap: Spacing.gap.xlarge,
  overrides: [insert(title, after = .nil), insert(productList, after = title)]
}

productList = frame {
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  slot: .true,
  restrict-children: .true,
  children: [designBook, candyBook, seaLifeBook, wildlifeBook]
}

designBook = productInfo.productInfo {
  left: -167px,
  top: 300px,
  width: .auto,

  productInfo.productDetails.productCopy.subtitle {
    contents: "by Alicia Puma"
  }

  productInfo.productDetails.productCopy.productName {
    contents: "Design",
    width: 155px
  }

  productInfo.productDetails.ratingTag {
    overflow: .visible
  }

  @use-variant(product.productFive)
  productInfo.productPreview {}
}

candyBook = productInfo.productInfo {
  left: -147px,
  top: 320px,
  width: .auto,

  productInfo.productDetails.ratingTag.tag.label {
    contents: "4.2"
  }

  productInfo.productDetails.productCopy.subtitle {
    contents: "by Alice Sherman"
  }

  productInfo.productDetails.productCopy.productName {
    contents: "The Delicious Book of Candy",
    width: 155px
  }

  @use-variant(product.productFour)
  productInfo.productPreview {}
}

seaLifeBook = productInfo.productInfo {
  left: 77px,
  top: 320px,
  width: .auto,

  productInfo.productDetails.ratingTag.tag.label {
    contents: "3.9"
  }

  productInfo.productDetails.productCopy.subtitle {
    contents: "by Eric Mateo"
  }

  productInfo.productDetails.productCopy.productName {
    contents: "Sea Life",
    width: 155px
  }

  @use-variant(product.productThree)
  productInfo.productPreview {}
}

wildlifeBook = productInfo.productInfo {
  left: 301px,
  top: 320px,
  width: .auto,

  productInfo.productDetails.ratingTag.tag.label {
    contents: "4.8"
  }

  productInfo.productDetails.productCopy.subtitle {
    contents: "by Elena Marsh"
  }

  productInfo.productDetails.productCopy.productName {
    contents: "Widlife",
    width: 155px
  }

  @use-variant(product.productTwo)
  productInfo.productPreview {}
}

title = text {
  left: 380px,
  top: 176.5px,
  fill: colors.colors.black20,
  contents: "Reading Next",
  font-size: 20,
  font-family: "Inter",
  font-style: "SemiBold"
}
