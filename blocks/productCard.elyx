import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/slider.elyx" as slider
import "components/product.elyx" as product

export productCard = cardBackground.base {
  name: "Product Card",
  left: 140px,
  top: 134px,
  width: 565px,
  layout.direction: .row,
  layout.item-gap: 20px,
  overrides: [insert(productPreview, after = .nil), insert(bookDetails, after = productPreview)]
}

bookDetails = frame {
  name: "Book Details",
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 16px},
  children: [pageProgress, bookInfo, readingProgress, notes]
}

pageProgress = text {
  name: "Page Progress",
  left: 0px,
  top: 62px,
  fill: colors.colors.blackAlpha25,
  contents: "Page 214 of 344",
  font-size: 12,
  font-style: "SemiBold"
}

bookInfo = frame {
  name: "Author",
  width: 100%,
  layout: {direction: .column, item-gap: 4px},
  children: [title, author]
}

title = text {
  name: "Book Title",
  left: 864px,
  top: 413px,
  fill: .black,
  contents: "Hidden Treasures",
  font-size: 28,
  font-style: "SemiBold"
}

author = text {
  name: "Book Author",
  left: 844px,
  top: 393px,
  fill: colors.colors.blackAlpha50,
  contents: "by Eric Mateo",
  font-size: 14,
  font-style: "SemiBold"
}

readingProgress = frame {
  name: "Reading Progress",
  left: 0px,
  top: 98px,
  width: 100%,
  height: 33px,
  layout: {direction: .column, justify-content: .center, item-gap: 4px},
  children: [progressLabels, progressSlider]
}

progressLabels = frame {
  name: "Progress Labels",
  width: 100%,
  layout: {item-gap: 12px},
  children: [progressLabel, progressValue]
}

progressLabel = text {
  name: "Progress Label",
  left: 0px,
  top: 16px,
  width: 100%,
  height: 17px,
  fill: colors.colors.blackAlpha50,
  contents: "Progress",
  font-size: 12,
  font-style: "SemiBold"
}

progressValue = text {
  name: "Progress Value",
  left: 20px,
  top: 36px,
  width: .auto,
  height: 17px,
  fill: colors.colors.blackAlpha50,
  contents: "42%",
  font-size: 12,
  font-style: "SemiBold",
  align: .right
}

progressSlider = slider.base {name: "Slider", left: 0px, top: 0px, width: 100%}

notes = frame {
  name: "Notes",
  width: 100%,
  layout: {direction: .column, item-gap: 8px},
  children: [notesLabel, notesBody]
}

notesLabel = text {
  name: "Notes Label",
  left: 652px,
  top: 688px,
  fill: .black,
  contents: "Notes",
  font-size: 12,
  font-style: "SemiBold"
}

notesBody = text {
  name: "Notes Body",
  left: 0px,
  top: 708px,
  width: 100%,
  fill: .black,
  contents: "The passages about the coastline stayed with me long after I closed it, the kind of writing that makes you look up from the page and picture the place in full. A book to read slowly, letting each cove and cliff sink in before moving to the next, never rushing toward the final chapter.",
  font-size: 12,
  font-style: "Regular",
  line-height: 1.5
}

productPreview = product.product {name: "Product", left: -63px, top: -86px}
