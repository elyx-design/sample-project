import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button
import "icons/24 pixels/direct-24.svg" as direct24
import "icons/12 pixels/dot-12.svg" as dot12
import "components/tag.elyx" as tag
import "images/background/dots.jpg" as dots

export planCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 425px,
  layout: {direction: .column, justify-content: .space-between, item-gap: 48px},
  fill: {image: {ref: dots}},
  corner-radius: Radius.radius.large,
  padding: 24px,
  children: [planContent, manageButton]
}

planContent = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 48px},
  overflow: .visible,
  children: [planSummary, planDetails]
}

planSummary = frame {
  width: 100%,
  layout: {align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [planIcon, planHeader]
}

planIcon = frame {
  left: 0px,
  top: 0px,
  width: 40px,
  height: 40px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  fill: Colors.colors.black20,
  corner-radius: Radius.radius.xsmall,
  children: planGlyph
}

planGlyph = icon {
  left: 2px,
  top: 29px,
  width: 32px,
  height: 32px,
  fill: Colors.colors.white100,
  contents: direct24
}

planHeader = frame {
  width: .auto,
  layout: {align-items: .center, item-gap: 16px},
  overflow: .visible,
  children: [planName, badge]
}

planName = text {
  fill: Colors.colors.black20,
  contents: "Starter",
  font-size: 20,
  font-family: "Inter",
  font-style: "Bold"
}

badge = tag.iconAndLabel {
  left: 67px,
  top: 37px,
  border[0].visible: .false,
  fill[0].color: Colors.colors.lavender,

  tag.label {
    contents: "Best!"
  }
}

planDetails = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 24px},
  children: [pricingCopy, features]
}

pricingCopy = frame {
  left: 24px,
  top: 112px,
  width: 100%,
  layout: {direction: .column, item-gap: 8px},
  children: [priceRow, description]
}

priceRow = frame {
  width: 100%,
  layout: {align-items: .end, item-gap: 4px},
  children: [price, billingPeriod]
}

price = text {
  fill: Colors.colors.black20,
  contents: "$12",
  font-size: 40,
  font-family: "Inter",
  font-style: "Light"
}

billingPeriod = text {
  left: 40px,
  top: 132px,
  height: 22px,
  fill: Colors.colors.blackAlpha50,
  contents: "/Month",
  font-size: 14,
  font-family: "Inter",
  font-style: "SemiBold"
}

description = text {
  left: 20px,
  top: 262px,
  fill: Colors.colors.black40,
  contents: "Free forever.\nFor individuals getting started.",
  font-style: "Regular",
  line-height: 1.5
}

features = frame {
  left: 0px,
  top: 250px,
  width: 100%,
  layout: {direction: .column, item-gap: 8px},
  children: [projectsFeature, supportFeature, exportFeature, storageFeature]
}

projectsFeature = frame {
  layout: {align-items: .center, item-gap: 8px},
  children: [projectsBullet, projectsLabel]
}

projectsBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

projectsLabel = text {
  fill: Colors.colors.black40,
  contents: "Up to 3 projects",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

supportFeature = frame {
  left: 20px,
  top: 70px,
  layout: {align-items: .center, item-gap: 8px},
  children: [supportBullet, supportLabel]
}

supportBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

supportLabel = text {
  fill: Colors.colors.black40,
  contents: "Community support",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

exportFeature = frame {
  left: 20px,
  top: 95px,
  layout: {align-items: .center, item-gap: 8px},
  children: [exportBullet, exportLabel]
}

exportBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

exportLabel = text {
  fill: Colors.colors.black40,
  contents: "Basic export options",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

storageFeature = frame {
  left: 40px,
  top: 115px,
  layout: {align-items: .center, item-gap: 8px},
  children: [storageBullet, storageLabel]
}

storageBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

storageLabel = text {
  fill: Colors.colors.black40,
  contents: "2 GB storage",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

manageButton = button.medium {
  left: 24px,
  top: 390px,

  button.mediumLabel {
    contents: "Manage Plan"
  }
}
