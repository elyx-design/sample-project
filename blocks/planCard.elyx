import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button
import "icons/24 pixels/direct-24.svg" as direct24
import "icons/12 pixels/dot-12.svg" as dot12
import "components/tag.elyx" as tag
import "images/background/dots.jpg" as dots

export planCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 425px,
  layout: {direction: .column, justify-content: .space-between, item-gap: 48px},
  fill: {image: {ref: dots}},
  corner-radius: Radius.radius.large,
  padding: Spacing.padding.xxlarge,
  children: [planContent, manageButton]
}

planContent = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 48px},
  overflow: .visible,
  children: [planSummary, planDetails]
}

planSummary = frame {
  width: 100%,
  layout: {align-items: .center, item-gap: Spacing.gap.medium},
  overflow: .visible,
  children: [planIcon, planHeader]
}

planIcon = frame {
  left: 0px,
  top: 0px,
  width: 40px,
  height: 40px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  fill: Colors.colors.black20,
  corner-radius: Radius.radius.xsmall,
  children: planGlyph
}

planGlyph = icon {
  left: 2px,
  top: 29px,
  width: 32px,
  height: 32px,
  fill: Colors.colors.white100,
  contents: direct24
}

planHeader = frame {
  width: .auto,
  layout: {align-items: .center, item-gap: Spacing.gap.large},
  overflow: .visible,
  children: [planName, badge]
}

planName = text {
  fill: Colors.colors.black20,
  contents: Strings.plans.starter,
  font-size: Spacing.fontSize.xxlarge,
  font-style: "Bold"
}

badge = tag.iconAndLabel {
  left: 67px,
  top: 37px,
  border[0].visible: .false,
  fill[0].color: Colors.colors.lavender,

  tag.label {
    contents: Strings.plans.best
  }
}

planDetails = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.xxlarge},
  children: [pricingCopy, features]
}

pricingCopy = frame {
  left: 24px,
  top: 112px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  children: [priceRow, description]
}

priceRow = frame {
  width: 100%,
  layout: {align-items: .end, item-gap: Spacing.gap.xsmall},
  children: [price, billingPeriod]
}

price = text {fill: Colors.colors.black20, contents: "$12", font-size: 40, font-style: "Light"}

billingPeriod = text {
  left: 40px,
  top: 132px,
  height: 22px,
  fill: Colors.colors.blackAlpha50,
  contents: Strings.plans.perMonth,
  font-size: Spacing.fontSize.medium,
  font-style: "SemiBold"
}

description = text {
  left: 20px,
  top: 262px,
  fill: Colors.colors.black40,
  contents: Strings.plans.starterDescription,
  line-height: Spacing.lineHeight.relaxed
}

features = frame {
  left: 0px,
  top: 250px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  children: [projectsFeature, supportFeature, exportFeature, storageFeature]
}

projectsFeature = frame {
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [projectsBullet, projectsLabel]
}

projectsBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

projectsLabel = text {
  fill: Colors.colors.black40,
  contents: Strings.plans.threeProjects,
  font-size: Spacing.fontSize.medium
}

supportFeature = frame {
  left: 20px,
  top: 70px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [supportBullet, supportLabel]
}

supportBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

supportLabel = text {
  fill: Colors.colors.black40,
  contents: Strings.plans.communitySupport,
  font-size: Spacing.fontSize.medium
}

exportFeature = frame {
  left: 20px,
  top: 95px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [exportBullet, exportLabel]
}

exportBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

exportLabel = text {
  fill: Colors.colors.black40,
  contents: Strings.plans.basicExport,
  font-size: Spacing.fontSize.medium
}

storageFeature = frame {
  left: 40px,
  top: 115px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [storageBullet, storageLabel]
}

storageBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: dot12}

storageLabel = text {
  fill: Colors.colors.black40,
  contents: Strings.plans.twoGigabytesStorage,
  font-size: Spacing.fontSize.medium
}

manageButton = button.medium {
  left: 24px,
  top: 390px,

  button.mediumLabel {
    contents: Strings.actions.managePlan
  }
}
