import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button
import "icons/24 pixels/direct-24.svg" as direct24
import "components/tag.elyx" as tag
import "images/background/dots.jpg" as dots
import "components/listItem.elyx" as listItem

export planCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 425px,
  layout: {direction: .column, justify-content: .space-between, item-gap: 48px},
  fill: [{visible: .false, image: {ref: dots}}, Colors.theme.base],
  corner-radius: Radius.radius.large,
  padding: Spacing.padding.xxlarge,
  children: [planContent, manageButton],

  manageButton = frame : button.medium {
    left: 24px,
    top: 390px,

    button.medium.mediumLabel {
      contents: Strings.actions.managePlan
    }
  }
}

planContent = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 48px},
  overflow: .visible,
  children: [planSummary, planDetails],

  planSummary = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: Spacing.gap.medium},
    overflow: .visible,
    children: [planIcon, planHeader]
  }

  planDetails = frame {
    width: 100%,
    layout: {direction: .column, item-gap: Spacing.gap.xxlarge},
    children: [pricingCopy, features]
  }
}

planIcon = frame {
  left: 0px,
  top: 0px,
  width: 40px,
  height: 40px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  fill: Colors.theme.contrastStrongest,
  corner-radius: Radius.radius.xsmall,
  children: planGlyph,

  planGlyph = icon {
    left: 2px,
    top: 29px,
    width: 32px,
    height: 32px,
    fill: Colors.theme.base,
    contents: direct24
  }
}

planHeader = frame {
  width: .auto,
  layout: {align-items: .center, item-gap: Spacing.gap.large},
  overflow: .visible,
  children: [planName, badge],

  planName = text {
    fill: Colors.theme.contrastStrongest,
    contents: Strings.plans.starter,
    font-size: Typography.fontSize.xxlarge,
    font-style: "Bold"
  }

  badge = frame : tag.iconAndLabel {
    left: 67px,
    top: 37px,
    border[0].visible: .false,
    fill[0].color: Colors.palette.lavender,

    tag.tagTransparent.label {
      fill[0].color: Colors.primitives.black,
      contents: Strings.plans.best
    }

    tag.iconAndLabel.tagIcon {
      fill[0].color: Colors.primitives.black
    }
  }
}

pricingCopy = frame {
  left: 24px,
  top: 112px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  children: [priceRow, description],

  description = text {
    left: 20px,
    top: 262px,
    fill: Colors.theme.contrastDefault,
    contents: Strings.plans.starterDescription,
    line-height: Typography.lineHeight.relaxed
  }
}

priceRow = frame {
  width: 100%,
  layout: {align-items: .end, item-gap: Spacing.gap.xsmall},
  children: [price, billingPeriod],

  price = text {
    fill: Colors.theme.contrastStrongest,
    contents: "$12",
    font-size: 40,
    font-style: "Light"
  }

  billingPeriod = text {
    left: 40px,
    top: 132px,
    height: 22px,
    fill: Colors.theme.contrastAlpha50,
    contents: Strings.plans.perMonth,
    font-size: Typography.fontSize.medium,
    font-style: "SemiBold"
  }
}

features = frame {
  left: 0px,
  top: 250px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  slot: .true,
  restrict-children: .true,
  children: [projectsFeature, projectsFeature_2, projectsFeature_3, projectsFeature_4],

  projectsFeature = frame : listItem.projectsFeature {
    listItem.projectsFeature.projectsLabel {
      contents: Strings.plans.threeProjects
    }
  }

  projectsFeature_2 = frame : listItem.projectsFeature {
    left: 20px,
    top: 45px,

    listItem.projectsFeature.projectsLabel {
      contents: Strings.plans.communitySupport
    }
  }

  projectsFeature_3 = frame : listItem.projectsFeature {
    left: 20px,
    top: 70px,

    listItem.projectsFeature.projectsLabel {
      contents: Strings.plans.basicExport
    }
  }

  projectsFeature_4 = frame : listItem.projectsFeature {
    left: 20px,
    top: 95px,

    listItem.projectsFeature.projectsLabel {
      contents: Strings.plans.twoGigabytesStorage
    }
  }
}
