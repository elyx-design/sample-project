import "components/chatBubble.elyx" as chatBubble
import "tokens/colors.elyx" as colors
import "components/textField.elyx" as textField

export chatWindow = frame {
  name: "Chat Window",
  left: 659px,
  top: 241px,
  width: 327px,
  height: 316px,
  layout: {direction: .column, justify-content: .center, align-items: .center, item-gap: 38px},
  fill: colors.colors.whiteAlpha50,
  filter: {type: .background-blur, radius: 40px},
  padding: [24px, 12px, 12px],
  children: [messageThread, messageField]
}

messageThread = frame {
  name: "Message Thread",
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .stretch, item-gap: 24px},
  overflow: .visible,
  children: [userMessage, replyMessages]
}

userMessage = chatBubble.user {
  name: "User Message",
  left: 1px,
  top: 0px,
  layout.justify-content: .end,

  chatBubble.message.messageText {
    contents: "This heat is brutal"
  }
}

replyMessages = frame {
  name: "Reply Messages",
  width: 100%,
  layout: {direction: .column, align-items: .stretch, item-gap: 8px},
  overflow: .visible,
  children: [firstReply, secondReply]
}

firstReply = chatBubble.base {
  name: "First Reply",
  left: 0px,
  top: 74px,
  layout.justify-content: .start,

  chatBubble.message.messageText {
    contents: "Yeah, it true!",
    fill[0].color: colors.colors.white100
  }
}

secondReply = chatBubble.base {
  name: "Second Reply",
  left: 20px,
  top: 94px,
  layout.justify-content: .start,

  chatBubble.message.messageText {
    contents: "Incredible pace out there",
    fill[0].color: colors.colors.white100
  }
}

messageField = textField.buttonPlaceholder {
  name: "Message Field",
  left: 827px,
  top: 524px,

  textField.label {
    contents: "Write a message"
  }
}
