export siteHeader = frame : cardBackground.solidFullRadius {
  left: 512px,
  top: 456px,
  width: 1024px,
  height: spacing.size.large,
  min-width: .nil,
  min-height: .nil,
  padding-top: 0px,
  padding-left: spacing.padding.large,
  padding-bottom: 0px,
  padding-right: spacing.padding.large,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: spacing.gap.xlarge,
  layout.justify-content: .space-between,
  overrides: [
    insert(small_4, after = .nil),
    insert(navLinks, after = small_4),
    insert(headerCta, after = navLinks)
  ]
}

export menu = frame {
  left: 191px,
  top: 456px,
  width: .auto,
  layout: {justify-content: .center, align-items: .center},
  children: label
}

label = text {
  left: 0px,
  top: 0px,
  fill: colors.colors.black20,
  contents: Strings.navigation.menu,
  font-style: "SemiBold"
}

@variant
mutedMenu = frame : menu {
  left: 191px,
  top: 521px,

  label {
    fill[0].color: colors.colors.blackAlpha50
  }
}

@variant
loggedInHeader = frame : siteHeader {
  left: 512px,
  top: 572px,
  overrides: [insert(GroupedStack, after = navLinks), remove(headerCta)]
}

@variant
iconMenu = frame : menu {
  left: 275px,
  top: 456px,
  layout.item-gap: spacing.gap.xxsmall,
  overrides: [insert(chevron, after = label)]
}

@variant
mutedIconMenu = frame : menu {
