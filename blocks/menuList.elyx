import "design/fonts/InterVariable.ttf"
import "design/fonts/InterVariable-Italic.ttf"
import "scaffold/components/listRow.elyx" as ListRow

pub menuList = frame {
  name: "Menu List",
  left: 80px,
  top: 80px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 2},
  corner-radius: 12px,
  padding: 6px,
  fill: .white,
  border: {color: oklch(0%, 0, 0deg, 8%), position: .outside},
  shadow: {
    drop-shadow: {
      color: oklch(0%, 0, 0deg, 5%),
      offset: point(0px, 10px),
      blur-radius: 20px,
      spread: 0px,
      style: .smooth
    }
  },
  children: [layer, Row, Row_Q, divider, Row_a]
}

layer = ListRow.RowVariant_7 {left: 0px, top: 59px}

Row = ListRow.Row {left: 20px, top: 79px}

Row_Q = ListRow.Row {left: 40px, top: 99px}

divider = shape {name: "Divider", width: 100%, height: 1px, type: .rect, fill: oklch(0%, 0, 0deg, 8%)}

Row_a = ListRow.Row {left: 40px, top: 131px}
