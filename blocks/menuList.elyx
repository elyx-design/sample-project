import "components/listRow.elyx" as ListRow
import "tokens/colors.elyx" as colors
import "icons/20 pixels/activity-20.svg" as activity20
import "components/cardBackground.elyx" as cardBackground
import "components/userSummary.elyx" as userSummary
import "components/divider.elyx" as divider
import "components/segmentedControl.elyx" as segmentedControl
import "components/button.elyx" as button
import "icons/24 pixels/direct-24.svg" as direct24
import "icons/24 pixels/ellipsis-horizontal-24.svg" as ellipsishorizontal24
import "icons/20 pixels/database-20.svg" as database20
import "icons/20 pixels/settings-20.svg" as settings20
import "icons/20 pixels/notes-20.svg" as notes20
import "icons/20 pixels/chat-20.svg" as chat20

export menuList = cardBackground.base {
  left: 33.25px,
  top: -48px,
  width: 287.5px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  fill[0].color: colors.colors.whiteAlpha50,
  filter[0].radius: 40px,
  filter[0].type: .background-blur,
  layout.item-gap: 0,
  overrides: [insert(menuHeader, after = .nil), insert(footerActions, after = menuHeader)]
}

menuHeader = frame {
  left: 0px,
  top: 108.5px,
  width: 100%,
  layout: {direction: .column, item-gap: 16px},
  fill: colors.colors.white100,
  corner-radius: 16px,
  padding: 16px,
  children: [user, themeControl, menuSections]
}

user = userSummary.small {left: 0px, top: 0px}

themeControl = segmentedControl.small {
  left: 0px,
  top: -17px,
  width: 100%,

  segmentedControl.trailingSegment.label {
    contents: "System"
  }

  segmentedControl.middleSegment.label {
    contents: "Dark"
  }

  segmentedControl.smallLeadingSegment.label {
    contents: "Light"
  }
}

menuSections = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 8px},
  children: [collaborationMenu, menuDivider, workspaceMenu]
}

collaborationMenu = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 4px},
  children: [commentsRow, activityRow, notesRow]
}

commentsRow = ListRow.base {
  left: 0px,
  top: 0px,

  ListRow.content.label {
    contents: "Comments"
  }

  ListRow.content.rowIcon {
    contents: chat20
  }
}

activityRow = ListRow.selected {
  left: 20px,
  top: 20px,

  ListRow.content.label {
    contents: "Activity"
  }
}

notesRow = ListRow.base {
  left: 20px,
  top: 56px,

  ListRow.content.label {
    contents: "Notes"
  }

  ListRow.content.rowIcon {
    contents: notes20
  }
}

menuDivider = divider.horizontal {left: 0px, top: 0px, width: 100%}

workspaceMenu = frame {
  left: 36px,
  top: 243px,
  width: 100%,
  layout: {direction: .column, item-gap: 4px},
  children: [databaseRow, settingsRow]
}

databaseRow = ListRow.base {
  left: 0px,
  top: 0px,

  ListRow.content.label {
    contents: "Database"
  }

  ListRow.content.rowIcon {
    contents: notes20
  }
}

settingsRow = ListRow.base {
  left: 20px,
  top: 56px,

  ListRow.content.label {
    contents: "Settings"
  }

  ListRow.content.rowIcon {
    contents: settings20
  }
}

footerActions = frame {
  width: 100%,
  layout: {justify-content: .space-between},
  padding: 16px,
  children: [dangerButton, secondaryActions]
}

dangerButton = button.mediumDanger {left: 213px, top: 242px}

secondaryActions = frame {
  height: 100%,
  layout: {item-gap: 8px},
  overflow: .visible,
  children: [shareButton, moreButton]
}

shareButton = button.mediumIcon {
  left: 233px,
  top: 262px,

  button.mediumIconGlyph {
    contents: direct24
  }
}

moreButton = button.mediumIcon {
  left: 253px,
  top: 282px,

  button.mediumIconGlyph {
    contents: ellipsishorizontal24
  }
}
