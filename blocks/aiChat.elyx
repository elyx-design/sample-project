export aiChat = cardBackground.none {
  left: -465px,
  top: 429px,
  width: 550px,
  height: 395px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .stretch,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: [insert(chatBody, after = .nil)]
}

chatBody = frame {
  left: 112px,
  top: 92.25px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, justify-content: .space-between, item-gap: 20px},
  padding: 0px,
  children: [messageThread, assistantAvatar]
}

messageThread = frame {
  left: 12px,
  top: 48px,
  width: 100%,
  layout: {direction: .column, align-items: .stretch, item-gap: 24px},
  overflow: .visible,
  padding-left: 12px,
  padding-right: 12px,
  children: [userMessage, assistantResponse]
}

userMessage = chatBubble.user {
  left: 1066px,
  top: 464px,
  layout.justify-content: .end,
  overrides: [remove(chatBubble.profileAvatar)],

  chatBubble.message.messageText {
    contents: "Help me make a grocery list for the week"
  }
}

assistantResponse = text {
  left: 0px,
  top: 299px,
  width: 100%,
  fill: .black,
  contents: "Perfect!\n\nPerfect! I've put together a complete grocery list for the week based on what you usually eat, with a good balance of staples, fresh produce, and protein so you'll have everything you need. Here's your list:\n• Bread\n• Eggs\n• Rice\n• Beans\n• Chicken breast\n• Lettuce",
  line-height: 1.5
}

assistantAvatar = frame {
  left: 12px,
  top: 359px,
  width: 24px,
  height: 24px,
  layout: {justify-content: .center, align-items: .center},
  overflow: .visible,
  padding-left: 20px,
  children: assistantIcon
}

assistantIcon = icon {left: 0px, top: 0px, width: 526px, height: 24px, contents: robot24}
