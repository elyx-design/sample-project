import "components/cardBackground.elyx" as cardBackground
import "tokens/radius.elyx" as radius
import "blocks/textBox.elyx" as textBox
import "components/chatBubble.elyx" as chatBubble
import "components/appTopBar.elyx" as appTopBar
import "icons/24 pixels/robot-24.svg" as robot24

export aiChat = cardBackground.transparent {
  left: 544px,
  top: 368px,
  width: 550px,
  height: 628px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .stretch,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: [insert(topBar, after = .nil), insert(chatBody, after = topBar)]
}

topBar = appTopBar.appTopBar {left: 598px, top: 208px, fill[0].visible: .false}

chatBody = frame {
  width: 100%,
  height: 100%,
  layout: {
    direction: .column,
    justify-content: .space-between,
    align-items: .stretch,
    item-gap: 20px
  },
  padding: [48px, 12px, 12px],
  children: [messageArea, chatInput]
}

messageArea = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 20px},
  children: [messageThread, assistantAvatar]
}

messageThread = frame {
  width: 100%,
  layout: {direction: .column, align-items: .stretch, item-gap: 24px},
  overflow: .visible,
  padding-left: 12px,
  padding-right: 12px,
  children: [userMessage, assistantResponse]
}

userMessage = chatBubble.user {
  left: 1066px,
  top: 464px,
  layout.justify-content: .end,

  chatBubble.message.messageText {
    contents: "RAM or processor for video editing?"
  }
}

assistantResponse = text {
  left: 0px,
  top: 299px,
  width: 100%,
  fill: .black,
  contents: "For video editing, both matter, but the answer depends on your workflow.\n\nRAM helps most when you're working with multiple applications open, editing high-resolution footage, or using large project files. If you frequently run out of memory, editing becomes slow and choppy.\n\nWhat resolution do you typically work with?",
  line-height: 1.5
}

assistantAvatar = frame {
  left: 0px,
  top: 227px,
  width: 24px,
  height: 24px,
  layout: {justify-content: .center, align-items: .center},
  overflow: .visible,
  padding-left: 20px,
  children: assistantIcon
}

assistantIcon = icon {left: 0px, top: 0px, width: 526px, height: 24px, contents: robot24}

chatInput = textBox.chatInput {
  left: 0px,
  top: 1178px,
  width: 100%,
  corner-radius: radius.radius.m,
  shadow[0].drop-shadow.visible: .false
}
