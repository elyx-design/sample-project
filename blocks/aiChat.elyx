import "components/cardBackground.elyx" as cardBackground
import "components/chatBubble.elyx" as chatBubble
import "icons/24 pixels/robot-24.svg" as robot24

export aiChat = cardBackground.none {
  left: -465px,
  top: 429px,
  width: 550px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.item-gap: 24px,
  overrides: [insert(messageThread, after = .nil), insert(layer1, after = messageThread)]
}

messageThread = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, align-items: .stretch, item-gap: 24px},
  overflow: .visible,
  padding-left: 12px,
  padding-right: 12px,
  children: [userMessage, assistantResponse]
}

userMessage = chatBubble.user {
  left: 1066px,
  top: 464px,
  layout.justify-content: .end,
  overrides: [remove(chatBubble.profileAvatar)],

  chatBubble.message.messageText {
    contents: "Help me make a grocery list for the week"
  }
}

assistantResponse = text {
  left: 0px,
  top: 299px,
  width: 100%,
  fill: .black,
  contents: "Perfect!\n\nI've put together a complete grocery list for the week based on what you usually eat, with a good balance of staples, fresh produce, and protein so you'll have everything you need. Here's your list:\n• Bread\n• Eggs\n• Rice\n• Beans\n• Chicken breast\n• Lettuce",
  line-height: 1.5
}

layer1 = frame {
  left: 0px,
  top: 331px,
  width: 8.7273%,
  layout: {align-items: .center},
  overflow: .visible,
  children: assistantIcon
}

assistantIcon = icon {left: 0px, top: 0px, width: 100%, height: 24px, contents: robot24}
