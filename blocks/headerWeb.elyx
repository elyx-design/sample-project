import "components/cardBackground.elyx" as cardBackground
import "tokens/spacing.elyx" as spacing
import "tokens/colors.elyx" as colors
import "components/button.elyx" as button
import "components/avatar.elyx" as userAvatar
import "icons/12 pixels/chevron-down-12.svg" as chevrondown122

export siteHeader = cardBackground.transparent {
  name: "Site Header",
  left: 512px,
  top: 456px,
  width: 1024px,
  height: 68px,
  padding-top: 0px,
  padding-left: spacing.spacing.paddingL,
  padding-bottom: 0px,
  padding-right: spacing.spacing.paddingL,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: []
}

export menu = frame {
  name: "Menu",
  left: 191px,
  top: 456px,
  width: .auto,
  layout: {justify-content: .center, align-items: .center},
  children: label
}

label = text {
  name: "Menu",
  left: 0px,
  top: 0px,
  fill: colors.colors.black20,
  contents: "Menu",
  font-style: "Medium"
}

@variant("Menu Variant")
mutedMenu = menu {
  left: 191px,
  top: 521px,

  label {
    fill[0].color: colors.colors.blackAlpha50
  }
}

@variant("HeaderWeb Logged in")
loggedInHeader = siteHeader {left: 512px, top: 572px, height: spacing.spacing.heightG}

@variant("Menu (icon)")
iconMenu = menu {
  left: 275px,
  top: 456px,
  layout.item-gap: 2px,
  overrides: [insert(chevron, after = label)]
}

@variant("Menu Variant")
mutedIconMenu = menu {
  left: 275px,
  top: 521.6479px,
  layout.item-gap: 2px,
  overrides: [insert(mutedChevron, after = label)],

  label {
    fill[0].color: colors.colors.blackAlpha50
  }
}

headerActions = frame {
  name: "Header Actions",
  height: 100%,
  layout: {align-items: .center, item-gap: 16px},
  children: [signInLink, joinButton]
}

signInLink = menu {
  name: "Sign In Link",
  left: 1101px,
  top: 505px,

  label {
    contents: "Sign In"
  }
}

joinButton = button.mediumPrimary {
  name: "Join the Circle Button",
  left: 867px,
  top: 498px,

  button.mediumLabel {
    contents: "Join the Circle"
  }
}

mutedChevron = icon {
  name: "Menu Chevron",
  left: 278px,
  top: 460px,
  width: 12px,
  height: 12px,
  fill: colors.colors.blackAlpha50,
  contents: chevrondown122
}

chevron = icon {
  name: "Menu Chevron",
  left: 297px,
  top: 460px,
  width: 12px,
  height: 12px,
  fill: colors.colors.black20,
  contents: chevrondown122
}

primaryNavigation = frame {
  name: "Primary Navigation",
  left: 0px,
  top: 27.5px,
  width: .auto,
  height: 17px,
  layout: {justify-content: .center, align-items: .center, item-gap: 20px},
  children: [productMenu, pricingLink, blogLink, helpCenterLink]
}

productMenu = iconMenu {
  name: "Product Menu",
  left: 0px,
  top: 0px,
  height: 17px,

  label {
    contents: "Product"
  }
}

pricingLink = mutedMenu {
  name: "Pricing Link",
  left: 58px,
  top: 0px,
  height: 17px,

  label {
    contents: "Pricing"
  }
}

blogLink = mutedMenu {
  name: "Blog Link",
  left: 78px,
  top: 20px,
  height: 17px,

  label {
    contents: "Blog"
  }
}

helpCenterLink = mutedMenu {
  name: "Help Center Link",
  left: 128px,
  top: 20px,
  height: 17px,

