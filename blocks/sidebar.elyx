@variant("sidebar (Contracted)")
compact = accountSidebar {
  left: 539.2797px,
  top: 0px,
  width: 60px,
  height: 456px,
  padding-top: 20px,
  padding-left: 12px,
  padding-bottom: 20px,
  padding-right: 12px,
