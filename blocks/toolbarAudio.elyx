import "components/audioBar.elyx" as audioBar
import "tokens/spacing.elyx" as spacing
import "components/button.elyx" as button
import "components/cardBackground.elyx" as cardBackground
import "icons/20 pixels/play-20.svg" as play20
import "icons/20 pixels/star-20.svg" as star20

export audioToolbar = cardBackground.transparentFullRadius {
  name: "Toolbar (audio)",
  left: 828px,
  top: 798px,
  width: .auto,
  height: spacing.spacing.heightM,
  min-height: .nil,
  padding-top: 0px,
  padding-left: 4px,
  padding-bottom: 0px,
  padding-right: 4px,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: [insert(controls, after = .nil), insert(close, after = controls)]
}

close = button.smallClose {name: "Close", left: 218px, top: 40px}

controls = frame {
  name: "Audio Controls",
  height: 100%,
  layout: {align-items: .center, item-gap: 4px},
  children: [play, audio, tools]
}

play = button.smallPrimaryRounded {
  name: "Play Button",
  left: 0px,
  top: 4px,

  button.smallPrimaryRoundedIcon {
    contents: play20
  }
}

audio = audioBar.audioBar {name: "Audio Bar", left: 863px, top: 837px}

tools = frame {
  name: "Tools",
  height: 100%,
  layout: {align-items: .center, item-gap: 4px},
  children: [favorite, more]
}

favorite = button.smallIcon {
  name: "Favorite Button",
  left: 218px,
  top: 40px,

  button.smallIconGlyph {
    contents: star20
  }
}

more = button.smallIcon {name: "More Button", left: 198px, top: 20px}
