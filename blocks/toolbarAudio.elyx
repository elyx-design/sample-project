export audioToolbar = cardBackground.transparentFullRadius {
  left: 828px,
  top: 798px,
  width: .auto,
  height: spacing.size.medium,
  min-height: .nil,
  padding-top: 0px,
  padding-left: spacing.padding.xsmall,
  padding-bottom: 0px,
  padding-right: spacing.padding.xsmall,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: spacing.gap.xlarge,
  layout.justify-content: .space-between,
  overrides: [insert(controls, after = .nil), insert(close, after = controls)]
}

close = button.smallClose {left: 218px, top: 40px}

controls = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: spacing.gap.xsmall},
  children: [play, audio, tools]
}

