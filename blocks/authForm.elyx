import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "components/button.elyx" as Button
import "components/checkbox.elyx" as Checkbox
import "components/textField.elyx" as TextField
import "components/header.elyx" as header2
import "components/cardBackground.elyx" as cardBackground
import "icons/24 pixels/mail-24.svg" as mail24
import "icons/24 pixels/padlock-24.svg" as padlock24
import "components/logo.elyx" as logo

export signInForm = cardBackground.transparent {
  name: "Sign In Form",
  left: 39px,
  top: 21px,
  padding-top: 48px,
  layout.align-items: .center,
  layout.item-gap: 48px,
  overrides: [insert(signInLogo, after = .nil), insert(content, after = signInLogo)]
}

content = frame {
  name: "Content",
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 20px},
  children: [header, credentialFields, options, signInButton]
}

header = header2.mediumCenter {
  name: "Header M (Center)",
  left: -33px,
  top: 120px,

  header2.mediumSubtitle {
    contents: "Use your account to continue."
  }

  header2.mediumTitle {
    contents: "Sign In"
  }
}

credentialFields = frame {
  name: "Credential Fields",
  left: 0px,
  top: 42.75px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.spacing.m},
  overflow: .visible,
  children: [emailField, passwordField]
}

emailField = TextField.iconPlaceholder {
  name: "Email Field",

  TextField.label {
    contents: "Email address"
  }

  TextField.placeholderIcon {
    contents: mail24
  }
}

passwordField = TextField.iconPlaceholder {
  name: "Password Field",

  TextField.label {
    contents: "Password"
  }

  TextField.placeholderIcon {
    contents: padlock24
  }
}

options = frame {
  name: "Options",
  left: -33px,
  top: 62.75px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 8px},
  children: [rememberToggle, rememberLabel]
}

rememberToggle = Checkbox.on {name: "Remember Me Toggle", left: 127px, top: 285px}

rememberLabel = text {
  name: "Remember Label",
  fill: Colors.colors.black20,
  contents: "Remember me",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

signInButton = Button.mediumPrimary {
  name: "Sign In Button",
  width: 100%,

  Button.mediumLabel {
    contents: "Sign in"
  }
}

signInLogo = logo.extraLarge {name: "Sign In Logo", left: 351px, top: 15px}
