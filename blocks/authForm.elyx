import "tokens/strings.elyx" as Strings
import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "components/button.elyx" as Button
import "components/checkbox.elyx" as Checkbox
import "components/textField.elyx" as TextField
import "components/header.elyx" as header2
import "components/cardBackground.elyx" as cardBackground
import "icons/24 pixels/mail-24.svg" as mail24
import "icons/24 pixels/padlock-24.svg" as padlock24
import "components/logo.elyx" as logo

export signInForm = frame : cardBackground.transparent {
  left: 39px,
  top: 21px,
  padding-top: 48px,
  layout.align-items: .center,
  layout.item-gap: 48px,
  overrides: [insert(signInLogo, after = .nil), insert(content, after = signInLogo)]
}

content = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  children: [header, credentialFields, options, signInButton]
}

header = frame : header2.mediumCenter {
  left: -33px,
  top: 120px,

  header2.mediumSubtitle {
    contents: Strings.forms.accountPrompt
  }

  header2.mediumTitle {
    contents: Strings.forms.signInTitle
  }
}

credentialFields = frame {
  left: 0px,
  top: 42.75px,
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.medium},
  overflow: .visible,
  children: [emailField, passwordField]
}

emailField = frame : TextField.iconPlaceholder {
  TextField.placeholderIcon {
    contents: mail24
  }

  TextField.label {
    contents: Strings.forms.emailAddress
  }
}

passwordField = frame : TextField.iconPlaceholder {
  TextField.placeholderIcon {
    contents: padlock24
  }

  TextField.label {
    contents: Strings.forms.password
  }
}

options = frame {
  left: -33px,
  top: 62.75px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [rememberToggle, rememberLabel]
}

rememberToggle = frame : Checkbox.on {left: 127px, top: 285px}

rememberLabel = text {
  fill: Colors.colors.black20,
  contents: Strings.forms.rememberMe,
  font-size: Spacing.fontSize.medium
}

signInButton = frame : Button.mediumPrimary {
  width: 100%,

  Button.mediumLabel {
    contents: Strings.actions.signIn
  }
}

signInLogo = frame : logo.extraLarge {left: 351px, top: 15px}
