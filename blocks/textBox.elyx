import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/button.elyx" as button
import "icons/20 pixels/plus-20.svg" as plus20
import "icons/20 pixels/more-20.svg" as more20
import "icons/20 pixels/search-20.svg" as search20
import "icons/20 pixels/voice-20.svg" as voice20
import "icons/20 pixels/arrowUp-20.svg" as arrowUp20
import "components/logo.elyx" as logo

export chatInput = cardBackground.base {
  name: "Chat Input",
  left: 511px,
  top: 471px,
  width: 462px,
  height: 120px,
  padding-top: 16px,
  padding-left: 16px,
  padding-bottom: 16px,
  padding-right: 16px,
  layout.item-gap: 20px,
  layout.justify-content: .space-between,
  overrides: [insert(prompt, after = .nil), insert(actions, after = prompt)]
}

actions = frame {
  name: "Input Actions",
  width: 100%,
  layout: {justify-content: .space-between, item-gap: 8px},
  overflow: .visible,
  children: [attachmentActions, messageActions]
}

attachmentActions = frame {
  name: "Attachment Actions",
  height: 100%,
  layout: {item-gap: 8px},
  overflow: .visible,
  children: [add, modelSelector, search, more]
}

add = button.smallIconBackground {
  name: "Add Button",
  left: 654px,
  top: 728px,

  button.smallBackgroundIcon {
    contents: plus20
  }
}

modelSelector = button.small {
  name: "Model Selector",
  left: 694px,
  top: 768px,

  button.smallLabel {
    contents: "Haze 4.8 Pro"
  }
}

search = button.smallIconBackground {
  name: "Search Button",
  left: 674px,
  top: 748px,

  button.smallBackgroundIcon {
    contents: search20
  }
}

more = button.smallIconBackground {
  name: "More Button",
  left: 694px,
  top: 768px,

  button.smallBackgroundIcon {
    contents: more20
  }
}

messageActions = frame {
  name: "Message Actions",
  height: 100%,
  layout: {item-gap: 8px},
  overflow: .visible,
  children: [voice, send]
}

voice = button.smallIconBackground {
  name: "Voice Button",
  left: 714px,
  top: 788px,

  button.smallBackgroundIcon {
    contents: voice20
  }
}

send = button.smallPrimaryRounded {
  name: "Send Button",
  left: 734px,
  top: 808px,

  button.smallPrimaryRoundedIcon {
    contents: arrowUp20
  }
}

prompt = frame {
  name: "Prompt Header",
  width: 100%,
  layout: {align-items: .center, item-gap: 8px},
  children: [promptLogo, placeholder]
}

promptLogo = logo.small {name: "Logo S (24)", left: 657px, top: 485px}

placeholder = text {
  name: "Prompt Placeholder",
  left: 633px,
  top: 581px,
  fill: colors.colors.black80,
  contents: "Ask anything..."
}
