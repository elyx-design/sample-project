export activityCard = frame {
  left: 0px,
  top: 433px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: Spacing.spacing.paddingL},
  fill: .white,
  border: {color: rgb(0%, 0%, 0%, 8%), position: .outside},
  corner-radius: Radius.radius.l,
  padding: Spacing.spacing.xl,
  children: [layer, activityRow_2, activityRow_a, activityRow_v]
