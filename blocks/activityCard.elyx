import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "components/header.elyx" as header
import "components/activityRow.elyx" as activityRow

export activityCard = frame {
  left: 0px,
  top: 433px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: Spacing.spacing.paddingL},
  fill: .white,
  border: {color: rgb(0%, 0%, 0%, 8%), position: .outside},
  corner-radius: Radius.radius.l,
  padding: Spacing.spacing.xl,
  children: [layer, layer1]
}

layer = header.mediumLeft {
  left: 35px,
  top: 453px,

  header.mediumSubtitle {
    contents: "Security and account events"
  }

  header.mediumTitle {
    contents: "Recent activity"
  }
}

layer1 = frame {
  left: 0px,
  top: 83px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, align-items: .center},
  overflow: .visible,
  slot: .true,
  restrict-children: .true,
  children: [firstRow, firstRow_2, firstRow_3]
}

firstRow = activityRow.activityRow {left: 0px, top: 0px}

firstRow_2 = activityRow.activityRow {left: 20px, top: 20px}

firstRow_3 = activityRow.activityRow {left: 40px, top: 40px}
