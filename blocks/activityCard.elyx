layer = header.mediumLeft {
  left: 35px,
  top: 453px,

  header.mediumSubtitle {
    contents: "Security and account events"
  }

  header.mediumTitle {
    contents: "Recent activity"
  }
}

activityRow_2 = activityRow.activityRow {left: 0px, top: 81px, width: 100%}

