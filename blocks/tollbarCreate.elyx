export toolbarCreate = cardBackground.transparentFullRadius {
  name: "Toolbar Create",
  left: 488px,
  top: 479px,
  width: 348px,
  height: spacing.spacing.heightM,
  min-width: .nil,
  min-height: .nil,
  padding-top: 0px,
  padding-left: 12px,
  padding-bottom: 0px,
  padding-right: 4px,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: 8px,
  layout.justify-content: .space-between,
  overrides: [insert(tools, after = .nil), insert(close, after = tools)]
}

close = button.smallClose {name: "Close", left: 686px, top: 602px}

tools = frame {
  name: "Tools",
  height: 100%,
  layout: {align-items: .center, item-gap: 8px},
