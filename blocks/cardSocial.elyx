    contents: "Follow"
  }
}

cardContent = frame {
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .end, item-gap: 24px},
  fill: {image: {ref: dots}},
  border: {color: colors.colors.blackAlpha10, visible: .false, width: 0.5px, position: .outside},
  corner-radius: 16px,
  padding: 24px,
  children: [cardActions, profileInfo]
}

cardActions = frame {
  width: 100%,
