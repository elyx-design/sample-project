export socialCard = cardBackground.transparent {
  left: 186px,
  top: 176px,
  width: 317px,
  height: 427px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .center,
  layout.item-gap: 16px,
  layout.justify-content: .space-between,
  overrides: [insert(cardContent, after = .nil), insert(socialFooter, after = cardContent)]
}

smallButton = button.small {left: 1318px, top: 603px}

mediumSummary = userSummary.UserSummaryM_3TgjJsJRgL {left: 1187.73px, top: 318.4px, width: 88px}

socialFooter = frame {
  width: 100%,
