import "tokens.elyx" as tokens
import "components/button.elyx" as Button
import "components/iconButton.elyx" as IconButton

pub alertBanner = frame {
  name: "Alert Banner",
  left: 80px,
  top: 80px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 12},
  corner-radius: 12px,
  padding: tokens.paddingM,
  fill: rgb(94.25%, 97.0062%, 98.9478%),
  border: rgb(12.9363%, 55.29%, 98.8257%, 30%),
  shadow: {
    drop-shadow: {color: rgb(0%, 0%, 0%, 5%), offset: point(0px, 5px), blur-radius: 10px, spread: 0px, style: .smooth}
  },
  children: [statusIcon, copy, actionButton, closeButton]
}

statusIcon = IconButton.Icon {overrides: [set(IconButton.defaultsvg, "fill[0].color", tokens.colorPrimary)]}

copy = frame {
  name: "Copy",
  width: .auto,
  layout: {direction: .column, item-gap: 4},
  children: [alertTitle, alertMessage]
}

alertTitle = text {
  name: "Title",
  contents: "Project saved",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeML,
  font-style: "Medium",
  fill: tokens.textColorDark
}

alertMessage = text {
  name: "Message",
  contents: "Your latest changes are available to everyone.",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeM,
  font-style: "Regular",
  fill: tokens.textColorDarkSecondary
}

actionButton = Button.ButtonVariant_V {
  overrides: [set(Button.Button, "contents", "View"), set(Button.Button, "fill[0].color", .white)]
}

closeButton = IconButton.ButtonIconMVariant_N {
  overrides: [set(IconButton.defaultsvg, "fill[0].color", tokens.colorPrimary)]
}

@variant(Danger)
pub dangerAlertBanner = alertBanner {
  left: 80px,
  top: 193.5px,
  overrides: [
    set("fill[0].color", rgb(99.999%, 94.4394%, 93.3791%)),
    set("border[0].color", rgb(100%, 10.15%, 17.63%, 35%)),
    set(closeButton.IconButton.defaultsvg, "fill[0].color", tokens.colorDanger),
    set(actionButton, "$source", Button.ButtonVariant_T),
    set(statusIcon.IconButton.defaultsvg, "fill[0].color", tokens.colorDanger)
  ]
}
