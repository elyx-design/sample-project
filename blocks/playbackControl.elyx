import "components/cardBackground.elyx" as cardBackground
import "tokens/spacing.elyx" as spacing
import "components/slider.elyx" as slider
import "components/button.elyx" as button
import "icons/20 pixels/play-20.svg" as play20
import "icons/20 pixels/more-20.svg" as more20
import "icons/20 pixels/heart-20.svg" as heart20
import "icons/20 pixels/settings-20.svg" as settings20

export playbackControl = cardBackground.none {
  left: 669px,
  top: 522px,
  width: 359px,
  height: spacing.spacing.heightS,
  min-height: .nil,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: 12px,
  overrides: [
    insert(scrubber, after = .nil),
    insert(playbackTime, after = scrubber),
    insert(tools, after = playbackTime)
  ]
}

tools = frame {
  height: 100%,
  layout: {align-items: .center},
  children: [settingsButton, likeButton, moreButton]
}

settingsButton = button.smallIcon {
  left: 264.5px,
  top: 8.5px,

  button.smallIconGlyph {
    contents: settings20
  }
}

likeButton = button.smallIcon {
  left: 284.5px,
  top: 28.5px,

  button.smallIconGlyph {
    contents: heart20
  }
}

moreButton = button.smallIcon {
  left: 284.5px,
  top: 28.5px,

  button.smallIconGlyph {
    contents: more20
  }
}

playbackTime = text {left: 722px, top: 543px, fill: .black, contents: "0:00 / 32:46", font-size: 12}

scrubber = frame {
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: 2px},
  children: [playButton, progressSlider]
}

playButton = button.smallIcon {
  left: 737px,
  top: 580px,

  button.smallIconGlyph {
    contents: play20
  }
}

progressSlider = slider.base {left: 0px, top: 636px, width: 100%}
