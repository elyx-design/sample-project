import "blocks/playbackControl.elyx" as playbackControl
import "tokens/colors.elyx" as colors
import "images/background/liveEvent.jpg" as liveEvent
import "components/header.elyx" as header
import "components/tag.elyx" as tag

export videoPlayer = frame {
  left: 368px,
  top: 405px,
  width: 643px,
  height: 420px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: liveEvent}},
    {
      linear-gradient: {
        from: point(50%, 70.4884%),
        to: point(50%, 100%),
        stops: [stop(0%, .transparent), stop(100%, rgb(0%, 0%, 0%, 50%))]
      }
    },
    {
      linear-gradient: {
        from: point(50%, 0%),
        to: point(50%, 24.4%),
        stops: [stop(0%, rgb(0%, 0%, 0%, 50%)), stop(97.76%, .transparent)]
      }
    }
  ],
  padding: 20px,
  children: [headerRow, controls]
}

headerRow = frame {
  width: 100%,
  layout: {justify-content: .space-between},
  children: [eventHeader, liveStatus]
}

eventHeader = header.smallLeft {
  left: 501px,
  top: 250px,

  header.smallSubtitle {
    contents: "Live from the dunes: Stage 3",
    fill[0].color: colors.colors.whiteAlpha70
  }

  header.smallTitle {
    contents: "Endless Dunes",
    fill[0].color: colors.colors.white100
  }
}

liveStatus = tag.status {
  left: 806px,
  top: 450px,
  fill[0].color: rgb(0%, 100%, 43.07%, 54%),

  tag.label {
    contents: "Live",
    fill[0].color: colors.colors.white100
  }

  tag.statusIcon {
    fill[0].color: .lime
  }
}

controls = playbackControl.playbackControl {
  left: 0px,
  top: 809px,
  width: 100%,

  playbackControl.tools.moreButton.button.smallIconGlyph {
    fill[0].color: colors.colors.whiteAlpha70
  }

  playbackControl.tools.likeButton.button.smallIconGlyph {
    fill[0].color: colors.colors.whiteAlpha70
  }

  playbackControl.tools.settingsButton.button.smallIconGlyph {
    fill[0].color: colors.colors.whiteAlpha70
  }

  playbackControl.playbackTime {
    fill[0].color: colors.colors.whiteAlpha70
  }

  playbackControl.scrubber.playButton.button.smallIconGlyph {
    fill[0].color: colors.colors.whiteAlpha70
  }
}
