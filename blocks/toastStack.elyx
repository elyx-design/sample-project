import "scaffold/blocks/alertBanner.elyx" as AlertBanner

pub toastStack = frame {
  name: "Toast Stack",
  left: 80px,
  top: 80px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 8},
  overflow: .visible,
  children: [layer, AlertBanner_a]
}

layer = AlertBanner.alertBanner {
  left: 108px,
  top: 94px,
  overrides: [move(AlertBanner.closeButton, {after: AlertBanner.copy}), remove(AlertBanner.actionButton)]
}

AlertBanner_a = AlertBanner.dangerAlertBanner {
  left: 128px,
  top: 114px,
  overrides: [move(AlertBanner.closeButton, {after: AlertBanner.copy}), remove(AlertBanner.actionButton)]
}
