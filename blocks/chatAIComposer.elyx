import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "components/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "components/button.elyx" as button
import "icons/20 pixels/plus-20.svg" as plus20
import "icons/20 pixels/more-20.svg" as more20
import "icons/20 pixels/search-20.svg" as search20
import "icons/20 pixels/voice-20.svg" as voice20
import "icons/20 pixels/arrowUp-20.svg" as arrowUp20
import "components/logo.elyx" as logo

export chatAIComposer = frame : cardBackground.transparent {
  left: 511px,
  top: 471px,
  width: 462px,
  height: 120px,
  padding-top: Spacing.padding.large,
  padding-left: Spacing.padding.large,
  padding-bottom: Spacing.padding.large,
  padding-right: Spacing.padding.large,
  layout.item-gap: Spacing.gap.xlarge,
  layout.justify-content: .space-between,
  overrides: [insert(prompt, after = .nil), insert(actions, after = prompt)],

  actions = frame {
    width: 100%,
    layout: {justify-content: .space-between, item-gap: Spacing.gap.small},
    overflow: .visible,
    children: [attachmentActions, messageActions]
  }
}

attachmentActions = frame {
  height: 100%,
  layout: {item-gap: Spacing.gap.small},
  overflow: .visible,
  slot: .true,
  restrict-children: .true,
  children: [add, modelSelector, search, more],

  add = frame : button.smallIconBackground {
    left: 654px,
    top: 728px,

    button.smallIconBackground.smallBackgroundIcon {
      contents: plus20
    }
  }

  modelSelector = frame : button.small {
    left: 694px,
    top: 768px,

    button.small.smallLabel {
      contents: "Haze 4.8 Pro"
    }
  }

  search = frame : button.smallIconBackground {
    left: 674px,
    top: 748px,

    button.smallIconBackground.smallBackgroundIcon {
      contents: search20
    }
  }

  more = frame : button.smallIconBackground {
    left: 694px,
    top: 768px,

    button.smallIconBackground.smallBackgroundIcon {
      contents: more20
    }
  }
}

messageActions = frame {
  height: 100%,
  layout: {item-gap: Spacing.gap.small},
  overflow: .visible,
  slot: .true,
  restrict-children: .true,
  children: [voice, send],

  voice = frame : button.smallIconBackground {
    left: 714px,
    top: 788px,

    button.smallIconBackground.smallBackgroundIcon {
      contents: voice20
    }
  }

  send = frame : button.smallPrimaryRounded {
    left: 734px,
    top: 808px,

    button.smallPrimaryRounded.smallPrimaryRoundedIcon {
      contents: arrowUp20
    }
  }
}

prompt = frame {
  width: 100%,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [small, placeholder],

  small = frame : logo.small {left: 550px, top: 487px}

  placeholder = text {
    left: 633px,
    top: 581px,
    fill: colors.theme.contrastDefault,
    contents: Strings.forms.askAnything
  }
}
