import "components/cardBackground.elyx" as cardBackground
import "components/header.elyx" as header2
import "components/settingRow.elyx" as settingRow

header = header2.mediumLeft {
  left: 0px,
  top: 532px,

  header2.mediumSubtitle {
    contents: "Review sign-in methods and active protections."
  }

  header2.mediumTitle {
    contents: "Security"
  }
}

export securityCard = cardBackground.base {
  left: 0px,
  top: 263px,
  width: 100%,
  height: .auto,
  overrides: [
    insert(header, after = .nil),
    insert(password, after = header),
    insert(twoFactorAuthentication, after = password)
  ]
}

password = settingRow.settingRow {
  left: 0px,
  top: 92px,
  width: 100%,
  height: .auto,

  settingRow.action.button.mediumLabel {
    contents: "Change"
  }

  settingRow.copy.description {
    contents: "Last changed 23 days ago."
  }

  settingRow.copy.title {
    contents: "Password"
  }
}

twoFactorAuthentication = settingRow.settingRow {
  left: 20px,
  top: 112px,
  width: 100%,
  height: .auto,

  settingRow.action.button.mediumLabel {
    contents: "Manage"
  }

  settingRow.copy.description {
    contents: "Enabled for all workspace admins."
  }

  settingRow.copy.title {
    contents: "Two-factor authentication"
  }
}
