export Selector = frame {
  left: 268px,
  top: 443px,
  layout: {justify-content: .space-between, align-items: .center, item-gap: 15px},
  overflow: .visible,
  children: [Left, shape1]
}

Left = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 15px},
  overflow: .visible,
  children: [small, smallLeft]
}

small = avatar.smallPhoto {left: 0px, top: 2px}

smallLeft = header.smallLeft {
  left: 51px,
  top: 0px,

  header.smallSubtitle {
    contents: Strings.labels.manager
  }

  header.smallTitle {
    contents: "Nora"
  }
}

shape1 = icon {left: 26px, top: 8px, width: 24px, height: 24px, contents: chevronupDown24}
