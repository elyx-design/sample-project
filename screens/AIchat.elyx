import "blocks/sideBar.elyx" as sideBar
import "tokens/colors.elyx" as colors
import "blocks/chatAIComposer.elyx" as chatAIComposer
import "images/background/waves.jpg" as waves
import "blocks/aiChat.elyx" as aiChat

AIChat = frame {
  left: 434px,
  top: 294px,
  width: 1360px,
  height: 776px,
  layout: {align-items: .center},
  fill: {image: {ref: waves}},
  padding: 12px,
  children: [sidebar_2, layer1]
}

sidebar_2 = sideBar.sidebar {left: 344.58px, top: 0px, width: 18%, height: 100%}

layer1 = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {
    direction: .column,
    justify-content: .space-between,
    align-items: .center,
    item-gap: 16px
  },
  overflow: .visible,
  padding-top: 120px,
  padding-bottom: 48px,
  children: [aiChat_2, bottom]
}

aiChat_2 = aiChat.aiChat {left: 879px, top: 0px, height: 341px, min-height: .nil}

bottom = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 16px},
  overflow: .visible,
  children: [chatAIComposer_2, text1]
}

chatAIComposer_2 = chatAIComposer.chatAIComposer {left: 119px, top: 105px, width: 60%}

text1 = text {
  left: 1412px,
  top: 1073px,
  fill: colors.colors.blackAlpha50,
  contents: "Overleaf is AI and can make mistakes. Please double-check responses.",
  font-size: 12
}
