import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "images/background/night.jpg" as night
import "blocks/siteHeader.elyx" as siteHeader
import "tokens/colors.elyx" as colors
import "components/button.elyx" as button
import "components/header.elyx" as header
import "icons/24 pixels/direct-24.svg" as direct24
import "icons/24 pixels/activity.svg" as activity
import "components/tag.elyx" as tag
import "icons/20 pixels/arrowDown-20.svg" as arrowDown20
import "icons/24 pixels/mug-24.svg" as mug24
import "tokens/radius.elyx" as Radius

export LandingPage = frame {
  left: -5px,
  top: 137px,
  width: 1605px,
  height: 940px,
  layout: {
    direction: .column,
    justify-content: .space-between,
    align-items: .center,
    item-gap: 116px
  },
  fill: {image: {ref: night}},
  padding-top: Spacing.padding.xxlarge,
  padding-bottom: Spacing.padding.xxlarge,
  children: [top, frame3]
}

top = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 96px},
  overflow: .visible,
  children: [pageHeader, Copy]
}

pageHeader = siteHeader.siteHeader {
  left: 388.5px,
  top: 145px,
  width: 60%,
  border[0].visible: .false,
  shadow[0].drop-shadow.visible: .false,

  siteHeader.navLinks {
    overrides: [remove(siteHeader.navResources)]
  }
}

Copy = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.huge},
  overflow: .visible,
  children: [largeLeft, frame2]
}

largeLeft = header.largeCenter {
  left: 1840px,
  top: 449px,
  width: 44.0752%,

  header.largeSubtitle {
    contents: Strings.landingPage.heroDescription
  }

  header.largeTitle {
    contents: Strings.landingPage.heroTitle
  }
}

frame2 = frame {
  width: 100%,
  layout: {justify-content: .center, align-items: .center, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  children: [medium, text3]
}

medium = button.medium {
  left: 733px,
  top: 353px,

  button.mediumLabel {
    contents: Strings.actions.getStarted
  }
}

text3 = text {
  left: 854px,
  top: 477px,
  fill: colors.colors.blackAlpha50,
  contents: Strings.actions.watchDemo,
  font-style: "SemiBold"
}

frame3 = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.huge},
  overflow: .visible,
  children: [bottom, base]
}

bottom = frame {
  left: 311px,
  top: 840px,
  width: 60%,
  height: .auto,
  layout: {align-items: .center, item-gap: Spacing.gap.xxlarge},
  overflow: .visible,
  children: [layer1, layer2, layer3]
}

layer1 = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.colors.whiteAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [shape1, smallLeft]
}

shape1 = icon {left: 644px, top: 704px, width: 40px, height: 40px, contents: direct24}

smallLeft = header.smallLeft {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,

  header.smallSubtitle {
    contents: Strings.landingPage.minimalDescription
  }

  header.smallTitle {
    contents: Strings.landingPage.minimalTitle,
    width: .auto
  }
}

layer2 = frame {
  left: 20px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.colors.whiteAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [shape2, steadyHeader]
}

shape2 = icon {left: 648px, top: 708px, width: 40px, height: 40px, contents: activity}

steadyHeader = header.smallLeft {
  left: 0px,
  top: 0px,
  width: 100%,

  header.smallSubtitle {
    contents: Strings.landingPage.reliabilityDescription
  }

  header.smallTitle {
    contents: Strings.landingPage.reliabilityTitle,
    width: .auto
  }
}

layer3 = frame {
  left: 354.6666px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.colors.whiteAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [shape3, teamHeader]
}

shape3 = icon {left: 655px, top: 715px, width: 40px, height: 40px, contents: mug24}

teamHeader = header.smallLeft {
  left: 0px,
  top: 0px,
  width: 100%,

  header.smallSubtitle {
    contents: Strings.landingPage.collaborationDescription
  }

  header.smallTitle {
    contents: Strings.landingPage.collaborationTitle,
    width: .auto
  }
}

base = tag.iconAndLabel {
  left: 774px,
  top: 1091px,
  border[0].visible: .false,
  fill[0].color: colors.colors.blackAlpha25,

  tag.label {
    contents: Strings.actions.scrollDown,
    fill[0].color: colors.colors.whiteAlpha70
  }

  tag.tagIcon {
    contents: arrowDown20,
    fill[0].color: colors.colors.whiteAlpha70
  }
}
