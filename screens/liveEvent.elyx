import "blocks/videoPlayer.elyx" as videoPlayer
import "tokens/colors.elyx" as colors
import "blocks/chatWindow.elyx" as chatWindow
import "images/background/desert.png" as desert

liveEvent = frame {
  left: -76.9999px,
  top: -8px,
  width: 1415px,
  height: 925px,
  fill: {image: {ref: desert}},
  children: eventPanel
}

eventPanel = frame {
  left: 226.9999px,
  top: 219px,
  width: 962px,
  height: 488px,
  layout: {direction: .column},
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha10,
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  corner-radius: 24px,
  children: layout
}

layout = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {justify-content: .space-between},
  children: [video, chat]
}

video = videoPlayer.videoPlayer {left: 0px, top: 0px, width: 100%, height: 100%}

chat = chatWindow.chatWindow {left: 640px, top: 0px, width: 32.6%, height: 100%}
