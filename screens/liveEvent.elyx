import "blocks/videoPlayer.elyx" as videoPlayer
import "tokens/colors.elyx" as colors
import "blocks/chatWindow.elyx" as chatWindow
import "images/background/desert.png" as desert

LiveEvent = frame {
  name: "Live Event",
  left: -76.9999px,
  top: -8px,
  width: 1415px,
  height: 925px,
  fill: {image: {ref: desert}},
  children: Frame_r
}

Frame_r = frame {
  name: "Event Panel",
  left: 226.9999px,
  top: 219px,
  width: 962px,
  height: 488px,
  layout: {direction: .column},
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha10,
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  corner-radius: 24px,
  children: Frame_Z
}

Frame_Z = frame {
  name: "Video Chat Layout",
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {justify-content: .space-between},
  children: [layer, layer_5]
}

layer = videoPlayer.videoPlayer {
  name: "Video Player",
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%
}

layer_5 = chatWindow.chatWindow {
  name: "Chat Window",
  left: 640px,
  top: 0px,
  width: 32.6%,
  height: 100%
}
