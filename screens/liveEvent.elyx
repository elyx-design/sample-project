  top: 98px,

  button.smallLabel {
    contents: "Subscribe: 25% off"
  }
}

chat = chatWindow.liveChat {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  corner-radius: 0px,
  border[0].color: colors.colors.blackAlpha25,
  border[0].position: .outside,
  border[0].visible: .false,
  border[0].width: 0.5px,

  chatWindow.GroupedStack.chat.base_3.chatBubble.GroupedStack.messageText_3 {
