import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "blocks/videoPlayer.elyx" as videoPlayer
import "tokens/colors.elyx" as colors
import "components/button.elyx" as button
import "blocks/chatWindow.elyx" as chatWindow
import "blocks/siteHeader.elyx" as siteHeader
import "icons/20 pixels/pause-20.svg" as pause20
import "blocks/sideBar.elyx" as sideBar
import "components/userSummary.elyx" as userSummary
import "images/misc/bikeBGBanner.jpg" as bikeBGBanner

export liveEvent = frame {
  left: -642.9999px,
  top: -511px,
  width: 1524px,
  height: 798px,
  layout: {direction: .column, align-items: .center},
  fill: colors.colors.white100,
  children: [siteHeader_2, Content]
}

siteHeader_2 = frame : siteHeader.accountHeader {
  left: 0px,
  top: 43px,
  width: 100%,
  fill[0].color: colors.colors.white100,

  siteHeader.accountDivider {
    overrides: [remove(siteHeader.divider.horizontalLine)]
  }

  siteHeader.accountContent.accountNav.accountResources.label {
    contents: Strings.navigation.playlists
  }

  siteHeader.accountContent.accountNav.accountCompany.label {
    contents: Strings.navigation.categories
  }

  siteHeader.accountContent.accountNav.accountPricing.label {
    contents: Strings.navigation.browse
  }

  siteHeader.accountContent.accountNav.accountProduct.label {
    contents: Strings.status.liveNow
  }
}

Content = frame {
  left: 226.9999px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .row},
  corner-radius: 0px,
  overflow: .visible,
  children: [sidebar, Video, chat]
}

sidebar = frame : sideBar.sidebarLiveEvent {
  left: 751px,
  top: 0px,
  height: 100%,
  corner-radius: 0px,
  border[0].visible: .false,
  fill[0].visible: .false
}

Video = frame {
  left: 0px,
  top: 0px,
  width: 65%,
  height: 100%,
  layout: {direction: .column, align-items: .end, item-gap: Spacing.gap.xxsmall},
  overflow: .visible,
  children: [video, About]
}

video = frame : videoPlayer.videoPlayer {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  corner-radius: 0px,

  videoPlayer.controls.playbackControl.scrubber.playButton.button.smallIconGlyph {
    contents: pause20
  }

  videoPlayer.headerRow.eventHeader.header.smallSubtitle {
    contents: Strings.liveEvent.streamTitle
  }

  videoPlayer.headerRow.eventHeader.header.smallTitle {
    contents: "CAM 3"
  }

  videoPlayer.controls.playbackControl.scrubber.progressSlider.slider.track {
    fill[0].opacity: .nil,
    fill[0].mix-blend-mode: .nil
  }
}

About = frame {
  left: 0px,
  top: 654px,
  width: 100%,
  height: 130px,
  layout: {direction: .column, justify-content: .space-between, item-gap: Spacing.gap.xxlarge},
  fill: {image: {ref: bikeBGBanner}},
  overflow: .visible,
  padding: Spacing.padding.xlarge,
  children: [small, GroupedStack]
}

small = frame : userSummary.small {
  left: -238px,
  top: 333px,

  userSummary.smallHeader.header.smallSubtitle {
    fill[0].color: colors.primitives.white70,
    contents: Strings.liveEvent.channelDescription
  }

  userSummary.smallHeader.header.smallTitle {
    fill[0].color: colors.primitives.white,
    contents: "BikeNOW"
  }

  userSummary.smallHeader {
    width: .auto
  }
}

GroupedStack = frame {
  width: 100%,
  layout: {item-gap: Spacing.gap.small},
  overflow: .visible,
  children: [small_2, small_3, small_4]
}

small_2 = frame : button.small {
  left: 254.9999px,
  top: 58px,

  button.smallLabel {
    contents: Strings.actions.follow
  }
}

small_3 = frame : button.smallPrimary {
  left: 274.9999px,
  top: 78px,

  button.smallLabel {
    contents: Strings.actions.giftSubscription
  }
}

small_4 = frame : button.smallPrimary {
  left: 294.9999px,
  top: 98px,

  button.smallLabel {
    contents: Strings.actions.subscribeDiscount
  }
}

chat = frame : chatWindow.liveChat {left: 0px, top: 0px, width: 100%, height: 100%}
