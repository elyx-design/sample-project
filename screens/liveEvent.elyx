    contents: "Browse"
  }

  siteHeader.accountContent.accountNav.accountProduct.label {
    contents: "Live Now"
  }
}

Content = frame {
  left: 226.9999px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .row},
  corner-radius: 0px,
  overflow: .visible,
  children: [sidebar, Video, chat]
}

sidebar = sideBar.sidebarLiveEvent {
  left: 751px,
  top: 0px,
  height: 100%,
  corner-radius: 0px,
  border[0].visible: .false,
  fill[0].color: colors.colors.white100,
  filter[0].visible: .false,
  shadow[0].drop-shadow.visible: .false
}

Video = frame {
  left: 0px,
  top: 0px,
  width: 65%,
  height: 100%,
  layout: {direction: .column, align-items: .end, item-gap: 2px},
  overflow: .visible,
  children: [video, About]
}

video = videoPlayer.videoPlayer {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  corner-radius: 0px,

  @use-variant(videoPlayer.playbackControl.slider.full)
  videoPlayer.controls.playbackControl.scrubber.progressSlider {}

  videoPlayer.controls.playbackControl.scrubber.playButton.button.smallIconGlyph {
    contents: pause20
  }

  videoPlayer.headerRow.eventHeader.header.smallSubtitle {
    contents: "Lead cycling duo"
  }

  videoPlayer.headerRow.eventHeader.header.smallTitle {
    contents: "CAM 3"
  }
}

About = frame {
  left: 0px,
  top: 654px,
  width: 100%,
  height: 130px,
  layout: {direction: .column, justify-content: .space-between, item-gap: 24px},
  fill: {image: {ref: bikeBGBanner}},
  overflow: .visible,
  padding: 20px,
  children: [small, GroupedStack]
}

small = userSummary.small {
  left: -238px,
  top: 333px,
  overflow: .visible,

  userSummary.smallHeader.header.smallSubtitle {
    contents: "Your go-to spot for everything cycling",
    fill[0].color: colors.colors.whiteAlpha50
  }

  userSummary.smallHeader.header.smallTitle {
    contents: "BikeNOW",
    fill[0].color: colors.colors.white100
  }

  userSummary.smallHeader {
    width: .auto
  }
}

GroupedStack = frame {
  width: 100%,
  layout: {item-gap: 8px},
  overflow: .visible,
  children: [small_2, small_3, small_4]
}

small_2 = button.small {
  left: 254.9999px,
  top: 58px,

  button.smallLabel {
    contents: "Follow"
  }
}

small_3 = button.smallPrimary {
  left: 274.9999px,
