export liveEvent = frame {
  left: -642.9999px,
  top: -511px,
  width: 1524px,
  height: 798px,
  layout: {direction: .column, align-items: .center},
  fill: colors.colors.tealDark,
  children: [siteHeader_2, Content]
}

siteHeader_2 = siteHeader.accountHeader {
  left: 0px,
