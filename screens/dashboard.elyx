import "tokens/colors.elyx" as colors
import "components/cardBackground.elyx" as cardBackground
import "tokens/spacing.elyx" as spacing
import "tokens/radius.elyx" as radius
import "blocks/sidebar.elyx" as sideBar
import "components/breadcrumb.elyx" as breadcrumb
import "components/track.elyx" as mediaTrack

dashboard = frame {
  left: 53px,
  top: 133px,
  width: 1291px,
  height: 846px,
  layout: {direction: .row},
  fill: colors.colors.black95,
  padding: 24px,
  children: frame1
}

frame1 = frame {
  width: 100%,
  height: 100%,
  layout: {item-gap: 16px},
  overflow: .visible,
  children: [sidebar, track, background]
}

sidebar = sideBar.sidebar {left: -74px, top: 0px, width: 274px, height: 100%}

track = mediaTrack.track {left: 504px, top: 544px}

background = cardBackground.base {
  left: 926px,
  top: 0px,
  height: spacing.spacing.heightS,
  corner-radius: radius.radius.max,
  layout.justify-content: .center,
  overrides: [insert(pageBreadcrumb, after = .nil)]
}

pageBreadcrumb = breadcrumb.breadcrumb {left: 463px, top: 361px}
