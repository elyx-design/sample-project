timeline = frame {
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.small},
  fill: {color: Colors.colors.black20, visible: .false},
  padding-top: Spacing.padding.small,
  children: [ruler, tracks]
}

ruler = frame : timelineRuler.timelineRuler {
  left: 0px,
  top: 442.5px,
  width: 100%,
  overflow: .visible,
  padding-left: Spacing.padding.xxlarge,
  padding-right: 0px,
  overrides: [
    insert(marker4, after = timelineRuler.marker3),
    insert(marker5, after = marker4),
    insert(marker6, after = marker5),
    insert(marker7, after = marker6),
    insert(marker8, after = marker7),
    insert(marker9, after = marker8),
    insert(timelinePlayHead, after = marker9)
  ],

  timelineRuler.marker3.label {
    contents: "3"
  }

  timelineRuler.marker2.label {
    contents: "2"
  }

  timelineRuler.marker1.label {
    contents: "1"
  }
}

