  children: [player, gallery]
}

player = frame : videoPlayer.videoPlayer {
  left: -3772px,
  top: 0px,
  width: 60%,
  height: 100%,
  fill[0].image.ref: bird,
  fill[1].linear-gradient.stops[1].color: Colors.gradients.overlayEnd,

  videoPlayer.controls.playbackControl.tools.likeButton.button.smallIconGlyph {
    contents: pen20
  }

  videoPlayer.controls.playbackControl.tools.settingsButton.button.smallIconGlyph {
    contents: pointer20
  }

  @use-variant(slider.thumb)
  videoPlayer.controls.playbackControl.scrubber.progressSlider {}

  videoPlayer.controls.playbackControl.scrubber.progressSlider.slider.handle_2.thumbHandle_2 {
    fill[0].color: Colors.primitives.white,
    border[0].visible: .false
