workspace = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .center},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
