videoEditing = frame {
  left: -689px,
  top: -230px,
  width: 1138px,
  height: 663px,
  layout: {justify-content: .center},
  fill: .black,
  children: [editingSidebar, workspace]
}

editingSidebar = sidebar.compact {
  left: 0px,
  top: 0px,
  height: 100%,

  sidebar.compactContent.compactNavigation.history.button.mediumPlainIconGlyph {
    contents: notes24
  }
}

workspace = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .center},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  corner-smoothing: 0.5,
  children: [preview, timeline]
}

preview = frame {
  left: 0px,
  top: 0px,
  height: 60%,
  layout: {justify-content: .end, align-items: .end, item-gap: 2px},
  fill: Colors.colors.black20,
  children: [player, gallery]
}

player = videoPlayer.videoPlayer {
  left: -3772px,
  top: 0px,
  width: 60%,
  height: 100%,
  fill[0].image.ref: bird,
  fill[1].linear-gradient.stops[1].color: Colors.colors.black20,

  videoPlayer.controls.playbackControl.tools.likeButton.button.smallIconGlyph {
    contents: pen20
  }

  videoPlayer.controls.playbackControl.tools.settingsButton.button.smallIconGlyph {
    contents: pointer20
  }

  @use-variant(slider.thumb)
  videoPlayer.controls.playbackControl.scrubber.progressSlider {}

  videoPlayer.headerRow.eventHeader.header.smallSubtitle {
    contents: "4K landscape film, cinematic 21:9"
  }

  videoPlayer.headerRow.eventHeader.header.smallTitle {
    contents: "Wings of the Wild"
  }

  videoPlayer.headerRow.eventHeader {
    width: .auto
  }

  videoPlayer.headerRow.liveStatus {
    display: .hidden
  }
}

