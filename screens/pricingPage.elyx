import "tokens/colors.elyx" as colors
import "components/appTopBar.elyx" as appTopBar
import "blocks/planCard.elyx" as planCard
import "icons/24 pixels/dashboard.svg" as dashboard
import "icons/24 pixels/processor.svg" as processor
import "components/header.elyx" as header
import "images/background/whiteWave.jpg" as whiteWave

pricingPage = frame {
  name: "Pricing Page",
  left: 130.5px,
  top: 163px,
  width: 1415px,
  height: 925px,
  fill: {image: {ref: whiteWave}},
  children: [pricingCards, pricingHeader]
}

pricingCards = frame {
  name: "Pricing Cards",
  left: 125.5px,
  top: 202px,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.colors.whiteAlpha50,
  border: {color: colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha10,
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  filter: {type: .background-blur, radius: 40px},
  corner-radius: 24px,
  padding: 12px,
  children: [freePlan, proPlan, businessPlan]
}

freePlan = planCard.planCard {
  name: "Free Plan",
  left: 0px,
  top: 0px,
  width: 380px,
  height: 100%,
  fill[0].visible: .false,

  planCard.manageButton.button.mediumLabel {
    contents: "Register for free!"
  }

  planCard.manageButton {
    name: "Register Button"
  }

  planCard.planContent.planDetails.pricingCopy.priceRow.price {
    contents: "$0"
  }

  planCard.planContent.planSummary.planHeader {
    overrides: [remove(planCard.badge)]
  }
}

proPlan = planCard.planCard {
  name: "Pro Plan",
  left: 420px,
  top: 0.9999px,
  width: 380px,
  height: 498px,
  corner-radius: [20px, 0px, 0px, 20px],

  @use-variant(appTopBar.button.mediumPrimary)
  planCard.manageButton {}

  planCard.manageButton.button.mediumLabel {
    contents: "Get Started"
  }

  planCard.manageButton {
    name: "Get Started Button"
  }

  planCard.planContent.planDetails.features {
    overrides: [
      insert(proStorageFeature, after = planCard.storageFeature),
      insert(versionHistoryFeature, after = proStorageFeature)
    ]
  }

  planCard.planContent.planDetails.features.storageFeature.storageLabel {
    name: "Advanced Export Label",
    contents: "Advanced export options"
  }

  planCard.planContent.planDetails.features.storageFeature {
    name: "Advanced Export Feature"
  }

  planCard.planContent.planDetails.features.exportFeature.exportLabel {
    name: "Priority Support Label",
    contents: "Priority email support"
  }

  planCard.planContent.planDetails.features.exportFeature {
    name: "Priority Support Feature"
  }

  planCard.planContent.planDetails.features.supportFeature.supportLabel {
    name: "User Limit Label",
    contents: "Up to 5 users"
  }

  planCard.planContent.planDetails.features.supportFeature {
    name: "User Limit Feature"
  }

  planCard.planContent.planDetails.features.projectsFeature.projectsLabel {
    name: "Unlimited Projects Label",
    contents: "Unlimited projects"
  }

  planCard.planContent.planDetails.features.projectsFeature {
    name: "Unlimited Projects Feature"
  }

  planCard.planContent.planDetails.pricingCopy.description {
    name: "Pro Plan Description",
    contents: "Best option!\nFor professionals who need more room to work."
  }

  planCard.planContent.planSummary.planHeader.planName {
    name: "Pro Plan Name",
    contents: "Pro"
  }

  planCard.planContent.planSummary.planIcon.planGlyph {
    contents: dashboard,
    left: 6px,
    top: 33px
  }
}

businessPlan = planCard.planCard {
  name: "Business Plan",
  left: 840px,
  top: 0px,
  width: 380px,
  height: 100%,
  corner-radius: [0px, 20px, 20px, 0px],

  planCard.manageButton.button.mediumLabel {
    contents: "Contact sales"
  }

  planCard.manageButton {
    name: "Contact Sales Button"
  }

  planCard.planContent.planDetails.features {
    overrides: [
      insert(businessStorageFeature, after = planCard.storageFeature),
      insert(adminControlsFeature, after = businessStorageFeature)
    ]
  }

  planCard.planContent.planDetails.features.storageFeature.storageLabel {
    name: "Custom Integrations Label",
    contents: "Custom integrations"
  }

  planCard.planContent.planDetails.features.storageFeature {
    name: "Custom Integrations Feature"
  }

  planCard.planContent.planDetails.features.exportFeature.exportLabel {
    name: "Dedicated Support Label",
    contents: "Dedicated support"
  }

  planCard.planContent.planDetails.features.exportFeature {
    name: "Dedicated Support Feature"
  }

  planCard.planContent.planDetails.features.supportFeature.supportLabel {
    name: "Unlimited Users Label",
    contents: "Unlimited users"
  }

  planCard.planContent.planDetails.features.supportFeature {
    name: "Unlimited Users Feature"
  }

  planCard.planContent.planDetails.features.projectsFeature.projectsLabel {
    name: "Included Plan Label",
    contents: "Everything in Pro"
  }

  planCard.planContent.planDetails.features.projectsFeature {
    name: "Included Plan Feature"
  }

  planCard.planContent.planDetails.pricingCopy.description {
    name: "Business Plan Description",
    contents: "For companies.\nTeams that need scale and control."
  }

  planCard.planContent.planDetails.pricingCopy.priceRow.price {
    contents: "$29"
  }

  planCard.planContent.planSummary.planHeader {
    overrides: [remove(planCard.badge)]
  }

  planCard.planContent.planSummary.planHeader.planName {
    name: "Business Plan Name",
    contents: "Business"
  }

  planCard.planContent.planSummary.planIcon.planGlyph {
    contents: processor,
    left: 6px,
    top: 33px
  }
}

pricingHeader = header.mediumCenter {
  name: "Pricing Header",
  left: 472.5px,
  top: 121px,
  width: .auto,

  header.mediumSubtitle {
    contents: "Flexible pricing for individuals, professionals, and growing teams."
  }

  header.mediumTitle {
    contents: "Choose the plan that fits your work"
  }
}

businessStorageFeature = frame {
  name: "Storage Feature",
  left: 60px,
  top: 135px,
  layout: {align-items: .center, item-gap: 8px},
  children: [businessStorageBullet, businessStorageLabel]
}

businessStorageBullet = icon {
  name: "Feature Bullet",
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

businessStorageLabel = text {
  name: "Storage Feature Label",
  fill: colors.colors.black40,
  contents: "1 TB storage",
  font-size: planCard.Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

versionHistoryFeature = frame {
  name: "Version History Feature",
  left: 80px,
  top: 155px,
  layout: {align-items: .center, item-gap: 8px},
  children: [versionHistoryBullet, versionHistoryLabel]
}

versionHistoryBullet = icon {
  name: "Feature Bullet",
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

versionHistoryLabel = text {
  name: "Version History Label",
  fill: colors.colors.black40,
  contents: "Version history",
  font-size: planCard.Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

adminControlsFeature = frame {
  name: "Admin Controls Feature",
  left: 80px,
  top: 155px,
  layout: {align-items: .center, item-gap: 8px},
  children: [adminControlsBullet, adminControlsLabel]
}

adminControlsBullet = icon {
  name: "Feature Bullet",
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

adminControlsLabel = text {
  name: "Admin Controls Label",
  fill: colors.colors.black40,
  contents: "Admin controls and permissions",
  font-size: planCard.Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

proStorageFeature = frame {
  name: "Storage Feature",
  left: 60px,
  top: 135px,
  layout: {align-items: .center, item-gap: 8px},
  children: [proStorageBullet, proStorageLabel]
}

proStorageBullet = icon {
  name: "Feature Bullet",
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

proStorageLabel = text {
  name: "Storage Feature Label",
  fill: colors.colors.black40,
  contents: "100 GB storage",
  font-size: planCard.Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}
