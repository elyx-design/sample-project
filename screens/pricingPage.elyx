import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/colors.elyx" as colors
import "blocks/planCard.elyx" as planCard
import "tokens/radius.elyx" as Radius
import "icons/24 pixels/dashboard.svg" as dashboard
import "icons/24 pixels/processor.svg" as processor
import "components/header.elyx" as header
import "images/background/sea.jpg" as sea

export pricingPage = frame {
  left: 130.5px,
  top: 163px,
  width: 1415px,
  height: 925px,
  fill: {image: {ref: sea}},
  children: [pricingCards, pricingHeader]
}

pricingCards = frame {
  left: 125.5px,
  top: 202px,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.colors.whiteAlpha50,
  border: {color: colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha10,
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.xlarge,
  padding: Spacing.padding.medium,
  children: [freePlan, proPlan, businessPlan]
}

freePlan = planCard.planCard {
  left: 0px,
  top: 0px,
  width: 380px,
  height: 100%,
  fill[0].visible: .false,

  planCard.manageButton.button.mediumLabel {
    contents: Strings.pricingPage.freeRegistration
  }

  planCard.planContent.planDetails.pricingCopy.priceRow.price {
    contents: "$0"
  }

  planCard.planContent.planSummary.planHeader {
    overrides: [remove(planCard.badge)]
  }
}

proPlan = planCard.planCard {
  left: 420px,
  top: 0.9999px,
  width: 380px,
  height: 498px,
  corner-radius: [Radius.radius.large, 0px, 0px, Radius.radius.large],

  planCard.manageButton.button.mediumLabel {
    contents: Strings.actions.getStarted
  }

  planCard.planContent.planDetails.features {
    overrides: [
      insert(proStorageFeature, after = planCard.storageFeature),
      insert(versionHistoryFeature, after = proStorageFeature)
    ]
  }

  planCard.planContent.planDetails.features.storageFeature.storageLabel {
    contents: Strings.plans.advancedExport
  }

  planCard.planContent.planDetails.features.exportFeature.exportLabel {
    contents: Strings.plans.prioritySupport
  }

  planCard.planContent.planDetails.features.supportFeature.supportLabel {
    contents: Strings.plans.fiveUsers
  }

  planCard.planContent.planDetails.features.projectsFeature.projectsLabel {
    contents: Strings.plans.unlimitedProjects
  }

  planCard.planContent.planDetails.pricingCopy.description {
    contents: Strings.plans.proDescription
  }

  planCard.planContent.planSummary.planHeader.planName {
    contents: Strings.plans.pro
  }

  planCard.planContent.planSummary.planIcon.planGlyph {
    contents: dashboard,
    left: 6px,
    top: 33px
  }
}

businessPlan = planCard.planCard {
  left: 840px,
  top: 0px,
  width: 380px,
  height: 100%,
  corner-radius: [0px, Radius.radius.large, Radius.radius.large, 0px],

  planCard.manageButton.button.mediumLabel {
    contents: Strings.actions.contactSales
  }

  planCard.planContent.planDetails.features {
    overrides: [
      insert(businessStorageFeature, after = planCard.storageFeature),
      insert(adminControlsFeature, after = businessStorageFeature)
    ]
  }

  planCard.planContent.planDetails.features.storageFeature.storageLabel {
    contents: Strings.plans.customIntegrations
  }

  planCard.planContent.planDetails.features.exportFeature.exportLabel {
    contents: Strings.plans.dedicatedSupport
  }

  planCard.planContent.planDetails.features.supportFeature.supportLabel {
    contents: Strings.plans.unlimitedUsers
  }

  planCard.planContent.planDetails.features.projectsFeature.projectsLabel {
    contents: Strings.plans.everythingInPro
  }

  planCard.planContent.planDetails.pricingCopy.description {
    contents: Strings.plans.businessDescription
  }

  planCard.planContent.planDetails.pricingCopy.priceRow.price {
    contents: "$29"
  }

  planCard.planContent.planSummary.planHeader {
    overrides: [remove(planCard.badge)]
  }

  planCard.planContent.planSummary.planHeader.planName {
    contents: Strings.plans.business
  }

  planCard.planContent.planSummary.planIcon.planGlyph {
    contents: processor,
    left: 6px,
    top: 33px
  }
}

pricingHeader = header.mediumCenter {
  left: 472.5px,
  top: 121px,
  width: .auto,

  header.mediumSubtitle {
    contents: Strings.pricingPage.description
  }

  header.mediumTitle {
    contents: Strings.pricingPage.title
  }
}

businessStorageFeature = frame {
  left: 60px,
  top: 135px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [businessStorageBullet, businessStorageLabel]
}

businessStorageBullet = icon {
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

businessStorageLabel = text {
  fill: colors.colors.black40,
  contents: Strings.plans.oneTerabyteStorage,
  font-size: Spacing.fontSize.medium
}

versionHistoryFeature = frame {
  left: 80px,
  top: 155px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [versionHistoryBullet, versionHistoryLabel]
}

versionHistoryBullet = icon {
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

versionHistoryLabel = text {
  fill: colors.colors.black40,
  contents: Strings.plans.versionHistory,
  font-size: Spacing.fontSize.medium
}

adminControlsFeature = frame {
  left: 80px,
  top: 155px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [adminControlsBullet, adminControlsLabel]
}

adminControlsBullet = icon {
  left: 4px,
  top: 4px,
  width: 12px,
  height: 12px,
  contents: planCard.dot12
}

adminControlsLabel = text {
  fill: colors.colors.black40,
  contents: Strings.plans.adminControls,
  font-size: Spacing.fontSize.medium
}

proStorageFeature = frame {
  left: 60px,
  top: 135px,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [proStorageBullet, proStorageLabel]
}

proStorageBullet = icon {left: 4px, top: 4px, width: 12px, height: 12px, contents: planCard.dot12}

proStorageLabel = text {
  fill: colors.colors.black40,
  contents: Strings.plans.hundredGigabytesStorage,
  font-size: Spacing.fontSize.medium
}
