import "blocks/authForm.elyx" as AuthForm
import "tokens.elyx" as tokens
import "components/splashLogo.elyx" as splashLogo

project signIn_KSS9Sr9DMM = frame {
  name: "Sign In Screen",
  left: 80px,
  top: 80px,
  width: 1280px,
  height: 960px,
  layout: {direction: .column, justify-content: .center, align-items: .center, item-gap: 28},
  fill: tokens.color-background,
  children: [splashLogo_i, authPanel, footerLinks]
}

splashLogo_i = splashLogo.splashLogo_LCwhDG2 {left: 487.5px, top: 145.5px}

authPanel = AuthForm.authForm_3fiPvBqdA9 {left: 0px, top: 0px, width: 360px}

footerLinks = frame {
  name: "Footer Links",
  layout: {align-items: .center, item-gap: 18},
  children: [privacyLink, termsLink, helpLink]
}

privacyLink = text {
  name: "Privacy",
  fill: tokens.textColorDarkSecondary,
  contents: "Privacy",
  font-size: tokens.labelSizeM,
  font-family: "Inter",
  font-style: "Regular"
}

termsLink = text {
  name: "Terms",
  fill: tokens.textColorDarkSecondary,
  contents: "Terms",
  font-size: tokens.labelSizeM,
  font-family: "Inter",
  font-style: "Regular"
}

helpLink = text {
  name: "Help",
  fill: tokens.textColorDarkSecondary,
  contents: "Help",
  font-size: tokens.labelSizeM,
  font-family: "Inter",
  font-style: "Regular"
}
