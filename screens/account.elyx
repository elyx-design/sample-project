statTile = frame {
  name: "Stat Tile",
  left: 1500px,
  top: 80px,
  width: 100%,
  display: .hidden,
  layout: {direction: .column, item-gap: 5px},
  fill: rgb(96.58%, 96.58%, 96.58%),
  corner-radius: 12px,
  padding: 12px,
  children: [statValue, statLabel]
}

statValue = text {
  name: "Stat Value",
  fill: Colors.colors.black20,
  contents: "0",
  font-size: 18,
  font-family: "Inter",
  font-style: "SemiBold"
}

statLabel = text {
  name: "Stat Label",
  fill: Colors.colors.blackAlpha70,
  contents: "Label",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

featureRow = frame {
  name: "Feature Row",
  left: 1500px,
  top: 180px,
  display: .hidden,
  layout: {align-items: .center, item-gap: 8px},
  children: [featureDot, featureLabel]
}

featureDot = shape {
  name: "Feature Dot",
  width: 6px,
  height: 6px,
  fill: Colors.colors.blue,
  type: .ellipse
}

featureLabel = text {
  name: "Feature Label",
  fill: rgb(98.82%, 98.82%, 98.82%, 80%),
  contents: "Feature",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

usageMeter = frame {
  name: "Usage Meter",
  left: 1500px,
  top: 240px,
  width: 100%,
  display: .hidden,
  layout: {direction: .column, item-gap: 8px},
  children: [usageMeta, usageTrack]
}

usageMeta = frame {
  name: "Usage Meta",
  width: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: [usageLabel, usageValue]
}

usageLabel = text {
  name: "Usage Label",
  fill: Colors.colors.black20,
  contents: "Usage",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Medium"
}

usageValue = text {
  name: "Usage Value",
  fill: Colors.colors.blackAlpha70,
  contents: "0%",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

usageTrack = frame {
  name: "Usage Track",
  width: 100%,
  height: 8px,
  fill: rgb(89.84%, 89.84%, 89.84%),
  children: usageFill
}

usageFill = shape {
  name: "Usage Fill",
  width: 50%,
  height: 8px,
  fill: Colors.colors.blue,
  type: .rect
}

activityRow = frame {
  name: "Activity Row",
  left: 1500px,
  top: 320px,
  width: 100%,
  display: .hidden,
  layout: {item-gap: 10px},
  children: [activityDot, activityCopy]
}

activityDot = shape {
