statTile = frame {
  name: "Stat Tile",
  left: 1500px,
  top: 80px,
  width: 100%,
  display: .hidden,
  layout: {direction: .column, item-gap: 5px},
  fill: rgb(96.58%, 96.58%, 96.58%),
  corner-radius: 12px,
  padding: 12px,
  children: [statValue, statLabel]
}

statValue = text {
  name: "Stat Value",
  fill: Colors.colors.black20,
  contents: "0",
  font-size: 18,
  font-family: "Inter",
  font-style: "SemiBold"
}

statLabel = text {
  name: "Stat Label",
  fill: Colors.colors.blackAlpha70,
  contents: "Label",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

featureRow = frame {
