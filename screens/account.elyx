import "../tokens.elyx" as tokens
import "../blocks/settingsCard.elyx" as SettingsCard
import "../components/header.elyx" as header
import "../blocks/toastStack.elyx" as ToastStack
import "../blocks/alertBanner.elyx" as alertBanner
import "../components/pageTabs.elyx" as pageTabs2
import "../blocks/profileCard.elyx" as profileCard
import "../blocks/securityCard.elyx" as securityCard
import "../blocks/sidebar.elyx" as sidebar2
import "../blocks/planCard.elyx" as planCard2
import "../blocks/usageCard.elyx" as usageCard2
import "../blocks/activityCard.elyx" as activityCard2

pub account = frame {
  name: "Account Screen",
  left: 80px,
  top: 80px,
  width: 1280px,
  height: 960px,
  layout: {direction: .row},
  fill: oklch(97.2%, 0.006, 247.8966deg),
  children: [sidebar, contentShell]
}

sidebar = sidebar2.sidebar_QjenIug {left: 0px, top: 0px, overrides: [set("width", 20%), set("height", 100%)]}

contentShell = frame {
  name: "Content Shell",
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 20},
  padding: [36px, 40px],
  children: [topBar, layer_d, mainGrid, toastPreview]
}

topBar = frame {
  name: "Top Bar",
  width: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: layer
}

layer = header.header_Pp67Y8c {
  left: 0px,
  top: 52px,
  overrides: [
    set(
      header.Description_7ZfScLC,
      "contents",
      "Manage profile details, workspace access, billing, and security settings."
    ),
    set(header.Title_ZIlZq9y, "contents", "Account"),
    set(header.Title_ZIlZq9y, "font-size", 24)
  ]
}

layer_d = pageTabs2.pageTabs_e60eQaG {left: 426px, top: 158px}

mainGrid = frame {
  name: "Main Grid",
  width: 100%,
  layout: {item-gap: 20},
  overflow: .visible,
  children: [primaryColumn, secondaryColumn]
}

primaryColumn = frame {
  name: "Primary Column",
  width: 100%,
  layout: {direction: .column, item-gap: 20},
  overflow: .visible,
  children: [profileCard_G, layer_f, securityCard_F]
}

profileCard_G = profileCard.profileCard_vlvneaI {left: 0px, top: 0px}

layer_f = SettingsCard.cardBackground_W {left: 0px, top: 216px}

securityCard_F = securityCard.securityCard_HT5T2Qj {left: 0px, top: 263px}

secondaryColumn = frame {
  name: "Secondary Column",
  width: 33%,
  layout: {direction: .column, item-gap: 20},
  overflow: .visible,
  children: [planCard, usageCard, activityCard]
}

planCard = planCard2.planCard_E_82fNw {left: 0px, top: 0px}

usageCard = usageCard2.usageCard_G_YRf95 {left: 0px, top: 238px}

activityCard = activityCard2.activityCard_Qrr8IWU {left: 0px, top: 433px}

toastPreview = ToastStack.toastStack {
  right: 24px,
  bottom: 24px,
  overrides: [
    remove(ToastStack.AlertBanner_a),
    set("width", 400px),
    set("ignore-stack", .true),
    remove(ToastStack.layer, alertBanner.closeButton)
  ]
}

statTile = frame {
  name: "Stat Tile",
  left: 1500px,
  top: 80px,
  width: 100%,
  layout: {direction: .column, item-gap: 5},
  visible: .false,
  corner-radius: 12px,
  padding: 12px,
  fill: oklch(97.4%, 0, 0deg),
  children: [statValue, statLabel]
}

statValue = text {
  name: "Stat Value",
  contents: "0",
  font-family: "Inter Variable",
  font-size: 18,
  font-style: "SemiBold",
  line-height: 0,
  letter-spacing: 0,
  fill: tokens.textColorDark
}

statLabel = text {
  name: "Stat Label",
  contents: "Label",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeM,
  font-style: "Regular",
  line-height: 0,
  letter-spacing: 0,
  fill: tokens.textColorDarkSecondary
}

featureRow = frame {
  name: "Feature Row",
  left: 1500px,
  top: 180px,
  layout: {align-items: .center, item-gap: 8},
  visible: .false,
  children: [featureDot, featureLabel]
}

featureDot = shape {name: "Feature Dot", width: 6px, height: 6px, type: .ellipse, fill: tokens.colorPrimary}

featureLabel = text {
  name: "Feature Label",
  contents: "Feature",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeM,
  font-style: "Regular",
  line-height: 0,
  letter-spacing: 0,
  fill: tokens.textColorLightSecondary
}

usageMeter = frame {
  name: "Usage Meter",
  left: 1500px,
  top: 240px,
  width: 100%,
  layout: {direction: .column, item-gap: 8},
  visible: .false,
  children: [usageMeta, usageTrack]
}

usageMeta = frame {
  name: "Usage Meta",
  width: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: [usageLabel, usageValue]
}

usageLabel = text {
  name: "Usage Label",
  contents: "Usage",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeM,
  font-style: "Medium",
  line-height: 0,
  letter-spacing: 0,
  fill: tokens.textColorDark
}

usageValue = text {
  name: "Usage Value",
  contents: "0%",
  font-family: "Inter Variable",
  font-size: tokens.labelSizeM,
  font-style: "Regular",
  line-height: 0,
  letter-spacing: 0,
