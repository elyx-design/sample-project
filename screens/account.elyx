  left: 1500px,
  top: 180px,
  display: .hidden,
  layout: {align-items: .center, item-gap: 8px},
  children: [featureDot, featureLabel]
}

featureDot = shape {
  name: "Feature Dot",
  width: 6px,
  height: 6px,
  fill: Colors.colors.blue,
  type: .ellipse
}

featureLabel = text {
  name: "Feature Label",
