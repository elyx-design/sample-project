usageFill = shape {
  name: "Usage Fill",
  width: 50%,
  height: 8px,
  corner-radius: tokens.boderRadiusMax,
  type: .rect,
  fill: tokens.colorPrimary
}

activityRow = frame {
  name: "Activity Row",
  left: 1500px,
  top: 320px,
  width: 100%,
