import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "design/blocks/playbackControl.elyx" as playbackControl
import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors
import "images/background/liveEvent.jpg" as liveEvent
import "design/blocks/header.elyx" as header
import "design/controls/tag.elyx" as tag

export videoPlayer = frame {
  left: 368px,
  top: 405px,
  width: 643px,
  height: 420px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: liveEvent}},
    {
      linear-gradient: {
        from: point(50%, 70.4884%),
        to: point(50%, 100%),
        stops: [stop(0%, .transparent), stop(100%, rgb(0%, 0%, 0%, 50%))]
      }
    },
    {
      linear-gradient: {
        from: point(50%, 0%),
        to: point(50%, 24.4%),
        stops: [stop(0%, rgb(0%, 0%, 0%, 50%)), stop(97.76%, .transparent)]
      }
    }
  ],
  corner-radius: radius.radius.small,
  corner-smoothing: radius.radius.smoothing,
  padding: Spacing.padding.xlarge,
  children: [headerRow, controls],

  controls = frame : playbackControl.playbackControl {
    left: 0px,
    top: 809px,
    width: 100%,

    playbackControl.tools {
      playbackControl.tools.moreButton {
        playbackControl.button.smallIcon.smallIconGlyph {
          fill[0].color: colors.primitives.white70
        }
      }

      playbackControl.tools.likeButton {
        playbackControl.button.smallIcon.smallIconGlyph {
          fill[0].color: colors.primitives.white70
        }
      }

      playbackControl.tools.settingsButton {
        playbackControl.button.smallIcon.smallIconGlyph {
          fill[0].color: colors.primitives.white70
        }
      }
    }

    playbackControl.playbackControl.playbackTime {
      fill[0].color: colors.primitives.white70,
      contents: "12:59 / 32:46"
    }

    playbackControl.scrubber {
      playbackControl.scrubber.progressSlider {
        playbackControl.slider.slider.track {
          fill[0].color: colors.primitives.white
        }
      }

      playbackControl.scrubber.playButton {
        playbackControl.button.smallIcon.smallIconGlyph {
          fill[0].color: colors.primitives.white70
        }
      }
    }
  }
}

headerRow = frame {
  width: 100%,
  layout: {justify-content: .space-between},
  children: [eventHeader, liveStatus],

  eventHeader = frame : header.smallLeft {
    left: 0px,
    top: 250px,

    header.smallLeft.smallSubtitle {
      fill[0].color: colors.primitives.white70,
      contents: "Live from the dunes: Stage 3"
    }

    header.smallLeft.smallTitle {
      fill[0].color: colors.primitives.white,
      contents: "Endless Dunes"
    }
  }

  liveStatus = frame : tag.status {
    left: 806px,
    top: 450px,
    fill[0].color: rgb(100%, 0%, 0%, 60%),

    tag.tagTransparent.label {
      fill[0].color: colors.primitives.white,
      contents: Strings.status.live
    }

    tag.status.statusIcon {
      fill[0].color: colors.primitives.white
    }
  }
}
