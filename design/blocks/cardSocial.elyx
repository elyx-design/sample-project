import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "design/controls/cardBackground.elyx" as cardBackground
import "tokens/radius.elyx" as Radius
import "tokens/colors.elyx" as colors
import "design/controls/button.elyx" as button
import "design/blocks/userSummary.elyx" as userSummary
import "images/background/dots.jpg" as dots
import "design/blocks/avatarGroup.elyx" as avatarGroup
import "icons/20 pixels/heart-20.svg" as heart20
import "icons/20 pixels/star-20.svg" as star20

export socialCard = frame : cardBackground.transparent {
  left: 186px,
  top: 176px,
  width: 317px,
  height: 427px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .center,
  layout.item-gap: Spacing.gap.large,
  layout.justify-content: .space-between,
  overrides: [insert(cardContent, after = .nil), insert(socialFooter, after = cardContent)],

  cardContent = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, align-items: .end, item-gap: Spacing.gap.xxlarge},
    fill: {visible: .false, image: {ref: dots}},
    border: {
      color: colors.primitives.blackAlpha10,
      visible: .false,
      width: 0.5px,
      position: .outside
    },
    corner-radius: Radius.radius.medium,
    padding: Spacing.padding.xxlarge,
    children: [cardActions, profileInfo]
  }
}

socialFooter = frame {
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [followerAvatars, followButton],

  followerAvatars = frame : avatarGroup.avatarGroup {left: 20px, top: 383px}

  followButton = frame : button.mediumPrimary {
    left: 151.5px,
    top: 160px,

    button.medium.mediumLabel {
      contents: Strings.actions.follow
    }
  }
}

cardActions = frame {
  width: .auto,
  layout: {justify-content: .end, align-items: .end, item-gap: Spacing.gap.small},
  slot: .true,
  children: [favoriteButton, likeButton, closeButton],

  favoriteButton = frame : button.smallIcon {
    left: 245.81px,
    top: 37.5995px,

    button.smallIcon.smallIconGlyph {
      contents: star20
    }
  }

  likeButton = frame : button.smallIcon {
    left: 265.81px,
    top: 57.5995px,

    button.smallIcon.smallIconGlyph {
      contents: heart20
    }
  }

  closeButton = frame : button.smallClose {
    left: 526px,
    top: 225px,
    fill[0].color: colors.primitives.blackAlpha10
  }
}

profileInfo = frame {
  width: 100%,
  height: 100%,
  layout: {
    direction: .column,
    justify-content: .space-between,
    align-items: .center,
    item-gap: Spacing.gap.huge
  },
  children: [profileSummary, profileStats],

  profileStats = frame {
    width: 100%,
    layout: {justify-content: .space-evenly, align-items: .center, item-gap: Spacing.gap.xxlarge},
    children: [followingStat, followersStat, postsStat]
  }
}

profileSummary = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.large},
  overflow: .visible,
  children: [profileIdentity, bio],

  profileIdentity = frame : userSummary.UserSummaryMVariant {
    left: 0px,
    top: 160px,
    width: 100%,

    userSummary.medium.mediumHeader {
      userSummary.header.mediumLeft.mediumSubtitle {
        contents: "@noraharper"
      }
    }
  }

  bio = text {
    left: 0px,
    top: 160px,
    width: 100%,
    fill: colors.theme.contrastAlpha70,
    contents: "I love good coffee, long conversations, and finding beauty in the little things.",
    font-size: Typography.fontSize.small,
    line-height: Typography.lineHeight.relaxed,
    align: .center
  }
}

followingStat = frame {
  left: 49px,
  top: 367px,
  layout: {direction: .column, justify-content: .center, align-items: .center, item-gap: 3px},
  children: [followingCount, followingLabel],

  followingCount = text {
    left: 16.5px,
    top: 0px,
    fill: colors.theme.contrastStrongest,
    contents: "169",
    font-size: Typography.fontSize.large,
    font-style: "Bold",
    align: .center
  }

  followingLabel = text {
    left: 0px,
    top: 18px,
    fill: colors.theme.contrastStrongest,
    contents: Strings.labels.following,
    font-size: Typography.fontSize.small,
    align: .center
  }
}

followersStat = frame {
  left: 69px,
  top: 387px,
  layout: {direction: .column, justify-content: .center, align-items: .center, item-gap: 3px},
  children: [followerCount, followersLabel],

  followerCount = text {
    left: 16.5px,
    top: 0px,
    fill: colors.theme.contrastStrongest,
    contents: "18k",
    font-size: Typography.fontSize.large,
    font-style: "Bold",
    align: .center
  }

  followersLabel = text {
    left: 0px,
    top: 18px,
    fill: colors.theme.contrastStrongest,
    contents: Strings.labels.followers,
    font-size: Typography.fontSize.small,
    align: .center
  }
}

postsStat = frame {
  left: 89px,
  top: 407px,
  layout: {direction: .column, justify-content: .center, align-items: .center, item-gap: 3px},
  children: [postCount, postsLabel],

  postCount = text {
    left: 16.5px,
    top: 0px,
    fill: colors.theme.contrastStrongest,
    contents: "1.2k",
    font-size: Typography.fontSize.large,
    font-style: "Bold",
    align: .center
  }

  postsLabel = text {
    left: 0px,
    top: 18px,
    fill: colors.theme.contrastStrongest,
    contents: Strings.labels.posts,
    font-size: Typography.fontSize.small,
    align: .center
  }
}
