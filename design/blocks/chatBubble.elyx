import "tokens/strings.elyx" as Strings
import "design/controls/avatar.elyx" as avatar
import "tokens/spacing.elyx" as spacing
import "tokens/typography.elyx" as typography
import "tokens/colors.elyx" as colors
import "tokens/radius.elyx" as radius
import "images/profileImgs/005.jpg" as module
import "images/profileImgs/001.jpg" as module4

export chatBubble = frame {
  left: 602px,
  top: 476px,
  layout: {align-items: .center, item-gap: spacing.gap.small},
  overflow: .visible,
  children: [profileAvatar, message],

  profileAvatar = frame : avatar.smallPhoto {
    left: 0px,
    top: 0px,

    avatar.smallPhoto.smallImage {
      fill[0].image.ref: module4
    }

    avatar.small.smallStatus {
      display: .hidden
    }
  }
}

@variant
user = frame : chatBubble {
  left: 602px,
  top: 560px,
  layout.justify-content: .end,
  overrides: [move(message, after = .nil)],

  chatBubble.profileAvatar {
    avatar.smallPhoto.smallImage {
      fill[0].image.ref: module
    }
  }

  message {
    fill[0].color: colors.theme.contrastStrongest,

    message.messageText {
      fill[0].color: colors.theme.base
    }
  }
}

@variant
liveBubble = frame : chatBubble {
  left: 602px,
  top: 644px,
  layout.align-items: .start,
  layout.direction: .column,
  layout.item-gap: spacing.gap.xsmall,
  overrides: [
    insert(GroupedStack, after = .nil),
    insert(messageText_2, after = GroupedStack),
    remove(message),
    remove(chatBubble.profileAvatar)
  ],

  messageText_2 = text {
    left: 0px,
    top: 30.5px,
    width: 100%,
    fill: colors.theme.contrastStrongest,
    contents: Strings.componentDefaults.chatText,
    font-size: typography.fontSize.small
  }
}

GroupedStack = frame {
  width: 100%,
  layout: {align-items: .end, item-gap: spacing.gap.small},
  overflow: .visible,
  children: [messageText_3, messageText_4],

  messageText_3 = text {
    left: 0px,
    top: 5.5px,
    fill: colors.theme.contrastStrongest,
    contents: Strings.componentDefaults.name,
    font-style: "Bold"
  }

  messageText_4 = text {
    left: 20px,
    top: 25.5px,
    fill: colors.theme.contrastAlpha25,
    contents: "14:15",
    font-size: typography.fontSize.small,
    font-style: "Medium"
  }
}

message = frame {
  left: 65px,
  top: 0px,
  width: .auto,
  height: spacing.size.medium,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.theme.contrastAlpha08,
  corner-radius: radius.radius.full,
  padding-left: spacing.padding.medium,
  padding-right: spacing.padding.medium,
  children: messageText,

  messageText = text {
    left: 0px,
    top: 0px,
    fill: .black,
    contents: Strings.componentDefaults.chatText
  }
}
