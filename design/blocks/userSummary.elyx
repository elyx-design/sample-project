import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "design/controls/avatar.elyx" as userAvatar
import "design/blocks/header.elyx" as header

export small = frame {
  left: 558px,
  top: 0px,
  height: Spacing.size.medium,
  layout: {align-items: .center, item-gap: Spacing.gap.medium},
  overflow: .visible,
  children: [smallAvatar, smallHeader],

  smallAvatar = frame : userAvatar.smallPhoto {
    left: -7.5px,
    top: 28px
  }

  smallHeader = frame : header.smallLeft {
    left: -8.5px,
    top: -18px,

    smallSubtitle {
      contents: "nora@mail.com"
    }

    smallTitle {
      contents: "Nora Harper",
      font-style: "Bold"
    }
  }
}

@variant
UserSummarySVariant = frame : small {
  left: 558px,
  top: 192px,
  height: .auto,
  layout.direction: .column,

  @with-variant(header.smallCenter)
  smallHeader {}
}

export medium = frame {
  left: 229px,
  top: 0px,
  height: 72px,
  layout: {
    justify-content: .end,
    align-items: .center,
    item-gap: Spacing.gap.xlarge
  },
  overflow: .visible,
  children: [mediumAvatar, mediumHeader],

  mediumAvatar = frame : userAvatar.mediumPhoto {
    left: 0px,
    top: 0px
  }

  mediumHeader = frame : header.mediumLeft {
    left: 83px,
    top: 10px,

    mediumSubtitle {
      contents: "nora@mail.com",
      font-size: Typography.fontSize.xlarge
    }

    mediumTitle {
      contents: "Nora Harper",
      font-size: Typography.fontSize.xxxlarge,
      font-style: "Bold"
    }
  }
}

@variant
UserSummaryMVariant = frame : medium {
  left: 229px,
  top: 192px,
  height: .auto,
  layout.direction: .column,

  @with-variant(header.mediumCenter)
  mediumHeader {}
}
