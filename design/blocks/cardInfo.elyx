import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "design/controls/cardBackground.elyx" as cardBackground
import "tokens/colors.elyx" as colors
import "design/blocks/header.elyx" as header
import "images/background/nightMountain.jpg" as nightMountain
import "design/controls/avatar.elyx" as avatar
import "design/controls/tag.elyx" as tag
import "design/controls/button.elyx" as button

export reviewCard = frame : cardBackground.cardBackground {
  left: 693px,
  top: 267px,
  width: 370px,
  height: 470px,
  border[0].color: colors.primitives.black25,
  fill[0].image.ref: nightMountain,
  layout.item-gap: Spacing.gap.xlarge,
  layout.justify-content: .space-between,
  overrides: [
    insert(reviewAuthor, after = .nil),
    insert(reviewFooter, after = reviewAuthor)
  ]
}

reviewFooter = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.huge},
  overflow: .visible,
  children: [reviewInfo, readReviewButton],

  readReviewButton = frame : button.medium {
    left: 0px,
    top: 165px,

    button.medium.mediumLabel {
      contents: Strings.actions.readFullReview
    }
  }
}

reviewInfo = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.large},
  overflow: .visible,
  children: [reviewHeader, tags],

  reviewHeader = frame : header.mediumLeft {
    left: 768px,
    top: 512px,

    header.mediumLeft.mediumSubtitle {
      fill[0].color: colors.primitives.white70,
      contents: "Stunning mountain scenery and a story full of heart. This one leaves you calm, inspired, and ready for your next adventure."
    }

    header.mediumLeft.mediumTitle {
      fill[0].color: colors.primitives.white,
      contents: "A Breathtaking Escape"
    }
  }
}

tags = frame {
  width: 100%,
  layout: {item-gap: Spacing.gap.small},
  overflow: .visible,
  slot: .true,
  children: [ratingTag, thrillerTag, dramaTag],

  ratingTag = frame : tag.iconAndLabel {
    left: 765px,
    top: 726px,
    overflow: .visible,

    tag.tagTransparent.label {
      contents: "4.2",
      fill[0].color: colors.primitives.white
    }

    tag.iconAndLabel.tagIcon {
      fill[0].color: colors.primitives.white
    }
  }

  thrillerTag = frame : tag.tagTransparent {
    left: 785px,
    top: 746px,

    tag.tagTransparent.label {
      fill[0].color: colors.primitives.white,
      contents: "Thriller"
    }
  }

  dramaTag = frame : tag.tagTransparent {
    left: 785px,
    top: 827.25px,

    tag.tagTransparent.label {
      fill[0].color: colors.primitives.white,
      contents: "Drama"
    }
  }
}

reviewAuthor = frame {
  width: 100%,
  layout: {justify-content: .space-between, item-gap: Spacing.gap.xlarge},
  overflow: .visible,
  children: [small, closeButton],

  small = frame : avatar.smallPhoto {
    left: 786px,
    top: 143px,

    avatar.small.smallStatus {
      display: .hidden
    }
  }

  closeButton = frame : button.smallClose {
    left: 1097px,
    top: 291px
  }
}
