import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/colors.elyx" as colors
import "images/thumbnails/thumb01.jpg" as thumb01
import "icons/20 pixels/heart-20.svg" as heart20
import "icons/20 pixels/play-20.svg" as play20
import "design/controls/tag.elyx" as tag

export thumbnailImage = frame {
  left: 555px,
  top: 395px,
  width: 160px,
  height: 120px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: thumb01}},
    {
      linear-gradient: {
        from: point(50%, 50%),
        to: point(50%, 90.21%),
        stops: [
          stop(0%, rgb(8.6275%, 8.6275%, 8.6275%, 0%)),
          stop(100%, colors.gradients.overlayEnd)
        ]
      }
    }
  ],
  padding: Spacing.padding.medium,
  children: [actions, imageName],

  imageName = text {
    left: 0px,
    top: 197px,
    width: 100%,
    fill: rgb(100%, 100%, 100%, 70%),
    contents: Strings.componentDefaults.imageName,
    font-size: Typography.fontSize.small
  }
}

actions = frame {
  left: 0px,
  top: 12px,
  width: 100%,
  layout: {justify-content: .end, align-items: .center},
  children: favoriteIcon,

  favoriteIcon = icon {
    left: 0px,
    top: 0px,
    width: 20px,
    height: 20px,
    fill: rgb(100%, 100%, 100%, 70%),
    contents: heart20
  }
}

@variant
thumbnailVideo = frame : thumbnailImage {
  left: 555px,
  top: 563px,
  layout.align-items: .center,
  layout.justify-content: .center,
  overrides: [insert(base, after = .nil), remove(thumbnailImage.imageName), remove(actions)],

  base = frame : tag.iconAndLabel {
    left: 63px,
    top: 50px,

    tag.iconAndLabel.tagIcon {
      contents: play20
    }

    tag.tagTransparent.label {
      contents: Strings.actions.watchTrailer
    }
  }
}
