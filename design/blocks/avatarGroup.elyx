baseStack = frame {
  left: 0px,
  top: 0px,
  width: 140px,
  height: Spacing.size.medium,
  overflow: .visible,
  children: [
    baseFifthPhoto,
    baseFourthPhoto,
    baseThirdPhoto,
    baseSecondPhoto,
    baseFirstPhoto
  ],

  baseFifthPhoto = frame : userAvatar.smallPhoto {
    left: 104px,
    top: 0px,
    ignore-stack: .true,

    smallImage {
      fill[0].image.ref: module8
    }

    smallStatus {
      display: .hidden
    }
  }

  baseFourthPhoto = frame : userAvatar.smallPhoto {
