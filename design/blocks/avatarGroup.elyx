@variant
labelRight = frame : avatarGroup {
  left: 484px,
  top: 595px,
  width: .auto,
  layout.item-gap: Spacing.gap.small,
  overrides: [
    insert(rightStack, after = .nil),
    insert(rightCount, after = rightStack),
    remove(baseStack)
  ]
}

