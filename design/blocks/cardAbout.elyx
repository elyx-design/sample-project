import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "design/controls/cardBackground.elyx" as cardBackground
import "tokens/radius.elyx" as Radius
import "tokens/colors.elyx" as colors
import "design/blocks/header.elyx" as header
import "design/blocks/stats.elyx" as stats

export profileCard = frame : cardBackground.transparent {
  left: 0px,
  top: 0px,
  width: 519px,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  border[0].color: colors.primitives.black25,
  fill[0].color: colors.palette.yellowAlpha50,
  layout.item-gap: 0,
  overrides: [insert(content, after = .nil), insert(profileStats, after = content)],

  profileStats = frame : stats.stats {
    left: 0px,
    top: 157px,
    padding-top: Spacing.padding.xlarge,
    padding-left: Spacing.padding.xxlarge,
    padding-bottom: Spacing.padding.xlarge,
    padding-right: Spacing.padding.xxlarge,
    overrides: [remove(stats.stats.bottomDivider), remove(stats.stats.topDivider)],

    stats.row {
      stats.row.ratingDivider {
        top: 0px
      }

      stats.row.pagesDivider {
        top: 0px
      }

      stats.row.booksDivider {
        top: 0px
      }
    }
  }
}

content = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.large},
  fill: colors.theme.base,
  corner-radius: [0px, 0px, Radius.radius.xlarge, Radius.radius.xlarge],
  padding: Spacing.padding.xxlarge,
  children: [profileHeader, bio],

  bio = text {
    left: 0px,
    top: 0px,
    width: 100%,
    fill: colors.theme.contrastAlpha70,
    contents: "Nora Harper is a lifestyle content creator with a warm, thoughtful eye for everyday moments. With 18k followers, she has built a community around simple, authentic experiences: specialty coffee, long conversations, and finding beauty in small things.\n\nHer content carries a cozy, intimate tone that celebrates slowing down and appreciating daily life. Active and engaged, she posts regularly to a loyal audience that connects with her warm, reflective outlook.",
    line-height: Typography.lineHeight.relaxed
  }
}

profileHeader = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: profileTitle,

  profileTitle = frame : header.mediumLeft {
    left: 56px,
    top: 2px,
    overrides: [remove(header.mediumLeft.mediumSubtitle)],

    header.mediumLeft.mediumTitle {
      contents: Strings.labels.publicProfile
    }
  }
}
