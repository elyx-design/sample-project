import "tokens/strings.elyx" as Strings
import "design/controls/avatar.elyx" as avatar
import "tokens/colors.elyx" as colors
import "design/blocks/header.elyx" as header
import "icons/24 pixels/chevron-upDown-24.svg" as chevronupDown24

export Selector = frame {
  left: 268px,
  top: 443px,
  layout: {justify-content: .space-between, align-items: .center, item-gap: 15px},
  overflow: .visible,
  children: [Left, shape1],

  shape1 = icon {
    left: 26px,
    top: 8px,
    width: 24px,
    height: 24px,
    fill: colors.theme.contrastStrongest,
    contents: chevronupDown24
  }
}

Left = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 15px},
  overflow: .visible,
  children: [small, smallLeft],

  small = frame : avatar.smallPhoto {left: 0px, top: 2px}

  smallLeft = frame : header.smallLeft {
    left: 51px,
    top: 0px,

    header.smallLeft.smallSubtitle {
      contents: Strings.labels.manager
    }

    header.smallLeft.smallTitle {
      contents: "Nora"
    }
  }
}
