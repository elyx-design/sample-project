export sidebar = frame : cardBackground.transparent {
  left: -123px,
  top: 0px,
  width: .auto,
  height: 645px,
  padding-top: Spacing.padding.xsmall,
  padding-left: 0px,
  padding-bottom: Spacing.padding.small,
  padding-right: 0px,
  layout.align-items: .center,
  layout.item-gap: Spacing.gap.large,
  layout.justify-content: .space-between,
  overrides: [
    insert(sidebarBody, after = .nil),
    insert(workspaceSelector, after = sidebarBody)
  ]
}

