import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/colors.elyx" as Colors

export mediumLeft = frame {
  left: 524px,
  top: 20px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: Spacing.gap.xxsmall},
  children: [mediumTitle, mediumSubtitle],

  mediumTitle = text {
    width: 100%,
    fill: Colors.theme.contrastStrongest,
    contents: Strings.componentDefaults.title,
    font-size: Typography.fontSize.xxlarge,
    font-style: "SemiBold"
  }

  mediumSubtitle = text {
    width: 100%,
    fill: Colors.theme.contrastAlpha70,
    contents: Strings.componentDefaults.subtitle,
    font-size: Typography.fontSize.medium,
    font-style: "Medium",
    line-height: Typography.lineHeight.relaxed
  }
}

@variant
mediumCenter = frame : mediumLeft {
  left: 524px,
  top: 166px,
  layout.align-items: .center,

  mediumLeft.mediumSubtitle {
    align: .center
  }

  mediumLeft.mediumTitle {
    align: .center
  }
}

