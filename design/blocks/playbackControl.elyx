import "design/controls/cardBackground.elyx" as cardBackground
import "tokens/spacing.elyx" as spacing
import "tokens/colors.elyx" as colors
import "tokens/typography.elyx" as typography
import "design/controls/slider.elyx" as slider
import "design/controls/button.elyx" as button
import "icons/20 pixels/play-20.svg" as play20
import "icons/20 pixels/more-20.svg" as more20
import "icons/20 pixels/heart-20.svg" as heart20
import "icons/20 pixels/settings-20.svg" as settings20

export playbackControl = frame : cardBackground.none {
  left: 669px,
  top: 522px,
  width: 359px,
  height: spacing.size.small,
  min-height: .nil,
  padding-top: 0px,
  padding-left: 0px,
  padding-bottom: 0px,
  padding-right: 0px,
  layout.align-items: .center,
  layout.direction: .row,
  layout.item-gap: spacing.gap.medium,
  overrides: [
    insert(scrubber, after = .nil),
    insert(playbackTime, after = scrubber),
    insert(tools, after = playbackTime)
  ],

  playbackTime = text {
    left: 722px,
    top: 543px,
    fill: colors.theme.contrastStrongest,
    contents: "0:00 / 32:46",
    font-size: typography.fontSize.small,
    font-style: "Medium"
  }
}

tools = frame {
  height: 100%,
  layout: {align-items: .center},
  slot: .true,
  children: [settingsButton, likeButton, moreButton],

  settingsButton = frame : button.smallIcon {
    left: 264.5px,
    top: 8.5px,

    button.smallIcon.smallIconGlyph {
      contents: settings20
    }
  }

  likeButton = frame : button.smallIcon {
    left: 284.5px,
    top: 28.5px,

    button.smallIcon.smallIconGlyph {
      contents: heart20
    }
  }

  moreButton = frame : button.smallIcon {
    left: 284.5px,
    top: 28.5px,

    button.smallIcon.smallIconGlyph {
      contents: more20
    }
  }
}

scrubber = frame {
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: spacing.gap.xxsmall},
  children: [playButton, progressSlider],

  playButton = frame : button.smallIcon {
    left: 737px,
    top: 580px,

    button.smallIcon.smallIconGlyph {
      contents: play20
    }
  }

  progressSlider = frame : slider.slider {
    left: 0px,
    top: 636px,
    width: 100%
  }
}
