import "design/screens/signIn.elyx" as signIn
import "design/screens/AIchat.elyx" as AIchat
import "design/screens/LandingPage.elyx" as LandingPage
import "design/screens/footer.elyx" as footerPage
import "design/screens/pricingPage.elyx" as pricingPage

@draw-connections
__canvas__

signInScreen = frame : signIn.signInScreen {
  left: 1800px,
  top: 1000px,
}

chat = frame : AIchat.AIChat {
  left: 1800px,
  top: 2000px,
}

landing = frame : LandingPage.LandingPage {
  left: 0px,
  top: 1000px
}

pricing = frame : pricingPage.pricingPage {
  left: 1800px,
  top: 0px,
}

footer = frame : footerPage.Footer {
  left: 0px,
  top: 2000px
}
