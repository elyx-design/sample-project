import "design/screens/signIn.elyx" as signInFile
import "design/screens/AIchat.elyx" as AIchat
import "design/screens/LandingPage.elyx" as landingFile
import "design/screens/footer.elyx" as footerFile
import "design/screens/pricingPage.elyx" as pricingFile

@draw-connections
__canvas__

signIn = frame : signInFile.signInScreen {
  left: 1800px,
  top: 1000px,
}

chat = frame : AIchat.AIChat {
  left: 1800px,
  top: 2000px,
}

landing = frame : landingFile.LandingPage {
  left: 0px,
  top: 1000px
}

pricing = frame : pricingFile.pricingPage {
  left: 1800px,
  top: 0px,
}

footer = frame : footerFile.Footer {
  left: 0px,
  top: 2000px
}
