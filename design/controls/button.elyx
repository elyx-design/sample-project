export medium = frame {
  left: 962px,
  top: 689px,
  height: Spacing.size.medium,
  layout: {justify-content: .center, align-items: .center},
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [
        stop(2.58%, Colors.gradients.surfaceTop),
        stop(100%, Colors.gradients.surfaceBottom)
      ]
    }
  },
  border: {color: Colors.theme.contrastAlpha25, width: 0.5px},
  shadow: {
    drop-shadow: {
      color: Colors.primitives.blackAlpha05,
      offset: point(0px, 1px),
      blur-radius: 1px,
      spread: 0px,
      style: .smooth
    }
  },
  corner-radius: Radius.radius.full,
  padding-left: Spacing.padding.large,
  padding-right: Spacing.padding.large,
  children: mediumLabel,

  mediumLabel = text {
    left: 12px,
    top: 9.5px,
    width: .auto,
    fill: Colors.theme.contrastStrongest,
    contents: Strings.componentDefaults.button,
    font-size: Typography.fontSize.medium,
    font-style: "SemiBold",
    align: .center
  }
}

