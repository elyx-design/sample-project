import "tokens/strings.elyx" as Strings
import "tokens/colors.elyx" as colors
import "tokens/spacing.elyx" as spacing
import "tokens/typography.elyx" as typography
import "tokens/radius.elyx" as radius
import "icons/20 pixels/star-20.svg" as star20
import "icons/20 pixels/close-20.svg" as close20
import "icons/20 pixels/status-20.svg" as status20

export tagTransparent = frame {
  left: 542px,
  top: 548px,
  height: spacing.size.small,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.theme.baseAlpha50,
  border: {color: colors.theme.contrastAlpha25, width: 0.5px, position: .outside},
  filter: {type: .background-blur, radius: 40px},
  corner-radius: radius.radius.full,
  padding-left: spacing.padding.medium,
  padding-right: spacing.padding.medium,
  children: label,

  label = text {
    left: 0px,
    top: 0px,
    fill: colors.theme.contrastAlpha50,
    contents: Strings.componentDefaults.label,
    font-size: typography.fontSize.small,
    font-style: "Bold"
  }
}

@variant
labelAndClose = frame : tagTransparent {
  left: 542px,
  top: 700px,
  padding-right: spacing.padding.small,
  layout.item-gap: spacing.gap.xsmall,
  overrides: [insert(closeIcon, after = tagTransparent.label)],

  closeIcon = icon {
    left: 525px,
    top: 635px,
    width: 20px,
    height: 20px,
    fill: colors.theme.contrastAlpha50,
    contents: close20
  }
}

@variant
status = frame : tagTransparent {
  left: 545px,
  top: 776px,
  padding-left: spacing.padding.xsmall,
  overrides: [insert(statusIcon, after = .nil)],

  statusIcon = icon {
    left: 525px,
    top: 635px,
    width: 20px,
    height: 20px,
    fill: colors.status.visible,
    contents: status20
  }
}

@variant
iconAndLabel = frame : tagTransparent {
  left: 542px,
  top: 624px,
  padding-left: spacing.padding.small,
  layout.item-gap: spacing.gap.xsmall,
  overrides: [insert(tagIcon, after = .nil)],

  tagIcon = icon {
    left: 525px,
    top: 635px,
    width: 20px,
    height: 20px,
    fill: colors.theme.contrastAlpha50,
    contents: star20
  }
}
