import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "images/misc/logo.png" as logo2
import "tokens/colors.elyx" as Colors

export small = frame {
  left: 340px,
  top: 519px,
  width: .auto,
  height: .auto,
  layout: {align-items: .center},
  fill: {color: Colors.controls.border, visible: .false},
  corner-radius: 0px,
  children: smallArtwork,

  smallArtwork = shape {
    left: 0px,
    top: 80px,
    width: 24px,
    height: 24px,
    fill: {image: {ref: logo2}},
    type: .rect
  }
}

@variant
large = frame : small {
  left: 340px,
  top: 677px,
  overrides: [insert(largeArtwork, after = .nil), remove(small.smallArtwork)],

  largeArtwork = shape {
    left: 0px,
    top: 56px,
    width: 48px,
    height: 48px,
    fill: {image: {ref: logo2}},
    type: .rect
  }
}

@variant
extraLarge = frame : small {
  left: 340px,
  top: 769px,
  overrides: [
    insert(extraLargeArtwork, after = .nil),
    remove(small.smallArtwork)
  ],

  extraLargeArtwork = shape {
    left: 0px,
    top: 80px,
    width: 80px,
    height: 80px,
    fill: {image: {ref: logo2}},
    type: .rect
  }
}

@variant
medium = frame : small {
  left: 340px,
  top: 597px,

  smallArtwork {
    width: Spacing.size.medium,
    height: Spacing.size.medium
  }
}

@variant
extraLargeWordmark = frame : small {
  left: 475px,
  top: 769px,
  layout.item-gap: Spacing.gap.xxlarge,
  overrides: [insert(extraLargeWordmarkLabel, after = small.smallArtwork)],

  smallArtwork {
    width: 80px,
    height: 80px
  }

  extraLargeWordmarkLabel = text {
    left: 362px,
    top: 655px,
    fill: Colors.theme.contrastStrongest,
    contents: "Overleaf",
    font-size: 44,
    font-style: "SemiBold"
  }
}

@variant
largeWordmark = frame : small {
  left: 475px,
  top: 677px,
  layout.item-gap: Spacing.gap.medium,
  overrides: [insert(largeWordmarkLabel, after = small.smallArtwork)],

  smallArtwork {
    width: 48px,
    height: 48px
  }

  largeWordmarkLabel = text {
    left: 402px,
    top: 655px,
    fill: Colors.theme.contrastStrongest,
    contents: "Overleaf",
    font-size: 22,
    font-style: "SemiBold"
  }
}

@variant
mediumWordmark = frame : small {
  left: 475px,
  top: 597px,
  layout.item-gap: Spacing.gap.small,
  overrides: [insert(mediumWordmarkLabel, after = small.smallArtwork)],

  smallArtwork {
    width: Spacing.size.medium,
    height: Spacing.size.medium
  }

  mediumWordmarkLabel = text {
    left: 426px,
    top: 655px,
    fill: Colors.theme.contrastStrongest,
    contents: "Overleaf",
    font-size: Typography.fontSize.xlarge,
    font-style: "SemiBold"
  }
}

@variant
smallWordmark = frame : small {
  left: 475px,
  top: 519px,
  layout.item-gap: Spacing.gap.small,
  overrides: [insert(smallWordmarkLabel, after = small.smallArtwork)],

  smallWordmarkLabel = text {
    left: 426px,
    top: 673px,
    fill: Colors.theme.contrastStrongest,
    contents: "Overleaf",
    font-style: "SemiBold"
  }
}
