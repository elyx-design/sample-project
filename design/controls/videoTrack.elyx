import "tokens/spacing.elyx" as spacing
import "tokens/colors.elyx" as colors
import "tokens/radius.elyx" as radius
import "images/background/bird.jpg" as bird

export videoTrack = frame {
  left: 639px,
  top: 492px,
  width: 475px,
  height: spacing.size.large,
  layout: {justify-content: .space-evenly, align-items: .center},
  fill: colors.palette.lime,
  corner-radius: radius.radius.xsmall,
  padding: [spacing.padding.xsmall, 0px],
  children: [leadingHandle, filmstrip, trailingHandle]
}

leadingHandle = frame {
  left: 281px,
  top: 24px,
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: leadingGrip,

  leadingGrip = shape {
    left: 932px,
    top: 532px,
    width: 2px,
    height: 16px,
    fill: rgb(0%, 0%, 0%, 25%),
    type: .rect,
    corner-radius: radius.radius.full
  }
}

filmstrip = frame {
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: 1px},
  corner-radius: 4px,
  slot: .true,
  children: [frameOne, frameTwo, frameThree],

  frameOne = shape {
    left: 0px,
    top: 0px,
    width: 100%,
    height: spacing.size.large,
    fill: {image: {ref: bird}},
    type: .rect
  }

  frameTwo = shape {
    left: 0px,
    top: 20px,
    width: 100%,
    height: spacing.size.large,
    fill: {image: {ref: bird}},
    type: .rect
  }

  frameThree = shape {
    left: 20px,
    top: 40px,
    width: 100%,
    height: spacing.size.large,
    fill: {image: {ref: bird}},
    type: .rect
  }
}

trailingHandle = frame {
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: trailingGrip,

  trailingGrip = shape {
    left: 932px,
    top: 532px,
    width: 2px,
    height: 16px,
    fill: rgb(0%, 0%, 0%, 25%),
    type: .rect,
    corner-radius: radius.radius.full
  }
}
