import "icons/12 pixels/dot-12.svg" as dot12
import "tokens/colors.elyx" as colors
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography

export projectsFeature = frame {
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [projectsBullet, projectsLabel],

  projectsBullet = asset {
    left: 4px,
    top: 4px,
    width: 12px,
    height: 12px,
    fill: colors.theme.contrastStrongest,
    contents: dot12
  }

  projectsLabel = text {
    fill: colors.theme.contrastDefault,
    contents: "Label",
    font-size: Typography.fontSize.medium
  }
}
