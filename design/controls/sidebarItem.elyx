import "icons/20 pixels/cloud-20.svg" as cloud20
import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/strings.elyx" as strings

@variant
selected = frame : sidebarMenu {
  left: -492px,
  top: 76px,
  corner-radius: radius.radius.full,
  fill[0].color: colors.theme.contrastAlpha25
}

export sidebarMenu = frame {
  left: -492px,
  top: 0px,
  width: 100%,
  height: Spacing.size.small,
  layout: {align-items: .center, item-gap: Spacing.gap.xsmall},
  padding-left: Spacing.padding.small,
  padding-right: Spacing.padding.small,
  children: [shape1, text2],

  shape1 = icon {
    left: 2px,
    top: 2px,
    width: 20px,
    height: 20px,
    fill: colors.theme.contrastStrongest,
    contents: cloud20
  }

  text2 = text {
    left: 31px,
    top: 7px,
    fill: colors.theme.contrastStrongest,
    contents: strings.navigation.menu,
    font-size: Typography.fontSize.small
  }
}
