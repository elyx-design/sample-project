import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors

export slider = frame {
  left: 702px,
  top: 539px,
  width: 203px,
  height: 6px,
  layout: {align-items: .center},
  fill: colors.theme.contrastAlpha25,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: radius.radius.full,
  padding-left: 1px,
  padding-right: 1px,
  children: track,

  track = shape {
    left: 0px,
    top: 0px,
    width: 40%,
    height: 4px,
    fill: colors.theme.base,
    type: .rect,
    corner-radius: radius.radius.full
  }
}

@variant
thumb = frame : slider {
  left: 702px,
  top: 591px,
  overflow: .visible,
  overrides: [insert(handle_2, after = slider.track)],

  track {
    width: 81.2px,
    corner-radius: [radius.radius.full, 0px, 0px, radius.radius.full]
  }

  handle_2 = frame : handle {
    left: 789px,
    top: 589px
  }
}

@variant
full = frame : slider {
  left: 702px,
  top: 645px,
  overflow: .visible,
  overrides: [insert(handle_3, after = slider.track)],

  track {
    width: 100%,
    corner-radius: [radius.radius.full, 0px, 0px, radius.radius.full]
  }

  handle_3 = frame : handle {
    left: 796px,
    top: 643px
  }
}

export handle = frame {
  left: 620px,
  top: 539px,
  width: 10px,
  height: 10px,
  children: thumbHandle_2,

  thumbHandle_2 = shape {
    left: 0px,
    top: 0px,
    width: 10px,
    height: 10px,
    fill: colors.theme.baseAlpha50,
    border: {color: colors.theme.baseAlpha70, width: 2px},
    filter: {type: .background-blur, radius: 40px},
    type: .ellipse
  }
}
