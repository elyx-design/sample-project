import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "design/blocks/videoPlayer.elyx" as videoPlayer
import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors
import "design/controls/button.elyx" as button
import "design/blocks/chatWindow.elyx" as chatWindow
import "design/blocks/userSummary.elyx" as userSummary
import "design/blocks/siteHeader.elyx" as siteHeader
import "icons/20 pixels/pause-20.svg" as pause20
import "design/blocks/sidebar.elyx" as sideBar
import "images/misc/bikeBGBanner.jpg" as bikeBGBanner

export liveEvent = frame {
  left: -642.9999px,
  top: -511px,
  width: 1440px,
  height: 810px,
  layout: {direction: .column, align-items: .center},
  fill: colors.theme.base,
  children: [eventHeader, eventContent],

  eventHeader = frame : siteHeader.accountHeader {
    left: 0px,
    top: 43px,
    width: 100%,
    fill[0].color: colors.theme.base,

    accountDivider {
      overrides: [remove(siteHeader.divider.horizontal.horizontalLine)]
    }

    siteHeader.accountContent {
      siteHeader.accountNav {
        accountResources {
          label {
            contents: Strings.navigation.playlists
          }
        }

        accountCompany {
          label {
            contents: Strings.navigation.categories
          }
        }

        accountPricing {
          label {
            contents: Strings.navigation.browse
          }
        }

        accountProduct {
          label {
            contents: Strings.status.liveNow
          }
        }
      }
    }
  }
}

eventContent = frame {
  left: 226.9999px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .row},
  corner-radius: 0px,
  overflow: .visible,
  children: [eventSidebar, eventVideo, eventChat],

  eventSidebar = frame : sideBar.sidebarLiveEvent {
    left: 751px,
    top: 0px,
    height: 100%,
    corner-radius: 0px,
    border[0].visible: .false,
    fill[0].visible: .false
  }

  eventChat = frame : chatWindow.liveChat {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 100%
  }
}

eventVideo = frame {
  left: 0px,
  top: 0px,
  width: 65%,
  height: 100%,
  layout: {direction: .column, align-items: .end, item-gap: Spacing.gap.xxsmall},
  overflow: .scroll,
  children: [videoPlayerView, aboutSection],

  videoPlayerView = frame : videoPlayer.videoPlayer {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 603px,

    controls {
      videoPlayer.playbackControl.scrubber {
        playButton {
          smallIconGlyph {
            contents: pause20
          }
        }

        progressSlider {
          track {
            fill[0].opacity: .nil,
            fill[0].mix-blend-mode: .nil
          }
        }
      }
    }

    videoPlayer.headerRow {
      eventHeader {
        smallSubtitle {
          contents: Strings.liveEvent.streamTitle
        }

        smallTitle {
          contents: "CAM 3"
        }
      }
    }
  }
}

aboutSection = frame {
  left: 0px,
  top: 654px,
  width: 100%,
  height: 320px,
  layout: {direction: .column, item-gap: Spacing.gap.xxlarge},
  fill: {image: {ref: bikeBGBanner}},
  corner-radius: radius.radius.small,
  corner-smoothing: radius.radius.smoothing,
  overflow: .visible,
  padding: Spacing.padding.xlarge,
  children: [channelSummary, actionButtons],

  channelSummary = frame : userSummary.small {
    left: -238px,
    top: 333px,

    smallHeader {
      smallSubtitle {
        fill[0].color: colors.primitives.white70,
        contents: Strings.liveEvent.channelDescription
      }

      smallTitle {
        fill[0].color: colors.primitives.white,
        contents: "BikeNOW"
      }

      width: .auto
    }
  }
}

actionButtons = frame {
  width: 100%,
  layout: {item-gap: Spacing.gap.small},
  overflow: .visible,
  children: [followButton, giftButton, subscribeButton],

  followButton = frame : button.small {
    left: 254.9999px,
    top: 58px,

    smallLabel {
      contents: Strings.actions.follow
    }
  }

  giftButton = frame : button.smallPrimary {
    left: 274.9999px,
    top: 78px,

    smallLabel {
      contents: Strings.actions.giftSubscription
    }
  }

  subscribeButton = frame : button.smallPrimary {
    left: 294.9999px,
    top: 98px,

    smallLabel {
      contents: Strings.actions.subscribeDiscount
    }
  }
}
