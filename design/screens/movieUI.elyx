export MovieUI = frame {
  left: 396px,
  top: 257px,
  width: 1440px,
  height: 810px,
  layout: {direction: .column, align-items: .center},
  fill: .black,
  padding-top: 0px,
  children: [movieBG, siteHeader_2, GroupedStack],

  movieBG = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 687px,
    ignore-stack: .true,
    fill: {image: {ref: woman}},
    overflow: .visible
  }

  siteHeader_2 = frame : siteHeader.accountHeader {
    left: 0px,
    top: -142px,
    width: 100%,

    siteHeader.accountHeader.accountDivider {
      divider.horizontal.horizontalLine {
        fill[0].color: colors.theme.baseAlpha50
      }
    }

    siteHeader.accountContent {
      siteHeader.accountActions {
        siteHeader.accountMenu {
          overrides: [remove(siteHeader.accountMenu.accountLanguage)],

          siteHeader.accountMenu.accountAvatar {
            avatar.small.smallStatus {
              display: .hidden
            }
          }
        }

        siteHeader.accountActions.accountSearch {
          fill[0].color: colors.primitives.whiteAlpha25,

          siteHeader.textField.iconPlaceholder.placeholderIcon {
            fill[0].color: colors.theme.baseAlpha70
          }
        }
      }

      siteHeader.accountNav {
        siteHeader.accountNav.accountResources {
          siteHeader.mutedIconMenu.mutedChevron {
            fill[0].color: colors.theme.baseAlpha70
          }

          siteHeader.menu.label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.favourites
          }
        }

        siteHeader.accountNav.accountCompany {
          siteHeader.menu.label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.status.live
          }
        }

        siteHeader.accountNav.accountPricing {
          siteHeader.menu.label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.tvShows
          }
        }

        siteHeader.accountNav.accountProduct {
          siteHeader.menu.label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.movies
          }
        }
      }

      siteHeader.accountContent.small_6 {
        siteHeader.logo.mediumWordmark.text2 {
          fill[0].color: colors.theme.base
        }
      }
    }
  }
}

GroupedStack = frame {
