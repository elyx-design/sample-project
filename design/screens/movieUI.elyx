  horizontal = frame : divider.horizontal {
    left: 0px,
    top: 553px,
    width: 100%,
    padding-top: 0px,
    padding-bottom: 0px,

    divider.horizontal.horizontalLine {
      fill[0].color: colors.primitives.white50
    }
  }

  GroupedStack_8 = frame {
    width: 100%,
    layout: {item-gap: Spacing.gap.xxlarge},
    overflow: .visible,
    children: [details, GroupedStack_9]
  }
}

