synopsisSection = frame {
  width: 100%,
  layout: {
    direction: .column,
    align-items: .center,
    item-gap: Spacing.gap.small
  },
  overflow: .visible,
  children: [synopsisHeading, synopsisBody],

  synopsisHeading = text {
    left: 0px,
    top: 826px,
    width: 100%,
    fill: colors.primitives.white,
    contents: Strings.labels.synopsis,
    font-size: Typography.fontSize.large,
    font-style: "Bold"
  }

  synopsisBody = text {
    left: 0px,
    top: 846px,
    width: 100%,
    fill: colors.primitives.white70,
    contents: "A rising performance artist begins to lose the line between the faces she paints and the self underneath. As each new piece grows bolder, so does the fracture between who she shows the world and who she has left in private. Chroma is an intimate portrait of identity, spectacle, and the cost of being seen.",
    font-style: "Light",
    line-height: Typography.lineHeight.relaxed
  }
}

