export MovieUI = frame {
  left: 396px,
  top: 257px,
  width: 1440px,
  height: 810px,
  layout: {direction: .column, align-items: .center},
  fill: .black,
  padding-top: 0px,
  children: [movieBackground, movieHeader, movieContent],

  movieBackground = frame {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 687px,
    ignore-stack: .true,
    fill: {image: {ref: woman}},
    overflow: .visible
  }

  movieHeader = frame : siteHeader.accountHeader {
    left: 0px,
    top: -142px,
    width: 100%,

    accountDivider {
      horizontalLine {
        fill[0].color: colors.theme.baseAlpha50
      }
    }

    siteHeader.accountContent {
      siteHeader.accountActions {
        siteHeader.accountMenu {
          overrides: [remove(siteHeader.accountMenu.accountLanguage)],

          accountAvatar {
            smallStatus {
              display: .hidden
            }
          }
        }

        accountSearch {
          fill[0].color: colors.primitives.whiteAlpha25,

          placeholderIcon {
            fill[0].color: colors.theme.baseAlpha70
          }
        }
      }

      siteHeader.accountNav {
        accountResources {
          mutedChevron {
            fill[0].color: colors.theme.baseAlpha70
          }

          label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.favourites
          }
        }

        accountCompany {
          label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.status.live
          }
        }

        accountPricing {
          label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.tvShows
          }
        }

        accountProduct {
          label {
            fill[0].color: colors.theme.baseAlpha70,
            contents: Strings.navigation.movies
          }
        }
      }

      small_6 {
        mediumWordmarkLabel {
          fill[0].color: colors.theme.base
        }
      }
    }
  }
}

