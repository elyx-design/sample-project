import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "images/background/night.jpg" as night
import "design/blocks/siteHeader.elyx" as siteHeader
import "tokens/radius.elyx" as Radius
import "tokens/colors.elyx" as colors
import "design/controls/button.elyx" as button
import "design/blocks/header.elyx" as header
import "icons/24 pixels/direct-24.svg" as direct24
import "icons/24 pixels/activity.svg" as activity
import "design/controls/tag.elyx" as tag
import "icons/20 pixels/arrowDown-20.svg" as arrowDown20
import "icons/24 pixels/mug-24.svg" as mug24
import "design/screens/signIn.elyx" as signIn
import "design/screens/footer.elyx" as footer
import "design/screens/pricingPage.elyx" as pricingPage
import "design/blocks/productGallery.elyx" as productGallery

__file__ {
  draw-connections: .true
}

export LandingPage = frame {
  doc: "This frame is a real scroll view. Select it, and scroll down.",
  left: -5px,
  top: 137px,
  width: 1440px,
  height: 810px,
  layout: {direction: .column, align-items: .center, item-gap: 248px},
  fill: [colors.theme.base, {mix-blend-mode: .multiply, image: {ref: night}}],
  overflow: .scroll,
  padding-top: Spacing.padding.xxlarge,
  padding-bottom: Spacing.padding.xxlarge,
  children: [top, featureSection, gallerySection]
}

top = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 96px},
  overflow: .visible,
  children: [pageHeader, heroContent],

  pageHeader = frame : siteHeader.siteHeader {
    left: 388.5px,
    top: 145px,
    width: 60%,
    border[0].visible: .false,
    shadow[0].drop-shadow.visible: .false,

    siteHeader.headerCta {
      logInLink {
        label {
          connections[0].target: signIn.signInScreen
        }
      }
    }

    siteHeader.navLinks {
      overrides: [remove(siteHeader.navLinks.navResources)],

      navPricing {
        label {
          connections[0].target: pricingPage.pricingPage
        }
      }
    }
  }
}

heroContent = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.huge},
  overflow: .visible,
  children: [heroHeading, heroActions],

  heroHeading = frame : header.largeCenter {
    left: 1840px,
    top: 449px,
    width: 44.0752%,

    largeTitle {
      width: 100%,
      contents: Strings.landingPage.heroTitle
    }

    largeSubtitle {
      contents: Strings.landingPage.heroDescription
    }
  }
}

heroActions = frame {
  width: 100%,
  layout: {
    justify-content: .center,
    align-items: .center,
    item-gap: Spacing.gap.xlarge
  },
  overflow: .visible,
  children: [getStartedButton, watchDemoLabel],

  getStartedButton = frame : button.medium {
    left: 733px,
    top: 353px,

    mediumLabel {
      contents: Strings.actions.getStarted
    }
  }

  watchDemoLabel = text {
    left: 854px,
    top: 477px,
    fill: colors.theme.contrastAlpha50,
    contents: Strings.actions.watchDemo,
    font-style: "SemiBold"
  }
}

featureSection = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.huge},
  overflow: .visible,
  children: [bottom, base],

  bottom = frame {
    left: 311px,
    top: 840px,
    width: 60%,
    height: .auto,
    layout: {align-items: .center, item-gap: Spacing.gap.xxlarge},
    overflow: .visible,
    children: [layer1, layer2, layer3]
  }

  base = frame : tag.iconAndLabel {
    left: 774px,
    top: 1091px,
    border[0].visible: .false,
    connections[0].target: footer.Footer,
    fill[0].color: colors.theme.contrastAlpha25,

    label {
      fill[0].color: colors.theme.baseAlpha70,
      contents: Strings.actions.scrollDown
    }

    tagIcon {
      fill[0].color: colors.theme.baseAlpha70,
      contents: arrowDown20
    }
  }
}

layer1 = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.theme.baseAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [directIcon, directHeader],

  directIcon = asset {
    left: 644px,
    top: 704px,
    width: 40px,
    height: 40px,
    contents: direct24
  }

  directHeader = frame : header.smallLeft {
    left: 0px,
    top: 0px,

    smallSubtitle {
      contents: Strings.landingPage.minimalDescription
    }

    smallTitle {
      contents: Strings.landingPage.minimalTitle
    }
  }
}

layer2 = frame {
  left: 20px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.theme.baseAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [reliabilityIcon, steadyHeader],

  reliabilityIcon = asset {
    left: 648px,
    top: 708px,
    width: 40px,
    height: 40px,
    contents: activity
  }

  steadyHeader = frame : header.smallLeft {
    left: 0px,
    top: 0px,

    smallSubtitle {
      contents: Strings.landingPage.reliabilityDescription
    }

    smallTitle {
      contents: Strings.landingPage.reliabilityTitle
    }
  }
}

layer3 = frame {
  left: 354.6666px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {item-gap: Spacing.gap.medium},
  fill: colors.theme.baseAlpha50,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: Radius.radius.medium,
  overflow: .visible,
  padding: Spacing.padding.large,
  children: [collaborationIcon, teamHeader],

  collaborationIcon = asset {
    left: 655px,
    top: 715px,
    width: 40px,
    height: 40px,
    contents: mug24
  }

  teamHeader = frame : header.smallLeft {
    left: 0px,
    top: 0px,

    smallSubtitle {
      contents: Strings.landingPage.collaborationDescription
    }

    smallTitle {
      contents: Strings.landingPage.collaborationTitle
    }
  }
}

gallerySection = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 96px},
  overflow: .visible,
  children: [galleryHeading, galleryGrid],

  galleryHeading = frame : header.largeCenter {
    left: 1840px,
    top: -265px,
    width: 44.0752%,

    largeTitle {
      width: 100%,
      contents: Strings.landingPage.galleryTitle
    }

    largeSubtitle {
      contents: Strings.landingPage.galleryDescription
    }
  }

  galleryGrid = frame : productGallery.productGallery {
    left: 276px,
    top: 443px
  }
}
