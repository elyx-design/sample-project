timelinePlayHead = frame {
  left: 385px,
  top: -5px,
  width: 12px,
  height: 281px,
  ignore-stack: .true,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  overflow: .visible,
  padding-top: Spacing.padding.medium,
  children: [line, handle],

  line = shape {
    left: 6px,
    top: 0px,
    width: 2px,
    height: 100%,
    fill: [
      Colors.palette.lime,
      {
        linear-gradient: {
          from: point(50%, 88.7466%),
          to: point(50%, 100%),
          stops: [stop(0%, .transparent), stop(100%, Colors.gradients.overlayEnd)]
        }
      }
    ],
    border: {color: Colors.theme.contrastAlpha70, width: 0.5px, position: .outside},
    type: .rect
  }

  handle = shape {
    left: 0px,
    top: 0px,
    width: 12px,
    height: 12px,
    ignore-stack: .true,
    fill: Colors.theme.contrastAlpha70,
    border: {color: Colors.palette.lime, width: 2px},
    type: .ellipse
  }
}
