        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Orange Bird"
        }
      }

      imageGallery.bottomRow.bottomRight {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: video20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Red-flanked Bluetail"
        }
      }

      imageGallery.bottomRow.bottomLeft {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: image20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Great Horned Owl"
        }
      }
    }

    imageGallery.middleRow {
      imageGallery.middleRow.middleRight {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: image20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Blue-and-yellow Macaw"
        }
      }

      imageGallery.middleRow.middleCenter {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: video20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Bald Eagle.wave"
        }
      }

      imageGallery.middleRow.middleLeft {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: image20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Northern Cardinal\nBody Red"
        }
      }
    }

    imageGallery.topRow {
      imageGallery.topRow.topRight {
        imageGallery.thumbnailImage.actions {
          imageGallery.thumbnailImage.actions.favoriteIcon {
            contents: video20
          }
        }

        imageGallery.thumbnailImage.thumbnailImage.imageName {
          contents: "Toco Toucan"
        }
      }

      imageGallery.topRow.topCenter {
        imageGallery.thumbnailImage.actions {
