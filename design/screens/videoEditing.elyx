}

workspace = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, align-items: .center},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  corner-smoothing: 0.5,
  children: [preview, timeline],

  timeline = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, align-items: .center, item-gap: Spacing.gap.small},
    fill: {color: Colors.theme.contrastStrongest, visible: .false},
    padding-top: Spacing.padding.small,
    children: [ruler, tracks]
  }
}

preview = frame {
  left: 0px,
  top: 0px,
  height: 60%,
  layout: {justify-content: .end, align-items: .end, item-gap: Spacing.gap.xxsmall},
  fill: {color: Colors.theme.contrastStrongest, visible: .false},
  children: [player, gallery],

  player = frame : videoPlayer.videoPlayer {
    left: -3772px,
    top: 0px,
    width: 60%,
    height: 100%,
    fill[0].image.ref: bird,
    fill[1].linear-gradient.stops[1].color: Colors.gradients.overlayEnd,

    videoPlayer.videoPlayer.controls {
      videoPlayer.playbackControl.tools {
        videoPlayer.playbackControl.tools.likeButton {
          videoPlayer.playbackControl.button.smallIcon.smallIconGlyph {
            contents: pen20
          }
        }

        videoPlayer.playbackControl.tools.settingsButton {
          videoPlayer.playbackControl.button.smallIcon.smallIconGlyph {
            contents: pointer20
          }
        }
      }

      videoPlayer.playbackControl.scrubber {
        @use-variant(slider.thumb)
        videoPlayer.playbackControl.scrubber.progressSlider {}

        videoPlayer.playbackControl.scrubber.progressSlider {
          videoPlayer.playbackControl.slider.thumb.handle_2 {
            videoPlayer.playbackControl.slider.handle.thumbHandle_2 {
