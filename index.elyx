import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "design/controls/button.elyx" as button
import "tokens/colors.elyx" as colors
import "design/blocks/cardInfo.elyx" as cardInfo
import "images/intro/introBG.png" as introBG
import "images/intro/elyxLogo.png" as elyxLogo

controlInstance = frame : button.medium {
  left: -8px,
  top: 489px
}

blockExample = frame : cardInfo.reviewCard {
  left: 282px,
  top: 489px
}

intro = frame {
  left: -412px,
  top: -389px,
  height: .auto,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 20px,
  children: [welcome, demoProjectContent],

  welcomeDescription = text {
    left: -46.02px,
    top: -273px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: "Elyx concepts",
    font-size: 24,
    font-style: "Medium",
    line-height: 1.3
  }
}

welcome = frame {
  left: 0px,
  top: 0px,
  width: 700px,
  height: 100%,
  layout: {direction: .column, justify-content: .end, item-gap: 12px},
  fill: {image: {ref: introBG}},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: [0px, 56px, 56px],
  children: [elyxLogoImage, introCopy],

  elyxLogoImage = shape {
    left: 437.52px,
    top: 74.7561px,
    width: 252px,
    height: 88px,
    fill: {image: {ref: elyxLogo}},
    type: .rect
  }
}

introCopy = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  corner-radius: 0px,
  padding: 0px,
  children: welcomeHeading,

  welcomeHeading = text {
    left: 0px,
    top: 0px,
    mix-blend-mode: .overlay,
    fill: colors.primitives.white70,
    contents: Strings.demoProject.welcomeTitle,
    font-size: 24,
    font-style: "Medium",
    align: .center
  }
}

demoProjectContent = frame {
  left: 903px,
  top: 0px,
  width: 831px,
  height: .auto,
  layout: {direction: .column, align-items: .center, item-gap: 24px},
  fill: rgb(92.94%, 92.94%, 92.1569%),
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: 56px,
  children: [welcomeIntro, layerTypesOverview, projectResourcesOverview],

  layerTypesOverview = frame {
    width: 100%,
    layout: {item-gap: 8px},
    fill: rgb(7.0588%, 7.0588%, 7.0588%),
    corner-radius: 12px,
    corner-smoothing: 0.6,
    padding: 8px,
    children: [controlsOverviewCard, blocksOverviewCard, screensOverviewCard]
  }
}

controlsOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [controlsLabel, controlsDescription],

  controlsLabel = text {
    left: 69px,
    top: 45px,
    fill: colors.primitives.white,
    contents: "COMPONENTS",
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  controlsDescription = text {
    left: 0px,
    top: 65px,
    width: 100%,
    fill: colors.primitives.white70,
    contents: "We encourage you to create components from simple controls to entire views. Think of Elyx as the knowledge base of your project.",
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

blocksOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [blocksLabel, blocksDescription],

  blocksLabel = text {
    left: 162.6667px,
    top: -17px,
    fill: colors.primitives.white,
    contents: "ELYX IS A PROJECT",
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  blocksDescription = text {
    left: 0px,
    top: 71px,
    width: 100%,
    fill: colors.primitives.white70,
    contents: "This sample project contains dozens of small files. Use a single project for a product you are working on, from a website to an app.",
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

screensOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [screensLabel, screensDescription],

  screensLabel = text {
    left: 162.6667px,
    top: -25.5px,
    fill: colors.primitives.white,
    contents: "AGENTS AND DEVELOPERS",
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  screensDescription = text {
    left: 54px,
    top: 0px,
    width: 100%,
    height: .auto,
    fill: colors.primitives.white70,
    contents: "Elyx is stored as plain text files; easily readably by agents, and friendly to git. Agents can translate .elyx files to whatever you want. No need for an MCP; the files are already on your computer.",
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

projectResourcesOverview = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [assetFoldersDescription, tokensFolderDescription],

  assetFoldersDescription = text {
    left: 20px,
    top: 60px,
    width: 100%,
    fill: colors.palette.tealDark,
    subrange: [
      {range: [217, 225], font-style: "Bold"},
      {range: [227, 233], font-style: "Bold"},
      {range: [235, 242], font-style: "Bold"},
      {range: [248, 253], font-style: "Bold"}
    ],
    contents: "This project demonstrates best practices for organizing and building with .elyx files. Fundamentally everything is just a component, but for organisational purposes we have organised these components in four folders: controls, blocks, screens, and flows; \n\nThe project also includes folders for assets such as images and icons. Add a /fonts folder if the project needs custom fonts.",
    font-size: 14,
    line-height: 1.5
  }

  tokensFolderDescription = text {
    left: 20px,
    top: 301px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: Strings.demoProject.tokensDescription,
    font-size: 14,
    line-height: 1.5
  }
}

welcomeIntro = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [
    welcomeDescription,
    projectStructureOverview,
    intro.welcomeDescription
  ],

  welcomeDescription = text {
    left: -46.02px,
    top: -161px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: "Elyx is a new take on design. We believe design needs to get closer to development, and friendlier to agents.",
    font-size: 24,
    font-style: "Medium",
    line-height: 1.3
  }

  projectStructureOverview = text {
    left: 0px,
    top: 40px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: "Elyx wants to be a knowledge base for your product, so we're moving design to where developers live; in git. Rather than large opaque design files Elyx splits design up into many small files; agent-friendly and git-friendly.",
    font-size: 14,
    line-height: 1.5
  }
}
