Screenswouldbethi = text {
  name: "Screens would be thi",
  left: 54px,
  top: 0px,
  width: 100%,
  height: .auto,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "Screens would be things like app windows, panels, and standalone states that represent what a user would see at one moment. Examples would be things like Log In, Dashboard, Settings, Account, etc.",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

Alsointheproject = text {
  name: "Also in the project ",
  left: 20px,
  top: 60px,
  width: 100%,
  fill: rgb(27.3%, 20.74%, 2.7%),
