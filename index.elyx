Componentsarethes = text {
  name: "Components are the s",
  left: 0px,
  top: 65px,
  width: 100%,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "Components are the smallest reusable UI pieces in the Elyx design system. Think of them like atoms. These would be UI elements such as button, text fields, badges etc.",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

Frame_j = frame {
