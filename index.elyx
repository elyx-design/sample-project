Ifcomponentsareat = text {
  name: "If components are at",
  left: 0px,
  top: 71px,
  width: 100%,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "If components are atoms, then blocks are like molecules. Blocks are used interface sections such as panels, menus, toasts, alerts, etc that would contain components.",
