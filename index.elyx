Welcome = frame {
  name: "Welcome",
  left: 0px,
  top: 2px,
  width: 1100px,
  height: .auto,
  layout: {direction: .column, item-gap: 24px},
  fill: rgb(99.64%, 98.67%, 94.36%),
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: Radius.radius.l,
  padding: [40px, 60px],
  children: [GroupedStack, Asyoucanseeinth, GroupedStack_T, Alsointheproject, Finallyistheexis]
}

GroupedStack = frame {
  name: "Intro Copy",
  width: 100%,
