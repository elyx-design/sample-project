  contents: "This document contains best practices on how to set up .elyx files within your project",
  font-size: tokens.labelSizeL,
  font-family: "Inter",
  font-style: "Medium"
}

Asyoucanseeinth = text {
  name: "As you can see in th",
  left: 0px,
  top: 40px,
  width: 100%,
  fill: tokens.textColorDark,
  contents: "As you can see in the project list on the left, files are organized into groups, with the most important ones being components, blocks, and screens. The three main building blocks for organizing your components.",
