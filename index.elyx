import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button
import "blocks/cardInfo.elyx" as cardInfo

welcome = frame {
  left: 0px,
  top: 2px,
  width: 1100px,
  height: .auto,
  layout: {direction: .column, item-gap: Spacing.gap.xxlarge},
  fill: rgb(99.64%, 98.67%, 94.36%),
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: Radius.radius.large,
  padding: [40px, 60px],
  children: [
    introCopy,
    projectStructureOverview,
    scaffoldSections,
    assetFoldersDescription,
    tokensFolderDescription
  ]
}

introCopy = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  corner-radius: 0px,
  padding: 0px,
  children: [welcomeHeading, welcomeDescription]
}

welcomeHeading = text {
  left: 0px,
  top: 0px,
  fill: rgb(27.3%, 20.74%, 2.7%),
  contents: "Welcome to the Elyx scaffold project",
  font-size: 32,
  font-family: "Inter",
  font-style: "Regular"
}

welcomeDescription = text {
  left: 20px,
  top: 20px,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "This document contains best practices on how to set up .elyx files within your project",
  font-size: Typography.typography.labelL,
  font-family: "Inter",
  font-style: "Regular"
}

projectStructureOverview = text {
  left: 0px,
  top: 40px,
  width: 100%,
  fill: rgb(27.3%, 20.74%, 2.7%),
  contents: "As you can see in the project list on the left, files are organized into groups, with the most important ones being components, blocks, and screens. The three main building blocks for organizing your components.",
  font-size: Typography.typography.labelL,
  font-family: "Inter",
  font-style: "Regular"
}

scaffoldSections = frame {
  width: 100%,
  layout: {item-gap: Spacing.gap.xlarge},
  children: [componentsCard, blocksCard, screensCard]
}

componentsCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  fill: rgb(99.04%, 97.86%, 88.96%),
  border: rgb(89.6%, 84.8%, 58.4%),
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [componentsLabel, componentsDescription]
}

componentsLabel = text {
  left: 69px,
  top: 45px,
  fill: rgb(62%, 38.23%, 0%),
  contents: "COMPONENTS",
  font-size: 12,
  font-family: "Inter",
  font-style: "SemiBold",
  letter-spacing: 5%
}

componentsDescription = text {
  left: 0px,
  top: 65px,
  width: 100%,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "Components are the smallest reusable UI pieces in the Elyx design system. Think of them like atoms. These would be UI elements such as button, text fields, badges etc.",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

blocksCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  fill: rgb(99.04%, 97.86%, 88.96%),
  border: rgb(89.6%, 84.8%, 58.4%),
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [blocksLabel, blocksDescription]
}

blocksLabel = text {
  left: 162.6667px,
  top: -17px,
  fill: rgb(62%, 38.23%, 0%),
  contents: "BLOCKS",
  font-size: 12,
  font-family: "Inter",
  font-style: "SemiBold",
  letter-spacing: 5%
}

blocksDescription = text {
  left: 0px,
  top: 71px,
  width: 100%,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "If components are atoms, then blocks are like molecules. Blocks are used interface sections such as panels, menus, toasts, alerts, etc that would contain components.",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

screensCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  fill: rgb(99.04%, 97.86%, 88.96%),
  border: rgb(89.6%, 84.8%, 58.4%),
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [screensLabel, screensDescription]
}

screensLabel = text {
  left: 162.6667px,
  top: -25.5px,
  fill: rgb(62%, 38.23%, 0%),
  contents: "SCREENS",
  font-size: 12,
  font-family: "Inter",
  font-style: "SemiBold",
  letter-spacing: 5%
}

screensDescription = text {
  left: 54px,
  top: 0px,
  width: 100%,
  height: .auto,
  fill: rgb(27.45%, 20.78%, 2.7451%),
  contents: "Screens would be things like app windows, panels, and standalone states that represent what a user would see at one moment. Examples would be things like Log In, Dashboard, Settings, Account, etc.",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

assetFoldersDescription = text {
  left: 20px,
  top: 60px,
  width: 100%,
  fill: rgb(27.3%, 20.74%, 2.7%),
  contents: "Also in the project are folders for other asset types, such as images and icons. If you were to add fonts, then create a new /fonts folder.",
  font-size: Typography.typography.labelL,
  font-family: "Inter",
  font-style: "Regular"
}

tokensFolderDescription = text {
  left: 20px,
  top: 301px,
  width: 100%,
  fill: rgb(27.3%, 20.74%, 2.7%),
  contents: "Finally, is the existence of a tokens/ folder. Each file there groups a related family of tokens - colors, typography, spacing, radius - referenced throughout the entire project.",
  font-size: Typography.typography.labelL,
  font-family: "Inter",
  font-style: "Regular"
}

componentExample = button.medium {left: 16px, top: 757px}

blockExample = cardInfo.reviewCard {left: 306px, top: 757px}
