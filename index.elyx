import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button
import "tokens/colors.elyx" as colors
import "blocks/cardInfo.elyx" as cardInfo
import "images/intro/introBG.png" as introBG
import "images/intro/elyxLogo.png" as elyxLogo

componentExample = frame : button.medium {left: 16px, top: 757px}

blockExample = frame : cardInfo.reviewCard {left: 306px, top: 757px}

intro = frame {
  left: -412px,
  top: -389px,
  height: 620px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 20px,
  children: [welcome, welcome_2]
}

welcome = frame {
  left: 0px,
  top: 0px,
  width: 700px,
  height: 100%,
  layout: {direction: .column, justify-content: .end, item-gap: 12px},
  fill: {image: {ref: introBG}},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: [0px, 56px, 56px],
  children: [elyxLogopng, introCopy]
}

elyxLogopng = shape {
  left: 437.52px,
  top: 74.7561px,
  width: 252px,
  height: 88px,
  fill: {image: {ref: elyxLogo}},
  type: .rect
}

introCopy = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  corner-radius: 0px,
  padding: 0px,
  children: welcomeHeading
}

welcomeHeading = text {
  left: 0px,
  top: 0px,
  mix-blend-mode: .overlay,
  fill: colors.primitives.white70,
  contents: Strings.scaffold.welcomeTitle,
  font-size: 24,
  align: .center
}

welcome_2 = frame {
  left: 903px,
  top: 0px,
  width: 831px,
  height: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 24px},
  fill: rgb(92.94%, 92.94%, 92.1569%),
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: 56px,
  children: [GroupedStack, scaffoldSections_2, GroupedStack_2]
}

GroupedStack = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [welcomeDescription_2, projectStructureOverview_2]
}

welcomeDescription_2 = text {
  left: -46.02px,
  top: -161px,
  width: 100%,
  fill: colors.palette.tealDark,
  contents: Strings.scaffold.welcomeDescription,
  font-size: 24,
  line-height: 1.3
}

projectStructureOverview_2 = text {
  left: 0px,
  top: 40px,
  width: 100%,
