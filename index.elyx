Frame = frame {
  name: "Frame",
  left: 0px,
  top: 0px,
  width: 1000px,
  height: .auto,
  layout: {direction: .column, item-gap: tokens.spacingXL},
  fill: .white,
  border: rgb(80%, 80%, 80%),
  corner-radius: tokens.borderRadiusL,
  padding: 40px,
  children: [GroupedStack, Asyoucanseeinth, GroupedStack_T, Alsointheproject, Finallyistheexis]
}

GroupedStack = frame {
  name: "Grouped Stack",
  width: 100%,
  layout: {direction: .column, item-gap: 8},
  corner-radius: 0px,
  padding: 0px,
  children: [WelcometotheElyx, Thisdocumentcontai]
}

WelcometotheElyx = text {
  name: "Welcome to the Elyx ",
  left: 0px,
  top: 0px,
  fill: tokens.textColorDark,
  contents: "Welcome to the Elyx scaffold project",
  font-size: tokens.labelSizeXL,
  font-family: "Inter",
  font-style: "Bold"
}

Thisdocumentcontai = text {
  name: "This document contai",
