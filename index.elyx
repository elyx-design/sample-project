import "tokens/strings.elyx" as Strings
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "design/controls/button.elyx" as button
import "tokens/colors.elyx" as colors
import "design/blocks/cardInfo.elyx" as cardInfo
import "images/intro/introBG.png" as introBG
import "images/intro/elyxLogo.png" as elyxLogo

controlExample = frame : button.medium {
  doc: "A simple button control.",
  left: -8px,
  top: 489px
}

blockExample = frame : cardInfo.reviewCard {
  left: 282px,
  top: 489px
}

intro = frame {
  left: -412px,
  top: -389px,
  height: 620px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 20px,
  children: [welcome, demoProjectContent]
}

welcome = frame {
  left: 0px,
  top: 0px,
  width: 700px,
  height: 100%,
  layout: {direction: .column, justify-content: .end, item-gap: 12px},
  fill: {image: {ref: introBG}},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: [0px, 56px, 56px],
  children: [elyxLogoImage, introCopy],

  elyxLogoImage = shape {
    left: 437.52px,
    top: 74.7561px,
    width: 252px,
    height: 88px,
    fill: {image: {ref: elyxLogo}},
    type: .rect
  }
}

introCopy = frame {
  width: 100%,
  layout: {direction: .column, item-gap: Spacing.gap.small},
  corner-radius: 0px,
  padding: 0px,
  children: welcomeHeading,

  welcomeHeading = text {
    left: 0px,
    top: 0px,
    mix-blend-mode: .overlay,
    fill: colors.primitives.white70,
    contents: Strings.demoProject.welcomeTitle,
    font-size: 24,
    font-style: "Medium",
    align: .center
  }
}

demoProjectContent = frame {
  left: 903px,
  top: 0px,
  width: 831px,
  height: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 24px},
  fill: rgb(92.94%, 92.94%, 92.1569%),
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 5px),
      blur-radius: 10px,
      spread: 0px
    }
  },
  corner-radius: 0px,
  padding: 56px,
  children: [welcomeIntro, layerTypesOverview, projectResourcesOverview],

  layerTypesOverview = frame {
    width: 100%,
    layout: {item-gap: 8px},
    fill: rgb(7.0588%, 7.0588%, 7.0588%),
    corner-radius: 12px,
    corner-smoothing: 0.6,
    padding: 8px,
    children: [controlsOverviewCard, blocksOverviewCard, screensOverviewCard]
  }
}

welcomeIntro = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [welcomeDescription, projectStructureOverview],

  welcomeDescription = text {
    left: -46.02px,
    top: -161px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: Strings.demoProject.welcomeDescription,
    font-size: 24,
    font-style: "Medium",
    line-height: 1.3
  }

  projectStructureOverview = text {
    left: 0px,
    top: 40px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: Strings.demoProject.structureDescription,
    font-size: 14,
    line-height: 1.5
  }
}

controlsOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [controlsLabel, controlsDescription],

  controlsLabel = text {
    left: 69px,
    top: 45px,
    fill: colors.primitives.white,
    contents: Strings.demoProject.controlsTitle,
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  controlsDescription = text {
    left: 0px,
    top: 65px,
    width: 100%,
    fill: colors.primitives.white70,
    contents: Strings.demoProject.controlsDescription,
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

blocksOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [blocksLabel, blocksDescription],

  blocksLabel = text {
    left: 162.6667px,
    top: -17px,
    fill: colors.primitives.white,
    contents: Strings.demoProject.blocksTitle,
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  blocksDescription = text {
    left: 0px,
    top: 71px,
    width: 100%,
    fill: colors.primitives.white70,
    contents: Strings.demoProject.blocksDescription,
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

screensOverviewCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {direction: .column, item-gap: 10px},
  corner-radius: Radius.radius.small,
  padding: Spacing.padding.large,
  children: [screensLabel, screensDescription],

  screensLabel = text {
    left: 162.6667px,
    top: -25.5px,
    fill: colors.primitives.white,
    contents: Strings.demoProject.screensTitle,
    font-size: Typography.fontSize.small,
    font-style: "SemiBold",
    letter-spacing: 10%
  }

  screensDescription = text {
    left: 54px,
    top: 0px,
    width: 100%,
    height: .auto,
    fill: colors.primitives.white70,
    contents: Strings.demoProject.screensDescription,
    font-size: Typography.fontSize.medium,
    line-height: 1.5
  }
}

projectResourcesOverview = frame {
  width: 100%,
  layout: {direction: .column, align-items: .center, item-gap: 12px},
  overflow: .visible,
  children: [assetFoldersDescription, tokensFolderDescription],

  assetFoldersDescription = text {
    left: 20px,
    top: 60px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: Strings.demoProject.assetsDescription,
    font-size: 14,
    line-height: 1.5
  }

  tokensFolderDescription = text {
    left: 20px,
    top: 301px,
    width: 100%,
    fill: colors.palette.tealDark,
    contents: Strings.demoProject.tokensDescription,
    font-size: 14,
    line-height: 1.5
  }
}
