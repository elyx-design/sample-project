import "tokens/strings.elyx" as Strings
import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button

export settingRow = frame {
  left: 20px,
  top: 92px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  fill: Colors.colors.black95,
  corner-radius: Radius.radius.medium,
  padding: Spacing.padding.medium,
  children: [copy, action]
}

copy = frame {
  layout: {direction: .column, item-gap: Spacing.gap.xsmall},
  children: [title, description]
}

title = text {
  fill: Colors.colors.black20,
  contents: Strings.componentDefaults.label,
  font-size: Spacing.fontSize.medium,
  font-style: "Medium"
}

description = text {
  fill: Colors.colors.blackAlpha70,
  contents: Strings.componentDefaults.subtitle,
  font-size: Spacing.fontSize.small
}

action = button.medium {
  left: 500px,
  top: 105px,

  button.mediumLabel {
    contents: Strings.componentDefaults.label
  }
}
