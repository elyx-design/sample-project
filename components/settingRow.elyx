import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "components/button.elyx" as button

export settingRow = frame {
  left: 20px,
  top: 92px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  fill: Colors.colors.black95,
  corner-radius: Radius.radius.medium,
  padding: Spacing.spacing.paddingM,
  children: [copy, action]
}

copy = frame {layout: {direction: .column, item-gap: 4px}, children: [title, description]}

title = text {
  fill: Colors.colors.black20,
  contents: "Label",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Medium"
}

description = text {
  fill: Colors.colors.blackAlpha70,
  contents: "Subtitle",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

action = button.medium {
  left: 500px,
  top: 105px,

  button.mediumLabel {
    contents: "Label"
  }
}
