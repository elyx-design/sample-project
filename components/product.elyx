export product = frame {
  left: 409.71px,
  top: 494px,
  width: 155px,
  height: 211px,
  overflow: .visible,
  children: coverOne
}

coverOne = shape {
  left: 0px,
  top: 0px,
  width: 155px,
  height: 211px,
  fill: {image: {ref: book1}},
  type: .rect
}

@variant
productFive = product {
  left: 1162px,
  top: 494px,
  overrides: [insert(coverFive, after = .nil), remove(coverOne)]
}

