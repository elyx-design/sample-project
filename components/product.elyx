import "images/misc/book1.png" as book1
import "images/misc/book2.png" as book2
import "images/misc/book3.png" as book3
import "images/misc/book4.png" as book4
import "images/misc/book5.png" as book5

export product = frame {
  left: 409.71px,
  top: 494px,
  width: 155px,
  height: 211px,
  overflow: .visible,
  children: coverOne,

  coverOne = shape {
    left: 0px,
    top: 0px,
    width: 155px,
    height: 211px,
    fill: {image: {ref: book1}},
    type: .rect
  }
}

@variant
productFive = frame : product {
  left: 1162px,
  top: 494px,
  overrides: [insert(coverFive, after = .nil), remove(product.coverOne)],

  coverFive = shape {
    left: 0px,
    top: 0px,
    width: 155px,
    height: 211px,
    fill: {image: {ref: book5}},
    type: .rect
  }
}

