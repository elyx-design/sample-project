import "tokens/strings.elyx" as Strings
import "components/avatar.elyx" as avatar
import "tokens/colors.elyx" as colors
import "tokens/radius.elyx" as radius
import "images/profileImgs/005.jpg" as module
import "tokens/spacing.elyx" as spacing
import "images/profileImgs/001.jpg" as module4

export base = frame {
  left: 602px,
  top: 476px,
  layout: {align-items: .center, item-gap: spacing.gap.small},
  overflow: .visible,
  children: [profileAvatar, message]
}

profileAvatar = avatar.smallPhoto {
  left: 0px,
  top: 0px,

  avatar.smallImage {
    fill[0].image.ref: module4
  }

  avatar.smallStatus {
    display: .hidden
  }
}

message = frame {
  left: 65px,
  top: 0px,
  width: .auto,
  height: spacing.size.medium,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.colors.blackAlpha25,
  corner-radius: radius.radius.full,
  padding-left: spacing.padding.medium,
  padding-right: spacing.padding.medium,
  children: messageText
}

messageText = text {left: 0px, top: 0px, fill: .black, contents: Strings.componentDefaults.chatText}

@variant
user = base {
  left: 602px,
  top: 560px,
  layout.justify-content: .end,
  overrides: [move(message, after = .nil)],

  profileAvatar.avatar.smallImage {
    fill[0].image.ref: module
  }

  message {
    fill[0].color: colors.colors.black20
  }

  message.messageText {
    fill[0].color: colors.colors.white100
  }
}

@variant
liveBubble = base {
  left: 602px,
  top: 644px,
  layout.align-items: .start,
  layout.direction: .column,
  layout.item-gap: spacing.gap.xsmall,
  layout.justify-content: .start,
  overrides: [
    insert(GroupedStack, after = .nil),
    insert(messageText_2, after = GroupedStack),
    remove(message),
    remove(profileAvatar)
  ]
}

messageText_2 = text {
  left: 0px,
  top: 30.5px,
  width: 100%,
  fill: .black,
  contents: Strings.componentDefaults.chatText,
  font-size: spacing.fontSize.small
}

GroupedStack = frame {
  width: 100%,
  layout: {align-items: .end, item-gap: spacing.gap.small},
  overflow: .visible,
  children: [messageText_3, messageText_4]
}

messageText_3 = text {
  left: 0px,
  top: 5.5px,
  fill: .black,
  contents: Strings.componentDefaults.name,
  font-style: "Bold"
}

messageText_4 = text {
  left: 20px,
  top: 25.5px,
  fill: colors.colors.blackAlpha25,
  contents: "14:15",
  font-size: spacing.fontSize.small,
  font-style: "Medium"
}
