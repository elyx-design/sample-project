import "tokens/spacing.elyx" as spacing
import "icons/24 pixels/direct-24.svg" as direct24
import "tokens/colors.elyx" as colors

export track = frame {
  name: "Video Track",
  left: 639.5px,
  top: 518px,
  width: 361px,
  height: spacing.spacing.heightM,
  layout: {justify-content: .space-between, align-items: .center},
  fill: rgb(67.48%, 100%, 0%),
  corner-radius: 8px,
  padding: [4px, 0px],
  children: [content, endHandle]
}

content = frame {
  name: "Track Content",
  height: 100%,
  layout: {align-items: .center},
  children: [startHandle, label]
}

startHandle = frame {
  name: "Start Trim Handle",
  left: 281px,
  top: 24px,
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: startGrip
}

startGrip = shape {
  name: "Start Grip",
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: 999px,
  type: .rect
}

label = frame {
  name: "Track Label",
  height: 100%,
  layout: {align-items: .center, item-gap: 4px},
  children: [typeIcon, trackName]
}

typeIcon = icon {
  name: "Track Type Icon",
  left: 810px,
  top: 522px,
  width: 24px,
  height: 24px,
  fill: colors.colors.blackAlpha50,
  contents: direct24
}

trackName = text {
  name: "Track Name",
  left: 263px,
  top: 553px,
  fill: colors.colors.blackAlpha50,
  contents: "Track name",
  font-size: 12,
  font-style: "SemiBold"
}

endHandle = frame {
  name: "End Trim Handle",
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: endGrip
}

endGrip = shape {
  name: "End Grip",
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: 999px,
  type: .rect
}
