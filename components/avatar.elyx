import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "images/profileImgs/005.jpg" as module

export small = frame {
  name: "Avatar S",
  left: -94px,
  top: 10px,
  width: 36px,
  height: 36px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: Radius.radius.max,
  overflow: .visible,
  children: [smallBackground, smallInitials, smallStatus]
}

smallBackground = shape {
  name: "Avatar Background",
  left: 0px,
  top: 0px,
  width: 36px,
  height: 36px,
  ignore-stack: .true,
  fill: Colors.colors.black90,
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

smallInitials = text {
  name: "Avatar Initials",
  left: 10px,
  top: 10.5px,
  width: 16px,
  height: 15px,
  fill: Colors.colors.black20,
  contents: "JC",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "SemiBold"
}

smallStatus = status {
  name: "Online Status",
  left: 26.85px,
  top: 26.83px,
  ignore-stack: .true,
  border[0].width: 2px
}

export status = shape {
  name: "Avatar Status",
  left: -94px,
  top: -72.12px,
  width: 8px,
  height: 8px,
  fill: rgb(0%, 92.12%, 0%),
  border: {color: Colors.colors.white100, position: .outside},
  type: .ellipse
}

@variant(Away)
statusAway = status {left: -58px, top: -72px, fill[0].color: rgb(100%, 65.3497%, 0%)}

@variant("Avatar S (Photo)")
smallPhoto = small {
  left: -40px,
  top: 10px,
  overrides: [insert(smallImage, after = .nil), remove(smallInitials), remove(smallBackground)]
}

export medium = frame {
  name: "Avatar M",
  left: -94px,
  top: 94px,
  width: 72px,
  height: 72px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  overflow: .visible,
  children: [mediumBackground, mediumInitials, mediumStatus]
}

mediumBackground = shape {
  name: "Avatar Background",
  left: 0px,
  top: 0px,
  width: 72px,
  height: 72px,
  ignore-stack: .true,
  fill: Colors.colors.black90,
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

mediumInitials = text {
  name: "Large Avatar Initials",
  left: 21.5px,
  fill: Colors.colors.black20,
  contents: "JC",
  font-size: 22,
  font-family: "Inter",
  font-style: "SemiBold"
}

mediumStatus = status {
  name: "Online Status",
  left: 56.85px,
  top: 56.83px,
  ignore-stack: .true,
  border[0].width: 2px
}

@variant("Avatar M Variant")
mediumPhoto = medium {
  left: -4px,
  top: 94px,
  layout.include-borders: .true,
  overrides: [insert(mediumImage, after = .nil), remove(mediumInitials), remove(mediumBackground)]
}

mediumImage = shape {
  name: "Avatar Photo",
  left: 0px,
  top: 0px,
  width: 72px,
  height: 72px,
  ignore-stack: .true,
  fill: {image: {ref: module}},
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

smallImage = shape {
  name: "Avatar Photo",
  left: 0px,
  top: 0px,
  width: 36px,
  height: 36px,
  ignore-stack: .true,
  fill: {image: {ref: module}},
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}
