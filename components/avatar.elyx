import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius
import "images/profileImgs/005.jpg" as module

export small = frame {
  left: -94px,
  top: 10px,
  width: 36px,
  height: 36px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: Radius.radius.max,
  overflow: .visible,
  children: [smallBackground, smallInitials, smallStatus]
}

smallBackground = shape {
  left: 0px,
  top: 0px,
  width: 36px,
  height: 36px,
  ignore-stack: .true,
  fill: Colors.colors.black90,
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

smallInitials = text {
  left: 10px,
  top: 10.5px,
  width: 16px,
  height: 15px,
  fill: Colors.colors.black20,
  contents: "JC",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "SemiBold"
}

smallStatus = status {left: 26.85px, top: 26.83px, ignore-stack: .true, border[0].width: 2px}

export status = shape {
  left: -94px,
  top: -72.12px,
  width: 8px,
  height: 8px,
  fill: Colors.colors.status-visible,
  border: {color: Colors.colors.white100, position: .outside},
  type: .ellipse
}

@variant
statusAway = status {left: -58px, top: -72px, fill[0].color: Colors.colors.status-away}

@variant
smallPhoto = small {
  left: -4px,
  top: 10px,
  overrides: [insert(smallImage, after = .nil), remove(smallInitials), remove(smallBackground)]
}

export medium = frame {
  left: -94px,
  top: 94px,
  width: 72px,
  height: 72px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  overflow: .visible,
  children: [mediumBackground, mediumInitials, mediumStatus]
}

mediumBackground = shape {
  left: 0px,
  top: 0px,
  width: 72px,
  height: 72px,
  ignore-stack: .true,
  fill: Colors.colors.black90,
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

mediumInitials = text {
  left: 21.5px,
  fill: Colors.colors.black20,
  contents: "JC",
  font-size: 22,
  font-family: "Inter",
  font-style: "SemiBold"
}

mediumStatus = status {left: 56.85px, top: 56.83px, ignore-stack: .true, border[0].width: 2px}

@variant
mediumPhoto = medium {
  left: -4px,
  top: 94px,
  layout.include-borders: .true,
  overrides: [insert(mediumImage, after = .nil), remove(mediumInitials), remove(mediumBackground)]
}

mediumImage = shape {
  left: 0px,
  top: 0px,
  width: 72px,
  height: 72px,
  ignore-stack: .true,
  fill: {image: {ref: module}},
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

smallImage = shape {
  left: 0px,
  top: 0px,
  width: 36px,
  height: 36px,
  ignore-stack: .true,
  fill: {image: {ref: module}},
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

export xsmall = frame {
  left: -94px,
  top: 235px,
  width: 28px,
  height: 28px,
  overflow: .visible,
  children: [color, smallInitials_2, smallStatus_2]
}

color = shape {
  left: 0px,
  top: 0px,
  width: 28px,
  height: 28px,
  ignore-stack: .true,
  fill: Colors.colors.black95,
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

smallInitials_2 = text {
  left: 6px,
  top: 7px,
  width: 16px,
  height: 15px,
  fill: Colors.colors.black20,
  contents: "JC",
  font-size: 11,
  font-family: "Inter",
  font-style: "SemiBold",
  align: .center
}

smallStatus_2 = status {left: 20px, top: 20px, ignore-stack: .true, border[0].width: 2px}

@variant
xsmallVariant = xsmall {
  left: -4px,
  top: 235px,
  overrides: [insert(photoBG, after = .nil), remove(color)],

  smallInitials_2 {
    display: .hidden
  }
}

photoBG = shape {
  left: 0px,
  top: 0px,
  width: 28px,
  height: 28px,
  ignore-stack: .true,
  fill: {image: {ref: module}},
  border: {color: Colors.colors.white100, width: 2px, position: .outside},
  type: .ellipse
}

@variant
statusOffline = status {left: -22px, top: -72px, fill[0].color: Colors.colors.black80}
