import "tokens/strings.elyx" as Strings
import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "icons/20 pixels/activity-20.svg" as activity20

export base = frame {
  left: 862px,
  top: 603px,
  width: 100%,
  height: Spacing.size.small,
  layout: {justify-content: .space-between, align-items: .center},
  corner-radius: Radius.radius.full,
  padding: [Spacing.padding.xsmall, Spacing.padding.small],
  children: content
}

content = frame {
  width: .auto,
  height: .auto,
  layout: {align-items: .center, item-gap: Spacing.gap.small},
  children: [rowIcon, label]
}

rowIcon = icon {left: 0px, top: 0px, width: 20px, height: 20px, contents: activity20}

label = text {
  left: 87px,
  top: 6.5px,
  width: .auto,
  height: .auto,
  fill: Colors.colors.black20,
  contents: Strings.componentDefaults.item,
  font-size: Spacing.fontSize.small
}

@variant
selected = base {left: 862px, top: 679px, fill[0].color: Colors.colors.black95}
