import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "icons/20 pixels/activity-20.svg" as activity20

export base = frame {
  name: "List Row",
  left: 862px,
  top: 603px,
  width: 100%,
  height: Spacing.spacing.heightS,
  layout: {justify-content: .space-between, align-items: .center},
  corner-radius: Radius.radius.max,
  padding: [4px, 8px],
  children: content
}

content = frame {
  name: "Row Content",
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: 8px},
  children: [icon, label]
}

icon = icon {name: "Row Icon", left: 0px, top: 0px, width: 20px, height: 20px, contents: activity20}

label = text {
  name: "Row Label",
  left: 87px,
  top: 6.5px,
  width: .auto,
  height: 15px,
  fill: Colors.colors.black20,
  contents: "Item",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}

@variant(Selected)
selected = base {left: 862px, top: 679px, fill[0].color: Colors.colors.black95}
