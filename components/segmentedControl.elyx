import "tokens/strings.elyx" as Strings
import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "tokens/typography.elyx" as Typography
import "tokens/radius.elyx" as Radius

export medium = frame {
  left: 623px,
  top: 656px,
  width: 100%,
  height: Spacing.size.medium,
  layout: {justify-content: .center, align-items: .center},
  fill: Colors.controls.surface,
  corner-radius: Radius.radius.full,
  padding: Spacing.padding.xsmall,
  children: [leadingSegment, middleSegment, trailingSegment]
}

leadingSegment = frame : mediumSelected {left: 0px, top: 10px, width: 100%}

middleSegment = frame : mediumInactive {left: 0px, top: 30px, width: 100%}

trailingSegment = frame : mediumInactive {left: 0px, top: 30px, width: 100%}

export mediumSelected = frame {
  left: 623px,
  top: 736px,
  width: .auto,
  height: Spacing.size.small,
  layout: {justify-content: .center, align-items: .center},
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [stop(0%, Colors.gradients.surfaceTop), stop(100%, Colors.gradients.surfaceBottom)]
    }
  },
  border: {color: Colors.theme.contrastAlpha25, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: Colors.primitives.blackAlpha05,
      offset: point(0px, 1px),
      blur-radius: 0px,
      spread: 0px,
      style: .smooth,
      visible: .false
    }
  },
  corner-radius: Radius.radius.full,
  overflow: .visible,
  padding-left: Spacing.padding.medium,
  padding-right: Spacing.padding.medium,
  children: label
}

label = text {
  left: 0px,
  top: 0px,
  fill: Colors.theme.contrastStrongest,
  contents: Strings.componentDefaults.item,
  font-size: Typography.fontSize.small,
  font-style: "Medium"
}

@variant
mediumInactive = frame : mediumSelected {
  left: 623px,
  top: 812px,
  border[0].visible: .false,
  fill[0]: .nil,

  label {
    fill[0].color: Colors.theme.contrastAlpha50
  }
}

@variant
small = frame : medium {
  left: 913px,
  top: 656px,
  width: .auto,
  height: .auto,
  fill[0].color: Colors.theme.contrastFaint,
  overrides: [insert(smallLeadingSegment, after = .nil), remove(leadingSegment)],

  @use-variant(smallInactive)
  trailingSegment {}

  @use-variant(smallInactive)
  middleSegment {}
}

@variant
smallInactive = frame : mediumSelected {
  left: 726px,
  top: 812px,
  height: .auto,
  padding-top: Spacing.padding.xsmall,
  padding-bottom: Spacing.padding.xsmall,
  border[0]: .nil,
  fill[0]: .nil,
  shadow[0]: .nil,

  label {
    fill[0].color: Colors.theme.contrastAlpha50
  }
}

@variant
smallSelected = frame : mediumSelected {
  left: 726px,
  top: 736px,
  height: .auto,
  padding-top: Spacing.padding.xsmall,
  padding-bottom: Spacing.padding.xsmall
}

smallLeadingSegment = frame : smallSelected {left: 0px, top: 6.5px, width: 100%}
