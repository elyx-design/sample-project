import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius

export medium = frame {
  left: 623px,
  top: 656px,
  width: 100%,
  height: Spacing.spacing.heightM,
  layout: {justify-content: .center, align-items: .center},
  fill: Colors.colors.controlSurface,
  corner-radius: Radius.radius.max,
  padding: 4px,
  children: [leadingSegment, middleSegment, trailingSegment]
}

leadingSegment = mediumSelected {left: 0px, top: 10px, width: 100%}

middleSegment = mediumInactive {left: 0px, top: 30px, width: 100%}

trailingSegment = mediumInactive {left: 0px, top: 30px, width: 100%}

export mediumSelected = frame {
  left: 623px,
  top: 736px,
  width: .auto,
  height: Spacing.spacing.heightS,
  layout: {justify-content: .center, align-items: .center},
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [stop(0%, Colors.colors.white100), stop(100%, Colors.colors.black95)]
    }
  },
  border: {color: Colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: Colors.colors.blackAlpha05,
      offset: point(0px, 1px),
      blur-radius: 0px,
      spread: 0px,
      style: .smooth,
      visible: .false
    }
  },
  corner-radius: Radius.radius.max,
  overflow: .visible,
  padding-left: Spacing.spacing.paddingM,
  padding-right: Spacing.spacing.paddingM,
  children: label
}

label = text {
  left: 0px,
  top: 0px,
  fill: Colors.colors.black20,
  contents: "Item",
  font-size: 12,
  font-family: "Inter",
  font-style: "Medium"
}

@variant
mediumInactive = mediumSelected {
  left: 623px,
  top: 812px,
  border[0].visible: .false,
  fill[0]: .nil,

  label {
    fill[0].color: Colors.colors.blackAlpha50
  }
}

@variant
small = medium {
  left: 913px,
  top: 656px,
  width: .auto,
  height: .auto,
  fill[0].color: Colors.colors.black95,
  overrides: [insert(smallLeadingSegment, after = .nil), remove(leadingSegment)],

  @use-variant(smallInactive)
  trailingSegment {}

  @use-variant(smallInactive)
  middleSegment {}
}

@variant
smallInactive = mediumSelected {
  left: 726px,
  top: 812px,
  height: .auto,
  padding-top: 4px,
  padding-bottom: 4px,
  border[0]: .nil,
  fill[0]: .nil,
  shadow[0]: .nil,

  label {
    fill[0].color: Colors.colors.blackAlpha50
  }
}

@variant
smallSelected = mediumSelected {
  left: 726px,
  top: 736px,
  height: .auto,
  padding-top: 4px,
  padding-bottom: 4px
}

smallLeadingSegment = smallSelected {left: 0px, top: 6.5px, width: 100%}
