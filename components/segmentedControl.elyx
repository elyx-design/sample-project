// Define segmented control variants and states here.

import "tokens.elyx" as tokens

pub Frame_U = frame {
  name: "Segmented Control",
  left: 623px,
  top: 656px,
  width: 100%,
  height: tokens.controlHeight,
  layout: {justify-content: .center, align-items: .center},
  fill: tokens.colorSecondary,
  corner-radius: tokens.borderRadiusS,
  padding: 4px,
  children: [layer, Selected, Selected_D]
}

layer = Frame_l {left: 0px, top: 10px, width: 100%}

Selected = FrameVariant_p {left: 0px, top: 30px, width: 100%}

Selected_D = FrameVariant_p {left: 0px, top: 30px, width: 100%}

local Frame_l = frame {
  name: "Selected",
  left: 623px,
  top: 736px,
  width: .auto,
  height: 28px,
  layout: {justify-content: .center, align-items: .center},
  fill: .white,
  border: {color: tokens.colorTextFieldBorder, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 1px),
      blur-radius: 4px,
      spread: 0px,
      style: .smooth
    }
  },
  corner-radius: 6px,
  padding-left: tokens.paddingM,
  padding-right: tokens.paddingM,
  children: Item_P
}

Item_P = text {
  name: "Item",
  left: 0px,
  top: 0px,
  fill: tokens.textColorDark,
  contents: "Item",
  font-size: tokens.labelSizeML,
  font-family: "Inter",
  font-style: "Medium"
}

@variant(Inactive)
FrameVariant_p = Frame_l {
  left: 623px,
  top: 812px,
  border[0].visible: .false,
  fill[0].visible: .false,

  Item_P {
    fill[0].color: rgb(9.8%, 9.8%, 9.8%, 80%)
  }
}
