import "tokens/colors.elyx" as Colors
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "components/avatar.elyx" as userAvatar
import "components/header.elyx" as header

export card = frame {
  left: 16px,
  top: 888px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: Spacing.spacing.paddingM},
  fill: rgb(94.9997%, 94.9997%, 94.9997%),
  corner-radius: Radius.radius.m,
  padding: Spacing.spacing.paddingM
}

export small = frame {
  height: Spacing.spacing.heightM,
  layout: {align-items: .center, item-gap: 12px},
  children: [smallAvatar, smallHeader]
}

smallAvatar = userAvatar.smallPhoto {left: -7.5px, top: 28px}

smallHeader = header.smallLeft {
  left: -8.5px,
  top: -18px,

  header.smallSubtitle {
    contents: "nora@mail.com"
  }

  header.smallTitle {
    contents: "Nora Harper",
    font-style: "Bold"
  }
}

@variant
UserSummarySVariant = small {
  left: 140px,
  top: -18px,
  height: .auto,
  layout.direction: .column,

  @use-variant(header.smallCenter)
  smallHeader {}
}

export medium = frame {
  left: -67px,
  top: 192px,
  height: 72px,
  layout: {justify-content: .end, align-items: .center, item-gap: 20px},
  children: [mediumAvatar, mediumHeader]
}

mediumAvatar = userAvatar.mediumPhoto {left: 0px, top: 0px}

mediumHeader = header.mediumLeft {
  left: 83px,
  top: 10px,

  header.mediumSubtitle {
    contents: "nora@mail.com"
  }

  header.mediumTitle {
    contents: "Nora Harper",
    font-style: "Bold"
  }
}

@variant
UserSummaryMVariant = medium {
  left: 229px,
  top: 192px,
  height: .auto,
  layout.direction: .column,

  @use-variant(header.mediumCenter)
  mediumHeader {}
}
