import "tokens/colors.elyx" as colors
import "tokens/spacing.elyx" as spacing
import "tokens/radius.elyx" as radius
import "icons/20 pixels/star-20.svg" as star20
import "icons/20 pixels/close-20.svg" as close20
import "icons/20 pixels/status-20.svg" as status20

export base = frame {
  left: 542px,
  top: 548px,
  height: spacing.spacing.heightS,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.colors.whiteAlpha50,
  border: {color: colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  filter: {type: .background-blur, radius: 40px},
  corner-radius: radius.radius.max,
  padding-left: 12px,
  padding-right: 12px,
  children: label
}

label = text {
  left: 0px,
  top: 0px,
  fill: colors.colors.blackAlpha50,
  contents: "Label",
  font-size: 12,
  font-style: "Bold"
}

@variant
labelAndClose = base {
  left: 542px,
  top: 700px,
  padding-right: 8px,
  layout.item-gap: 4px,
  overrides: [insert(closeIcon, after = label)]
}

@variant
status = base {
  left: 545px,
  top: 776px,
  padding-left: 4px,
  overrides: [insert(statusIcon, after = .nil)]
}

statusIcon = icon {
  left: 525px,
  top: 635px,
  width: 20px,
  height: 20px,
  fill: colors.colors.status-visible,
  contents: status20
}

closeIcon = icon {
  left: 525px,
  top: 635px,
  width: 20px,
  height: 20px,
  fill: colors.colors.blackAlpha50,
  contents: close20
}

@variant
iconAndLabel = base {
  left: 542px,
  top: 624px,
  padding-left: 8px,
  layout.item-gap: 4px,
  overrides: [insert(tagIcon, after = .nil)]
}

tagIcon = icon {
  left: 525px,
  top: 635px,
  width: 20px,
  height: 20px,
  fill: colors.colors.blackAlpha50,
  contents: star20
}
