import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography

export mediumLeft = frame {
  left: 20px,
  top: 20px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 2px},
  children: [mediumTitle, mediumSubtitle]
}

mediumTitle = text {
  fill: Colors.colors.black20,
  contents: "Title",
  font-size: 20,
  font-family: "Inter",
  font-style: "SemiBold"
}

mediumSubtitle = text {
  width: 100%,
  fill: Colors.colors.blackAlpha70,
  contents: "Subtitle",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular",
  line-height: 1.5
}

@variant
mediumCenter = mediumLeft {
  left: 20px,
  top: 117px,
  layout.align-items: .center,

  mediumSubtitle {
    fill[0].color: rgb(9.8%, 9.8%, 9.8%, 70%),
    align: .center
  }

  mediumTitle {
    align: .center
  }
}

