import "tokens/colors.elyx" as colors
import "icons/12 pixels/chevron-down-12.svg" as chevrondown12
import "components/button.elyx" as button

export appTopBar = frame {
  left: 707px,
  top: 518px,
  width: 417px,
  height: 48px,
  layout: {justify-content: .space-between, align-items: .center},
  fill: colors.colors.white100,
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha25,
      offset: point(0px, 0.5px),
      blur-radius: 0px,
      spread: 0px
    }
  },
  padding: [0px, 20px],
  children: [fileSelector, actions]
}

fileSelector = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: 4px},
  children: [fileName, chevron]
}

fileName = text {left: 0px, top: 0px, fill: .black, contents: "File Name", font-style: "SemiBold"}

chevron = icon {left: 789px, top: 545px, width: 12px, height: 12px, contents: chevrondown12}

actions = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 16px},
  children: [tools, primaryButton]
}

tools = frame {
  height: 100%,
  layout: {align-items: .center},
  children: [leadingTool, middleTool, trailingTool]
}

leadingTool = button.smallIcon {left: 287px, top: 21px}

middleTool = button.smallIcon {left: 307px, top: 41px}

trailingTool = button.smallIcon {left: 335px, top: 41px}

primaryButton = button.smallPrimary {left: 606px, top: 542px, width: 62px}
