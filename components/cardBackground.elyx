import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "tokens/colors.elyx" as colors
import "tokens/colors.dark.elyx" as colorsdark

@with-context(theme="dark")
__canvas__

export base = frame {
  left: 80px,
  top: 467px,
  width: 100%,
  height: .auto,
  min-width: 100px,
  min-height: 60px,
  layout: {direction: .column, item-gap: Spacing.padding.xlarge},
  fill: colorsdark.darkColors.white100,
  border: {color: colorsdark.darkColors.blackAlpha25, width: 0.5px, position: .outside},
  shadow: {
    drop-shadow: {
      color: colors.colors.blackAlpha10,
      offset: point(0px, 5px),
      blur-radius: 5px,
      spread: 0px
    }
  },
  corner-radius: Radius.radius.xlarge,
  padding: Spacing.padding.xxlarge
}

@variant
transparent = frame : base {
  left: 80px,
  top: 575px,
  fill[0].color: colorsdark.darkColors.whiteAlpha50,
  filter[0].radius: 40px,
  filter[0].type: .background-blur
}

@variant
none = frame : base {left: 80px, top: 683px, border[0]: .nil, fill[0]: .nil, shadow[0]: .nil}

@variant
transparentFullRadius = frame : base {
  left: 275px,
  top: 575px,
  corner-radius: Radius.radius.full,
  fill[0].color: colorsdark.darkColors.whiteAlpha50,
  filter[0].radius: 40px,
  filter[0].type: .background-blur
}

@variant
solidFullRadius = frame : base {left: 275.05px, top: 467px, corner-radius: Radius.radius.full}
