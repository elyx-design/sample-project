export stats = frame {
  left: 396px,
  top: 630px,
  width: 100%,
  min-width: 360px,
  layout: {direction: .column, justify-content: .center, item-gap: Spacing.gap.small},
  children: [topDivider, row, bottomDivider]
}

topDivider = frame : divider.horizontal {
  left: 0px,
  top: 0px,
  width: 100%,

  divider.horizontalLine {
    fill[0].color: rgb(0%, 0%, 0%, 25%)
  }
}

