import "tokens/spacing.elyx" as spacing
import "tokens/colors.elyx" as colors
import "tokens/radius.elyx" as radius
import "images/background/bird.jpg" as bird

export base = frame {
  left: 639px,
  top: 492px,
  width: 475px,
  height: spacing.spacing.heightG,
  layout: {justify-content: .space-evenly, align-items: .center},
  fill: rgb(83.53%, 96.25%, 0%),
  corner-radius: 8px,
  padding: [4px, 0px],
  children: [leadingHandle, filmstrip, trailingHandle]
}

leadingHandle = frame {
  left: 281px,
  top: 24px,
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: leadingGrip
}

leadingGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: colors.colors.blackAlpha25,
  corner-radius: radius.radius.max,
  type: .rect
}

filmstrip = frame {
  width: 100%,
  height: 100%,
  layout: {align-items: .center, item-gap: 1px},
  corner-radius: 4px,
  children: [frameOne, frameTwo, frameThree]
}

frameOne = shape {
  left: 0px,
  top: 0px,
  width: 100%,
  height: spacing.spacing.heightG,
  fill: {image: {ref: bird}},
  type: .rect
}

frameTwo = shape {
  left: 0px,
  top: 20px,
  width: 100%,
  height: spacing.spacing.heightG,
  fill: {image: {ref: bird}},
  type: .rect
}

frameThree = shape {
  left: 20px,
  top: 40px,
  width: 100%,
  height: spacing.spacing.heightG,
  fill: {image: {ref: bird}},
  type: .rect
}

trailingHandle = frame {
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: trailingGrip
}

trailingGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: colors.colors.blackAlpha25,
  corner-radius: radius.radius.max,
  type: .rect
}
