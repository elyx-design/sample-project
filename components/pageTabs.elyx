import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius

export pageTabs = frame {
  left: 40px,
  top: 110px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: Spacing.spacing.s},
  fill: .white,
  border: {color: rgb(0%, 0%, 0%, 8%), position: .outside},
  corner-radius: Radius.radius.max,
  padding: Spacing.spacing.paddingS,
  children: [profileTab, accessTab, billingTab]
}

profileTab = selectedTab {left: 46px, top: 23px}

accessTab = inactiveTab {
  left: 66px,
  top: 43px,

  label {
    contents: "Access"
  }
}

billingTab = inactiveTab {
  left: 138px,
  top: 43px,

  label {
    contents: "Billing"
  }
}

export selectedTab = frame {
  left: 40px,
  top: 217px,
  width: .auto,
  height: Spacing.spacing.heightS,
  layout: {justify-content: .center, align-items: .center},
  fill: Colors.colors.black40,
  corner-radius: Radius.radius.max,
  padding: [0px, Spacing.spacing.paddingM],
  children: label
}

label = text {
  fill: rgb(98.9987%, 98.9987%, 98.9987%),
  contents: "Profile",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Medium"
}

@variant("Profile Tab Variant")
inactiveTab = selectedTab {
  left: 154px,
  top: 217px,
  fill[0].visible: .false,

  label {
    fill[0].color: Colors.colors.black20
  }
}
