import "tokens/spacing.elyx" as spacing
import "icons/24 pixels/direct-24.svg" as direct24
import "tokens/colors.elyx" as colors
import "icons/24 pixels/calendar-24.svg" as calendar24

export track = frame {
  left: 639.5px,
  top: 518px,
  width: 361px,
  height: spacing.spacing.heightM,
  layout: {justify-content: .space-between, align-items: .center},
  fill: rgb(67.48%, 100%, 0%),
  border: {color: colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  corner-radius: 8px,
  padding: [4px, 0px],
  children: [content, endHandle]
}

content = frame {
  width: 100%,
  height: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: [left, label_2]
}

left = frame {
  height: 100%,
  layout: {align-items: .center},
  overflow: .visible,
  children: [startHandle, label]
}

startHandle = frame {
  left: 281px,
  top: 24px,
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: startGrip
}

startGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: 999px,
  type: .rect
}

label = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 2px},
  children: [typeIcon, trackName]
}

typeIcon = icon {
  left: 810px,
  top: 522px,
  width: 24px,
  height: 24px,
  fill: colors.colors.black20,
  contents: direct24
}

trackName = text {
  left: 263px,
  top: 553px,
  fill: colors.colors.black20,
  contents: "Track name",
  font-size: 12,
  font-style: "SemiBold"
}

label_2 = frame {
  left: 128px,
  top: 20px,
  height: 100%,
  layout: {align-items: .center, item-gap: 2px},
  children: [typeIcon_2, trackName_2]
}

typeIcon_2 = icon {
  left: 810px,
  top: 522px,
  width: 24px,
  height: 24px,
  fill: colors.colors.blackAlpha25,
  contents: calendar24
}

trackName_2 = text {
  left: 263px,
  top: 553px,
  fill: colors.colors.blackAlpha25,
  contents: "8 Jul",
  font-size: 12,
  font-style: "SemiBold"
}

endHandle = frame {
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: endGrip
}

endGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: 999px,
  type: .rect
}
