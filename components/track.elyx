import "tokens/spacing.elyx" as spacing
import "icons/24 pixels/direct-24.svg" as direct24
import "tokens/colors.elyx" as colors
import "icons/24 pixels/calendar-24.svg" as calendar24
import "tokens/radius.elyx" as radius

export track = frame {
  left: 639.5px,
  top: 518px,
  width: 361px,
  height: spacing.spacing.heightM,
  layout: {justify-content: .space-between, align-items: .center},
  fill: colors.colors.limeBright,
  border: {color: colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  corner-radius: radius.radius.xsmall,
  padding: [4px, 0px],
  children: [startHandle, content, endHandle]
}

startHandle = frame {
  left: 1.3469px,
  top: 32px,
  width: 12px,
  height: 28px,
  layout: {justify-content: .center, align-items: .center},
  children: startGrip
}

startGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: radius.radius.full,
  type: .rect
}

content = frame {
  width: 100%,
  height: 100%,
  layout: {justify-content: .space-between, align-items: .center},
  children: [left, dateLabel]
}

left = frame {height: .auto, layout: {align-items: .center}, overflow: .visible, children: label}

label = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 2px},
  children: [typeIcon, trackName]
}

typeIcon = icon {
  left: 810px,
  top: 522px,
  width: 24px,
  height: 24px,
  fill: colors.colors.black20,
  contents: direct24
}

trackName = text {
  left: 263px,
  top: 553px,
  fill: colors.colors.black20,
  contents: "Track name",
  font-size: 12,
  font-style: "SemiBold"
}

dateLabel = frame {
  left: 128px,
  top: 20px,
  height: .auto,
  layout: {align-items: .center, item-gap: 2px},
  children: [dateIcon, dateText]
}

dateIcon = icon {
  left: 810px,
  top: 522px,
  width: 24px,
  height: 24px,
  fill: colors.colors.blackAlpha25,
  contents: calendar24
}

dateText = text {
  left: 263px,
  top: 553px,
  fill: colors.colors.blackAlpha25,
  contents: "8 Jul",
  font-size: 12,
  font-style: "SemiBold"
}

endHandle = frame {
  width: 12px,
  height: 100%,
  layout: {justify-content: .center, align-items: .center},
  children: endGrip
}

endGrip = shape {
  left: 932px,
  top: 532px,
  width: 2px,
  height: 16px,
  fill: rgb(0%, 0%, 0%, 25%),
  corner-radius: radius.radius.full,
  type: .rect
}
