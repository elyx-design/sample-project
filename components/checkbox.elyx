import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius

anchor = frame {
  name: "Toggle Anchor",
  left: 2003px,
  top: 1069px,
  width: 0px,
  height: 0px,
  fill: .white,
  border: rgb(79.9972%, 79.9972%, 79.9972%)
}

export on = frame {
  name: "Toggle",
  left: 759px,
  top: 674px,
  width: 32px,
  height: 20px,
  layout: {justify-content: .end, align-items: .center},
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [stop(1.6464%, Colors.colors.black40), stop(100%, Colors.colors.black30)]
    }
  },
  border: {color: Colors.colors.black20, width: 0.5px},
  corner-radius: Radius.radius.max,
  padding: 3px,
  children: knob
}

knob = frame {
  name: "Toggle Knob",
  left: 23px,
  top: 3px,
  width: 14px,
  height: 14px,
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [stop(0%, Colors.colors.white100), stop(100%, Colors.colors.black95)]
    }
  },
  corner-radius: Radius.radius.max
}

@variant(Off)
off = on {
  left: 839px,
  top: 674px,
  fill[0].linear-gradient.stops[0].position: 0%,
  layout.justify-content: .start
}

@variant(Mixed)
mixed = on {left: 919px, top: 674px, layout.justify-content: .center}
