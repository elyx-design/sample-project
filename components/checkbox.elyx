import "tokens/colors.elyx" as Colors
import "tokens/radius.elyx" as Radius

anchor = frame {
  left: 2003px,
  top: 1069px,
  width: 0px,
  height: 0px,
  fill: .white,
  border: Colors.controls.border
}

export on = frame {
  left: 759px,
  top: 674px,
  width: 32px,
  height: 20px,
  layout: {justify-content: .end, align-items: .center},
  fill: {
    linear-gradient: {
      angle: 180deg,
      stops: [stop(0%, Colors.gradients.emphasisTop), stop(100%, Colors.gradients.emphasisBottom)]
    }
  },
  border: {color: Colors.primitives.blackAlpha10, width: 0.5px},
  corner-radius: Radius.radius.full,
  padding: 3px,
  children: knob,

  knob = frame {
    left: 23px,
    top: 3px,
    width: 14px,
    height: 14px,
    fill: {
      linear-gradient: {
        angle: 180deg,
        stops: [stop(0%, Colors.gradients.surfaceTop), stop(100%, Colors.gradients.surfaceBottom)]
      }
    },
    corner-radius: Radius.radius.full
  }
}

@variant
off = frame : on {
  left: 839px,
  top: 674px,
  fill[0].linear-gradient.stops[0].position: 0%,
  layout.justify-content: .start
}

@variant
mixed = frame : on {left: 919px, top: 674px, layout.justify-content: .center}
