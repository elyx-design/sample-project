// Define checkbox variants and states here.

import "tokens.elyx" as tokens

Frame = frame {
  name: "Frame",
  left: 2003px,
  top: 1069px,
  width: 0px,
  height: 0px,
  fill: .white,
  border: rgb(79.9972%, 79.9972%, 79.9972%)
}

local Frame_P = frame {
  name: "Toggle",
  left: 759px,
  top: 674px,
  width: 32px,
  height: 20px,
  layout: {justify-content: .end, align-items: .center},
  corner-radius: tokens.borderRadiusMax,
  padding: 3px,
  fill: tokens.colorPrimary,
  children: Frame_H
}

Frame_H = frame {
  name: "Frame",
  left: 23px,
  top: 3px,
  width: 14px,
  height: 14px,
  corner-radius: tokens.borderRadiusMax,
  fill: .white
}

@variant(Off)
FrameVariant_d = Frame_P {
  left: 839px,
  top: 674px,
  overrides: [set("layout.justify-content", .start), set("fill[0].color", tokens.colorSecondary)]
}

@variant(Mixed)
FrameVariant = Frame_P {left: 919px, top: 674px, overrides: [set("layout.justify-content", .center)]}
