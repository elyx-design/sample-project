import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors

export base = frame {
  name: "Slider",
  left: 702px,
  top: 539px,
  width: 203px,
  height: 6px,
  layout: {align-items: .center},
  fill: colors.colors.blackAlpha25,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: radius.radius.max,
  padding-left: 1px,
  padding-right: 1px,
  children: track
}

track = shape {
  name: "Slider Track",
  left: 0px,
  top: 0px,
  width: 40%,
  height: 4px,
  fill: colors.colors.white100,
  corner-radius: radius.radius.max,
  type: .rect
}

@variant("Slider thumb")
thumb = base {
  left: 702px,
  top: 591px,
  overflow: .visible,
  overrides: [insert(thumbHandle, after = track)],

  track {
    corner-radius: [999px, 0px, 0px, 999px]
  }
}

thumbHandle = shape {
  name: "Slider Thumb",
  left: 56.98px,
  top: -3.0789px,
  width: 10px,
  height: 10px,
  fill: colors.colors.whiteAlpha50,
  border: {color: colors.colors.whiteAlpha70, width: 2px},
  filter: {type: .background-blur, radius: 40px},
  type: .ellipse
}
