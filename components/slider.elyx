import "tokens/radius.elyx" as radius
import "tokens/colors.elyx" as colors

export base = frame {
  left: 702px,
  top: 539px,
  width: 203px,
  height: 6px,
  layout: {align-items: .center},
  fill: colors.colors.blackAlpha25,
  filter: {type: .background-blur, radius: 40px},
  corner-radius: radius.radius.full,
  padding-left: 1px,
  padding-right: 1px,
  children: track
}

track = shape {
  left: 0px,
  top: 0px,
  width: 40%,
  height: 4px,
  fill: colors.colors.white100,
  type: .rect,
  corner-radius: radius.radius.full
}

@variant
thumb = frame : base {
  left: 702px,
  top: 591px,
  overflow: .visible,
  overrides: [insert(handle_2, after = track)],

  track {
    corner-radius: [radius.radius.full, 0px, 0px, radius.radius.full]
  }
}

@variant
full = frame : base {
  left: 702px,
  top: 645px,
  overflow: .visible,
  overrides: [insert(handle_3, after = track)],

  track {
    width: 100%
  }
}

export handle = frame {left: 620px, top: 539px, width: 10px, height: 10px, children: thumbHandle_2}

thumbHandle_2 = shape {
  left: 0px,
  top: 0px,
  width: 10px,
  height: 10px,
  fill: colors.colors.whiteAlpha50,
  border: {color: colors.colors.whiteAlpha70, width: 2px},
  filter: {type: .background-blur, radius: 40px},
  type: .ellipse
}

handle_2 = frame : handle {left: 789px, top: 589px}

handle_3 = frame : handle {left: 796px, top: 643px}
