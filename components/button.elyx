// Define button variants and states here.

import "tokens.elyx" as tokens

pub Frame = frame {
  name: "Button",
  left: 962px,
  top: 689px,
  height: tokens.controlHeight,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: tokens.borderRadiusM,
  padding-left: tokens.paddingM,
  padding-right: tokens.paddingM,
  fill: tokens.colorSecondary,
  children: Button
}

Button = text {
  name: "Button",
  contents: "Button",
  left: 0px,
  top: 0px,
  font-family: "Inter",
  font-size: tokens.labelSizeML,
  font-style: "Medium",
  fill: tokens.textColorDark
}

@variant(Primary)
ButtonVariant_V = Frame {
  left: 1072px,
  top: 689px,
  overrides: [set("fill[0].color", tokens.colorPrimary), set(Button, "fill[0].color", tokens.textColorLight)]
}

@variant(Danger)
ButtonVariant_T = Frame {
  left: 1181px,
  top: 689px,
  overrides: [set("fill[0].color", tokens.colorDanger), set(Button, "fill[0].color", tokens.textColorLight)]
}

@variant(Pressed)
ButtonVariant_s = Frame {left: 962px, top: 769px, overrides: [set("fill[0].color", tokens.colorSecondaryPressed)]}

@variant("Primary Pressed")
ButtonVariant_E = Frame {
  left: 1072px,
  top: 769px,
  overrides: [set("fill[0].color", tokens.colorPrimaryPressed), set(Button, "fill[0].color", tokens.textColorLight)]
}

@variant("Danger Pressed")
Danger = Frame {
  left: 1181px,
  top: 769px,
  overrides: [set("fill[0].color", tokens.colorDangerPressed), set(Button, "fill[0].color", tokens.textColorLight)]
}
