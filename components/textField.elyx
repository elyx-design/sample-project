import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "icons/24 pixels/calendar-24.svg" as calendar24
import "components/button.elyx" as button
import "icons/20 pixels/arrowUp-20.svg" as arrowUp20
import "icons/24 pixels/search-24.svg" as search24
import "icons/20 pixels/emoji-20.svg" as emoji20

export base = frame {
  left: 869px,
  top: 770px,
  width: 100%,
  height: Spacing.spacing.heightM,
  layout: {align-items: .center, item-gap: 4px},
  fill: Colors.colors.white100,
  border: {color: Colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  corner-radius: Radius.radius.full,
  padding-left: Spacing.spacing.paddingM,
  padding-right: Spacing.spacing.paddingM,
  children: label
}

label = text {
  left: 0px,
  top: 0px,
  fill: Colors.colors.black20,
  contents: "Label",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

@variant
placeholder = base {
  left: 869px,
  top: 850px,

  label {
    fill[0].color: Colors.colors.black80
  }
}

@variant
focused = base {
  left: 869px,
  top: 930px,
  border[0].color: Colors.colors.black20,
  border[0].position: .center,
  border[0].width: 1.5px
}

@variant
error = base {
  left: 869px,
  top: 1010px,
  border[0].color: Colors.colors.red70,
  border[0].position: .center,
  border[0].width: 1.5px,

  label {
    fill[0].color: Colors.colors.red70
  }
}

@variant
withIcon = base {
  left: 989.73px,
  top: 770px,
  padding-left: 8px,
  padding-right: 8px,
  overrides: [insert(defaultIcon, after = .nil)]
}

@variant
iconPlaceholder = base {
  left: 988.65px,
  top: 850px,
  padding-left: 8px,
  padding-right: 8px,
  overrides: [insert(placeholderIcon, after = .nil)],

  label {
    fill[0].color: Colors.colors.black80
  }
}

placeholderIcon = icon {
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: search24
}

defaultIcon = icon {
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: calendar24
}

@variant
iconFocused = base {
  left: 987.9291px,
  top: 930px,
  padding-left: 8px,
  padding-right: 8px,
  border[0].color: Colors.colors.black20,
  border[0].width: 1.5px,
  overrides: [insert(focusedIcon, after = .nil)]
}

@variant
iconError = base {
  left: 988.2896px,
  top: 1010px,
  padding-left: 8px,
  padding-right: 8px,
  border[0].color: Colors.colors.red70,
  border[0].width: 1.5px,
  overrides: [insert(errorIcon, after = .nil)],

  label {
    fill[0].color: Colors.colors.red70
  }
}

focusedIcon = icon {
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: calendar24
}

errorIcon = icon {
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.red70,
  contents: calendar24
}

@variant
withButton = base {
  left: 1139px,
  top: 770px,
  padding-right: 4px,
  layout.justify-content: .space-between,
  overrides: [insert(submitButton, after = label)]
}

@variant
buttonPlaceholder = base {
  left: 1142.4px,
  top: 850px,
  padding-right: 4px,
  layout.justify-content: .space-between,
  overrides: [insert(GroupedStack, after = label)],

  label {
    fill[0].color: Colors.colors.black80
  }
}

submitButton = button.smallPrimaryRounded {
  left: 52.3381px,
  top: 5.85px,

  button.smallPrimaryRoundedIcon {
    contents: arrowUp20
  }
}

GroupedStack = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: 8px},
  overflow: .visible,
  children: [small, placeholderButton]
}

small = button.smallIcon {
  left: 59.6px,
  top: 6px,

  button.smallIconGlyph {
    contents: emoji20
  }
}

placeholderButton = button.smallPrimaryRounded {
  left: 52.3381px,
  top: 5.85px,

  button.smallPrimaryRoundedIcon {
    contents: arrowUp20
  }
}
