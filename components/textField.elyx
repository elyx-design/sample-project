import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius
import "icons/24 pixels/calendar-24.svg" as calendar24
import "components/button.elyx" as button
import "icons/20 pixels/arrowUp-20.svg" as arrowUp20

export base = frame {
  name: "Text Field",
  left: 869px,
  top: 770px,
  width: 100%,
  height: Spacing.spacing.heightM,
  layout: {align-items: .center},
  fill: Colors.colors.white100,
  border: {color: Colors.colors.blackAlpha25, width: 0.5px, position: .outside},
  corner-radius: Radius.radius.max,
  padding-left: Spacing.spacing.paddingM,
  padding-right: Spacing.spacing.paddingM,
  children: label
}

label = text {
  name: "Label",
  left: 0px,
  top: 0px,
  fill: Colors.colors.black20,
  contents: "Label",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

@variant(Placeholder)
placeholder = base {
  left: 869px,
  top: 850px,

  label {
    fill[0].color: Colors.colors.black80
  }
}

@variant(Focussed)
focused = base {
  left: 869px,
  top: 930px,
  border[0].color: Colors.colors.black20,
  border[0].position: .center,
  border[0].width: 1.5px
}

@variant(Error)
error = base {
  left: 869px,
  top: 1010px,
  border[0].color: Colors.colors.red70,
  border[0].position: .center,
  border[0].width: 1.5px,

  label {
    fill[0].color: Colors.colors.red70
  }
}

@variant("Text Field (Icon)")
withIcon = base {
  left: 989.73px,
  top: 770px,
  padding-left: 8px,
  padding-right: 8px,
  layout.item-gap: 4px,
  overrides: [insert(defaultIcon, after = .nil)]
}

@variant("Placeholder (Icon)")
iconPlaceholder = base {
  left: 988.65px,
  top: 850px,
  padding-left: 8px,
  padding-right: 8px,
  layout.item-gap: 4px,
  overrides: [insert(placeholderIcon, after = .nil)],

  label {
    fill[0].color: Colors.colors.black80
  }
}

placeholderIcon = icon {
  name: "Field Icon",
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: calendar24
}

defaultIcon = icon {
  name: "Field Icon",
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: calendar24
}

@variant("Focused (Icon)")
iconFocused = base {
  left: 987.9291px,
  top: 930px,
  padding-left: 8px,
  padding-right: 8px,
  border[0].color: Colors.colors.black20,
  border[0].width: 1.5px,
  layout.item-gap: 4px,
  overrides: [insert(focusedIcon, after = .nil)]
}

@variant("Error (Icon)")
iconError = base {
  left: 988.2896px,
  top: 1010px,
  padding-left: 8px,
  padding-right: 8px,
  border[0].color: Colors.colors.red70,
  border[0].width: 1.5px,
  layout.item-gap: 4px,
  overrides: [insert(errorIcon, after = .nil)],

  label {
    fill[0].color: Colors.colors.red70
  }
}

focusedIcon = icon {
  name: "Field Icon",
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.black20,
  contents: calendar24
}

errorIcon = icon {
  name: "Field Icon",
  left: 981px,
  top: 782px,
  width: 24px,
  height: 24px,
  fill: Colors.colors.red70,
  contents: calendar24
}

@variant("Text Field (button)")
withButton = base {
  left: 1139px,
  top: 770px,
  padding-right: 4px,
  layout.justify-content: .space-between,
  overrides: [insert(submitButton, after = label)]
}

@variant("Text Field, Placeholder (button)")
buttonPlaceholder = base {
  left: 1142.4px,
  top: 850px,
  padding-right: 4px,
  layout.justify-content: .space-between,
  overrides: [insert(placeholderButton, after = label)],

  label {
    fill[0].color: Colors.colors.black80
  }
}

placeholderButton = button.smallPrimaryRounded {
  name: "Submit Button",
  left: 52.3381px,
  top: 5.85px,

  button.smallPrimaryRoundedIcon {
    contents: arrowUp20
  }
}

submitButton = button.smallPrimaryRounded {
  name: "Submit Button",
  left: 52.3381px,
  top: 5.85px,

  button.smallPrimaryRoundedIcon {
    contents: arrowUp20
  }
}
