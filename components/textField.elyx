// Define text field variants and states here.

import "tokens.elyx" as tokens

pub TextField = frame {
  name: "Text Field",
  left: 869px,
  top: 770px,
  width: 100%,
  height: tokens.controlHeight,
  layout: {align-items: .center},
  fill: {linear-gradient: {angle: 0deg, stops: [stop(0%, .white), stop(100%, rgb(98%, 98%, 98%))]}},
  border: tokens.colorTextFieldBorder,
  shadow: {
    inner-shadow: {
      color: rgb(0%, 0%, 0%, 10%),
      offset: point(0px, 1px),
      blur-radius: 2px,
      spread: 0px
    }
  },
  corner-radius: tokens.borderRadiusS,
  padding-left: tokens.paddingM,
  padding-right: tokens.paddingM,
  children: Label
}

Label = text {
  name: "Label",
  left: 0px,
  top: 0px,
  fill: tokens.textColorDark,
  contents: "Label",
  font-size: tokens.labelSizeML,
  font-family: "Inter",
  font-style: "Regular"
}

@variant(Placeholder)
TextFieldVariant_L = TextField {
  left: 869px,
  top: 850px,

  Label {
    fill[0].color: rgb(9.8%, 9.8%, 9.8%, 40%)
  }
}

@variant(Focussed)
TextFieldVariant = TextField {
  left: 869px,
  top: 930px,
  border[0].color: tokens.colorPrimary,
  border[0].position: .center,
  border[0].width: 2
}

@variant(Error)
Focussed = TextField {
  left: 869px,
  top: 1010px,
  border[0].color: tokens.colorDanger,
  border[0].position: .center,
  border[0].width: 2,

  Label {
    fill[0].color: tokens.colorDanger
  }
}
