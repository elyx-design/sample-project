import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius

export base = frame {
  left: 461px,
  top: 1px,
  width: .auto,
  height: Spacing.spacing.heightM,
  layout: {justify-content: .center, align-items: .center},
  fill: rgb(81.8%, 94.6067%, 83.9155%),
  corner-radius: Radius.radius.max,
  padding: [6px, Spacing.spacing.paddingL],
  children: label
}

label = text {
  fill: rgb(1.85%, 26.7497%, 11.23%),
  contents: "Label",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Medium"
}

@variant("statusBadge Variant")
dark = base {
  left: 461px,
  top: 76px,
  fill[0].color: rgb(98.82%, 98.82%, 98.82%, 20%),

  label {
    fill[0].color: rgb(98.9987%, 98.9987%, 98.9987%)
  }
}
