import "tokens/colors.elyx" as colors
import "tokens/spacing.elyx" as spacing
import "tokens/radius.elyx" as radius

export horizontal = frame {
  left: 878px,
  top: 552px,
  width: 16px,
  layout: {justify-content: .center, align-items: .center},
  padding-top: 4px,
  padding-bottom: 4px,
  children: horizontalLine
}

horizontalLine = shape {
  left: 0px,
  top: 0px,
  width: 100%,
  height: 0.5px,
  fill: colors.colors.blackAlpha25,
  corner-radius: radius.radius.max,
  type: .rect
}

export vertical = frame {
  left: 919px,
  top: 552px,
  height: spacing.spacing.heightM,
  layout: {justify-content: .center, align-items: .center},
  padding-left: 4px,
  padding-right: 4px,
  children: verticalLine
}

verticalLine = shape {
  left: 0px,
  top: 0px,
  width: 0.5px,
  height: 100%,
  fill: colors.colors.blackAlpha25,
  corner-radius: radius.radius.max,
