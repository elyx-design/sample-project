import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "components/tag.elyx" as tagComponent
import "components/divider.elyx" as dividerComponent

export activityRow = frame {
  left: -117px,
  top: -17px,
  width: 640px,
  height: .auto,
  layout: {direction: .column, align-items: .center, item-gap: 16px},
  overflow: .visible,
  children: [content, divider]
}

content = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center, item-gap: 32px},
  overflow: .visible,
  children: [details, tag]
}

details = frame {height: 100%, layout: {align-items: .center}, children: [date, description]}

date = frame {
  width: 96px,
  height: 100%,
  layout: {align-items: .center, item-gap: 32px},
  children: dateLabel
}

dateLabel = text {
  left: 0px,
  top: 0px,
  width: 96px,
  fill: Colors.colors.blackAlpha25,
  contents: "2 Days",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Bold"
}

description = frame {
  height: 100%,
  layout: {align-items: .center, item-gap: 4px},
  children: [verb, detail]
}

verb = text {
  left: 79px,
  top: 5.5px,
  width: .auto,
  fill: Colors.colors.blackAlpha70,
  contents: "Rated:",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "ExtraBold"
}

detail = text {
  left: 99px,
  top: 25.5px,
  width: .auto,
  fill: Colors.colors.blackAlpha70,
  contents: "The Weight of Light — \"tender from start to finish\"",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "Regular"
}

tag = tagComponent.base {left: 47.5px, top: 2.25px}

divider = dividerComponent.horizontal {left: 0px, top: 19.25px, width: 100%}
