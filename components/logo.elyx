import "images/misc/logo.png" as logo2
import "tokens/colors.elyx" as Colors

export small = frame {
  left: 340px,
  top: 519px,
  width: .auto,
  height: .auto,
  layout: {align-items: .center},
  fill: {color: Colors.colors.controlBorder, visible: .false},
  corner-radius: 0px,
  children: smallArtwork
}

smallArtwork = shape {
  left: 0px,
  top: 80px,
  width: 24px,
  height: 24px,
  fill: {image: {ref: logo2}},
  type: .rect
}

@variant
large = small {
  left: 340px,
  top: 677px,
  overrides: [insert(largeArtwork, after = .nil), remove(smallArtwork)]
}

@variant
extraLarge = small {
  left: 340px,
  top: 769px,
  overrides: [insert(extraLargeArtwork, after = .nil), remove(smallArtwork)]
}

extraLargeArtwork = shape {
  left: 0px,
  top: 80px,
  width: 80px,
  height: 80px,
  fill: {image: {ref: logo2}},
  type: .rect
}

largeArtwork = shape {
  left: 0px,
  top: 56px,
  width: 48px,
  height: 48px,
  fill: {image: {ref: logo2}},
  type: .rect
}

@variant
medium = small {
  left: 340px,
  top: 597px,

  smallArtwork {
    width: 36px,
    height: 36px
  }
}

@variant
extraLargeWordmark = small {
  left: 475px,
  top: 769px,
  layout.item-gap: 24px,
  overrides: [insert(text4, after = smallArtwork)],

  smallArtwork {
    width: 80px,
    height: 80px
  }
}

@variant
largeWordmark = small {
  left: 475px,
  top: 677px,
  layout.item-gap: 12px,
  overrides: [insert(text3, after = smallArtwork)],

  smallArtwork {
    width: 48px,
    height: 48px
  }
}

@variant
mediumWordmark = small {
  left: 475px,
  top: 597px,
  layout.item-gap: 8px,
  overrides: [insert(text2, after = smallArtwork)],

  smallArtwork {
    width: 36px,
    height: 36px
  }
}

@variant
smallWordmark = small {
  left: 475px,
  top: 519px,
  layout.item-gap: 8px,
  overrides: [insert(text1, after = smallArtwork)]
}

text1 = text {
  left: 426px,
  top: 673px,
  fill: Colors.colors.black20,
  contents: "Overleaf",
  font-style: "SemiBold"
}

text2 = text {
  left: 426px,
  top: 655px,
  fill: Colors.colors.black20,
  contents: "Overleaf",
  font-size: 18,
  font-style: "SemiBold"
}

text3 = text {
  left: 402px,
  top: 655px,
  fill: Colors.colors.black20,
  contents: "Overleaf",
  font-size: 22,
  font-style: "SemiBold"
}

text4 = text {
  left: 362px,
  top: 655px,
  fill: Colors.colors.black20,
  contents: "Overleaf",
  font-size: 44,
  font-style: "SemiBold"
}
