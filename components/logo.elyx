import "images/misc/logo.png" as logo2

export small = frame {
  left: 340px,
  top: 519px,
  width: .auto,
  height: .auto,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  fill: {color: rgb(79.9972%, 79.9972%, 79.9972%), visible: .false},
  corner-radius: 0px,
  children: smallArtwork
}

smallArtwork = shape {
  left: 0px,
  top: 80px,
  width: 24px,
  height: 24px,
  fill: {image: {ref: logo2}},
  type: .rect
}

@variant
large = small {
  left: 490px,
  top: 519px,
  overrides: [insert(largeArtwork, after = .nil), remove(smallArtwork)]
}

@variant
extraLarge = small {
  left: 636px,
  top: 519px,
  overrides: [insert(extraLargeArtwork, after = .nil), remove(smallArtwork)]
}

extraLargeArtwork = shape {
  left: 0px,
  top: 80px,
  width: 80px,
  height: 80px,
  fill: {image: {ref: logo2}},
  type: .rect
}

largeArtwork = shape {
  left: 0px,
  top: 56px,
  width: 48px,
  height: 48px,
  fill: {image: {ref: logo2}},
  type: .rect
}

@variant
medium = small {
  left: 409px,
  top: 519px,
  width: 36px,
  height: 36px,

  smallArtwork {
    width: 36px,
    height: 36px
  }
}
