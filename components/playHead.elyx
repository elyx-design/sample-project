import "tokens/spacing.elyx" as Spacing
import "tokens/colors.elyx" as colors

export playHead = frame {
  left: 670px,
  top: 469px,
  width: 12px,
  height: 74px,
  layout: {direction: .column, justify-content: .center, align-items: .center},
  overflow: .visible,
  padding-top: Spacing.padding.medium,
  children: [line, handle]
}

line = shape {
  left: 6px,
  top: 0px,
  width: 2px,
  height: 100%,
  fill: [
    colors.colors.lime,
    {
      linear-gradient: {
        from: point(50%, 88.7466%),
        to: point(50%, 100%),
        stops: [stop(0%, .transparent), stop(100%, colors.colors.black20)]
      }
    }
  ],
  border: {color: colors.colors.blackAlpha70, width: 0.5px, position: .outside},
  type: .rect
}

handle = shape {
  left: 0px,
  top: 0px,
  width: 12px,
  height: 12px,
  ignore-stack: .true,
  fill: colors.colors.blackAlpha70,
  border: {color: colors.colors.lime, width: 2px},
  type: .ellipse
}
