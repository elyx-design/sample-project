import "tokens/colors.elyx" as Colors
import "tokens/typography.elyx" as Typography
import "tokens/spacing.elyx" as Spacing
import "tokens/radius.elyx" as Radius

export workspaceHeader = frame {
  left: 16px,
  top: 16px,
  width: .auto,
  height: .auto,
  layout: {align-items: .center, item-gap: 10px},
  corner-radius: Radius.radius.m,
  padding: Spacing.spacing.paddingM
}

workspaceMeta = frame {
  layout: {direction: .column, justify-content: .center, item-gap: 4px},
  children: [workspaceName, workspacePlan]
}

workspaceName = text {
  fill: Colors.colors.black20,
  contents: "Haze",
  font-size: Typography.typography.labelML,
  font-family: "Inter",
  font-style: "SemiBold"
}

workspacePlan = text {
  fill: Colors.colors.blackAlpha70,
  contents: "Team plan",
  font-size: Typography.typography.labelM,
  font-family: "Inter",
  font-style: "Regular"
}
