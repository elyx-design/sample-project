import "tokens/colors.elyx" as colors

@context(theme="dark")
__file__

// Provides dark-theme overrides for contextual color groups. Fixed primitives
// remain unchanged.
__canvas__

export darkTheme = tokens : colors.theme {
  base: rgb(8.61%, 8.61%, 8.61%),
  baseAlpha50: rgb(0%, 0%, 0%, 50%),
  baseAlpha70: rgb(0%, 0%, 0%, 70%),
  contrastStrongest: .white,
  contrastStrong: rgb(87.0588%, 87.0588%, 87.0588%),
  contrastDefault: rgb(74.32%, 74.32%, 74.32%),
  contrastMuted: rgb(28.06%, 28.06%, 28.06%),
  contrastSubtle: rgb(17.92%, 17.92%, 17.92%),
  contrastFaint: rgb(13.73%, 13.73%, 13.73%),
  contrastAlpha08: rgb(100%, 100%, 100%, 8%),
  contrastAlpha25: rgb(100%, 100%, 100%, 25%),
  contrastAlpha50: rgb(100%, 100%, 100%, 50%),
  contrastAlpha70: rgb(100%, 100%, 100%, 70%)
}

export darkPalette = tokens : colors.palette {
  yellow: rgb(100%, 83.1373%, 28.6275%),
  yellowAlpha50: rgb(100%, 83.1373%, 28.6275%, 50%),
  pink: rgb(100%, 0%, 51.37%),
  purple: rgb(52.1569%, 0%, 100%),
  cyan: rgb(0%, 72.94%, 92.94%),
  green: rgb(0%, 74.5098%, 0%),
  tealDark: rgb(7.84%, 12.94%, 13.7255%),
  limeBright: rgb(67.48%, 100%, 0%),
  lime: rgb(83.53%, 96.25%, 0%),
  magenta: rgb(100%, 41.19%, 100%),
  lavender: rgb(90.2878%, 81.12%, 100%)
}

export darkControls = tokens : colors.controls {
  foreground: rgb(8.61%, 8.61%, 8.61%),
  border: rgb(28.06%, 28.06%, 28.06%),
  surface: rgb(17.92%, 17.92%, 17.92%)
}

export darkSurfaces = tokens : colors.surfaces {
  subtle: rgb(13.73%, 13.73%, 13.73%)
}

export darkGradients = tokens : colors.gradients {
  surfaceTop: rgb(13.73%, 13.73%, 13.73%),
  surfaceBottom: rgb(8.61%, 8.61%, 8.61%),
  emphasisTop: rgb(87.0588%, 87.0588%, 87.0588%),
  emphasisBottom: rgb(74.32%, 74.32%, 74.32%),
  dangerTop: rgb(100%, 10.15%, 17.63%),
  dangerBottom: rgb(89.3891%, 19.8896%, 14.9388%),
  overlayEnd: rgb(8.61%, 8.61%, 8.61%)
}
